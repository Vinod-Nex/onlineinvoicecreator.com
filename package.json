{
  "name": "onlineinvoicecreator",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:og": "node scripts/generate-og-images.mjs",
    "build": "node scripts/generate-favicons.mjs && node scripts/generate-og-images.mjs && astro build && node scripts/audit-seo.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:cwv": "node scripts/audit-cwv.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker:dev": "wrangler dev --config workers/api/wrangler.toml",
    "worker:deploy": "wrangler deploy --config workers/api/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "satori": "^0.62.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
