---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

import { buildPageSchemaGraph, type BreadcrumbItem } from '../lib/schema';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>> | string;
  breadcrumbs?: BreadcrumbItem[];
  showHeader?: boolean;
  showFooter?: boolean;
  cfAnalyticsToken?: string;
}

const {
  title = 'Free Online Invoice Generator - 100% Free & Watermark-Free',
  description = 'Create and download professional invoices and receipts online in seconds. 100% free, private, watermark-free, and no signup required.',
  canonical,
  ogImage = '/og-image.png',
  ogImageAlt,
  noindex = false,
  schema,
  breadcrumbs,
  showHeader = true,
  showFooter = true,
  cfAnalyticsToken,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://onlineinvoicecreator.com';

// Normalize canonical URL: absolute, self-referencing, root slash for home, no trailing slash for subpages
const normalizedPath = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, '') : '/';
let canonicalUrl = canonical || new URL(normalizedPath, siteUrl).href;
if (normalizedPath === '/' && !canonicalUrl.endsWith('/')) {
  canonicalUrl += '/';
} else if (normalizedPath !== '/' && canonicalUrl.endsWith('/')) {
  canonicalUrl = canonicalUrl.replace(/\/$/, '');
}

// Construct multilingual hreflang alternates (en, es, pt, x-default) matching XML sitemap
const cleanRoutePath = normalizedPath === '/' ? '' : normalizedPath;
const hreflangEn = canonicalUrl;
const hreflangEs = `${siteUrl}/es${cleanRoutePath}`;
const hreflangPt = `${siteUrl}/pt${cleanRoutePath}`;
const hreflangXDefault = canonicalUrl;

// Resolve absolute Open Graph image URL
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).href;

// Build fallback schema graph if not explicitly provided
const defaultSchema = buildPageSchemaGraph({
  canonicalUrl,
  siteUrl,
  title,
  description,
  isHomePage: normalizedPath === '/',
  isToolPage: false,
  breadcrumbs,
});

let serializedSchema = '';
if (schema) {
  if (typeof schema === 'string') {
    serializedSchema = schema;
  } else if (typeof schema === 'object' && schema !== null) {
    if ('@context' in schema) {
      serializedSchema = JSON.stringify(schema);
    } else if (Array.isArray(schema)) {
      serializedSchema = JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': schema,
      });
    } else {
      serializedSchema = JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [schema],
      });
    }
  }
} else {
  serializedSchema = JSON.stringify(defaultSchema);
}
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Character Encoding & Viewport -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Document Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical URL & Multilingual Hreflang Alternates -->
    <link rel="canonical" href={canonicalUrl} />
    {!noindex && (
      <>
        <link rel="alternate" hreflang="en" href={hreflangEn} />
        <link rel="alternate" hreflang="es" href={hreflangEs} />
        <link rel="alternate" hreflang="pt" href={hreflangPt} />
        <link rel="alternate" hreflang="x-default" href={hreflangXDefault} />
      </>
    )}

    <!-- Search Engine Indexing & Crawling -->
    {noindex ? (
      <>
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex, nofollow" />
      </>
    ) : (
      <>
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
        <meta
          name="googlebot"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      </>
    )}

    <!-- Open Graph Protocol -->
    <meta property="og:site_name" content="Online Invoice Creator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt || title} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt || title} />

    <!-- Browser Theme Color -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />

    <!-- Favicon Set & Web App Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Preload Self-Hosted Inter Variable Font for above-the-fold render -->
    <link
      rel="preload"
      href="/fonts/inter-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={serializedSchema} />
    <slot name="schema" />

    <!-- First-Party Anti-FOUC Theme Script (Strictly NO third-party scripts) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const mediaDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored === 'dark' || (!stored && mediaDark) ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch {
          // ignore localStorage access errors in private/restricted environments
        }
      })();
    </script>
  </head>

  <body class="bg-canvas text-body font-sans antialiased min-h-screen flex flex-col selection:bg-primary/20 selection:text-primary">
    <!-- Accessible Skip to Main Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2.5 focus:bg-primary focus:text-white focus:rounded-full focus:shadow-elevated focus:font-semibold focus:outline-none focus:ring-4 focus:ring-primary/40 focus:text-xs transition-transform"
    >
      Skip to main content
    </a>

    <!-- Header Landmark (Sticky Brand & Tools Navigation) -->
    {showHeader &&
      (Astro.slots.has('header') ? (
        <header role="banner">
          <slot name="header" />
        </header>
      ) : (
        <Header currentPath={normalizedPath} />
      ))}

    <!-- Main Landmark -->
    <main id="main-content" role="main" tabindex="-1" class="focus:outline-none flex-1">
      <slot />
    </main>

    <!-- Footer Landmark (4-Column Links & Compliance Notice) -->
    {showFooter &&
      (Astro.slots.has('footer') ? (
        <footer role="contentinfo">
          <slot name="footer" />
        </footer>
      ) : (
        <Footer />
      ))}

    <!-- First-party listener for system theme preference changes -->
    <script is:inline>
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
        if (!localStorage.getItem('theme')) {
          const newTheme = e.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', newTheme);
          if (newTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          window.dispatchEvent(
            new CustomEvent('theme-changed', {
              detail: { theme: newTheme, source: 'system' },
            })
          );
        }
      });
    </script>
    <!-- Privacy & Cookie Consent Banner (Targeted strictly to EU/EEA/UK visitors) -->
    <ConsentBanner />

    <!-- Cloudflare Web Analytics (Privacy-Friendly, Cookie-Free) -->
    <CloudflareAnalytics token={cfAnalyticsToken} />
  </body>
</html>
