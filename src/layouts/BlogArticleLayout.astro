---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import AffiliatePartners from '../components/AffiliatePartners.astro';
import EditorialNote from '../components/EditorialNote.astro';
import { buildPageSchemaGraph, type BreadcrumbItem, type FAQItem } from '../lib/schema';
import { BLOG_ARTICLES, type BlogArticleData } from '../data/blog-articles';

export interface Props {
  article: BlogArticleData;
  faqs?: FAQItem[];
  toc?: Array<{ id: string; label: string }>;
}

const { article, faqs = [], toc = [] } = Astro.props;

const canonicalUrl = `https://onlineinvoicecreator.com/blog/${article.slug}`;

const breadcrumbItems: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Blog & Guides', href: '/blog' },
  { label: article.title },
];

const articleSchema = {
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: article.title,
  name: article.title,
  description: article.description,
  url: canonicalUrl,
  datePublished: article.isoDate,
  dateModified: article.isoDate,
  inLanguage: 'en-US',
  author: {
    '@type': 'Organization',
    name: 'Online Invoice Creator Editorial Team',
    url: 'https://onlineinvoicecreator.com/about',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Online Invoice Creator',
    url: 'https://onlineinvoicecreator.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://onlineinvoicecreator.com/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  articleSection: article.category,
};

const pageSchema = buildPageSchemaGraph({
  canonicalUrl,
  title: article.seoTitle,
  description: article.description,
  breadcrumbs: breadcrumbItems,
  faqItems: faqs,
  customSchemas: [articleSchema],
});

// Related articles excluding current
const relatedArticles = BLOG_ARTICLES.filter((a) => a.slug !== article.slug).slice(0, 3);
---

<BaseLayout
  title={article.seoTitle}
  description={article.description}
  canonical={canonicalUrl}
  ogImage={`/og/og-${article.slug}.png`}
  ogImageAlt={`${article.title} - Online Invoice Creator Guide`}
  schema={pageSchema}
>
  <!-- Breadcrumbs -->
  <div class="border-b border-hairline/60 bg-surface-soft/40 no-print">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12">
    <!-- Article Header -->
    <header class="space-y-6 text-center sm:text-left border-b border-hairline pb-10">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5 text-xs">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary font-semibold">
          <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
          <span>{article.category}</span>
        </span>
        <span class="text-mute">&bull;</span>
        <span class="text-mute font-medium">{article.readTime}</span>
        <span class="text-mute">&bull;</span>
        <span class="text-mute font-medium">Updated {article.publishDate}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-display leading-[1.15]">
        {article.title}
      </h1>

      <p class="text-lg sm:text-xl text-mute max-w-3xl leading-relaxed">{article.description}</p>

      <!-- Editorial Byline & Fast Tool Link -->
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute border-t border-hairline/50 pt-4">
        <div class="flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-surface-soft border border-hairline font-bold text-ink">
            OIC
          </span>
          <span>
            Written by the <strong>Online Invoice Creator Editorial Team</strong>
          </span>
        </div>
        <a
          href={article.tool.href}
          class="inline-flex items-center gap-1.5 text-primary hover:text-primary-deep font-semibold"
        >
          <span>Free Tool: {article.tool.name}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </header>

    <!-- Table of Contents (if provided) -->
    {toc.length > 0 && (
      <nav
        class="p-6 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-3"
        aria-label="Table of Contents"
      >
        <h2 class="text-sm font-bold uppercase tracking-wider text-charcoal">In This Guide</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
          {toc.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                class="text-mute hover:text-primary transition-colors flex items-center gap-1.5"
              >
                <span class="text-primary text-xs">&rsaquo;</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Main Content Slot -->
    <div class="article-body prose max-w-none text-ink leading-relaxed space-y-8">
      <slot />
    </div>

    <!-- Contextual Interactive Tool CTA Card -->
    <aside class="p-8 rounded-3xl bg-surface-card border-2 border-primary/20 shadow-xs space-y-4 text-center sm:text-left sm:flex sm:items-center sm:justify-between sm:space-y-0 gap-6">
      <div class="space-y-2 max-w-xl">
        <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary">
          <span>Instant Free Generator</span>
        </div>
        <h2 class="text-2xl font-bold text-ink font-display tracking-tight">
          Ready to create your bill?
        </h2>
        <p class="text-sm text-mute">
          Generate clean, professional, watermark-free invoices and receipts directly in your
          browser. 100% private, no signup, zero cloud storage.
        </p>
      </div>
      <div class="shrink-0">
        <a
          href={article.tool.href}
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-primary hover:bg-primary-deep text-white font-semibold text-sm transition-all shadow-xs"
        >
          <span>{article.tool.ctaLabel}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </aside>

    <!-- Editorial Review & Official Statutory Sources (E-E-A-T) -->
    <EditorialNote
      lastReviewedDate="October 2026"
      topic={article.title}
      officialSources={article.officialSources}
    />

    <!-- FAQs Section (if present) -->
    {faqs.length > 0 && (
      <section
        class="space-y-6 pt-6 border-t border-hairline"
        aria-labelledby="faq-section-heading"
      >
        <div class="space-y-1">
          <h2
            id="faq-section-heading"
            class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
          >
            Frequently Asked Questions
          </h2>
          <p class="text-sm text-mute">
            Direct answers to common billing, invoicing, and tax accounting inquiries.
          </p>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2">
              <h3 class="text-base font-semibold text-ink font-display">{faq.question}</h3>
              <p class="text-sm text-mute leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Ad Slot (zero-CLS reserved container) -->
    <div class="py-4">
      <AdSlot slotId={`blog-${article.slug}-bottom`} format="responsive" />
    </div>

    <!-- Contextual Accounting Software Recommendations (Clearly Labelled) -->
    <AffiliatePartners context="general" />

    <!-- Related Articles -->
    <section class="space-y-6 pt-6 border-t border-hairline" aria-labelledby="related-heading">
      <h2
        id="related-heading"
        class="text-xl sm:text-2xl font-bold text-ink font-display tracking-tight"
      >
        Related Invoicing & Billing Guides
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {relatedArticles.map((rel) => (
          <a
            href={rel.isFull ? `/blog/${rel.slug}` : `/blog#${rel.slug}`}
            class="group p-5 rounded-2xl bg-surface-card border border-hairline shadow-xs hover:border-primary/50 transition-all flex flex-col justify-between space-y-3"
          >
            <div class="space-y-2">
              <span class="text-xs font-semibold text-primary">{rel.category}</span>
              <h3 class="text-sm font-bold text-ink group-hover:text-primary transition-colors line-clamp-2">
                {rel.title}
              </h3>
              <p class="text-xs text-mute line-clamp-2">{rel.description}</p>
            </div>
            <span class="text-xs font-semibold text-primary inline-flex items-center gap-1">
              <span>Read Guide</span>
              <span aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
