---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import InvoiceForm from '../components/InvoiceForm.astro';
import ReceiptForm from '../components/ReceiptForm.astro';
import RentReceiptForm from '../components/RentReceiptForm.astro';
import AdSlot from '../components/AdSlot.astro';
import EditorialNote from '../components/EditorialNote.astro';
import type { ToolPageData } from '../types/page';
import { buildPageSchemaGraph } from '../lib/schema';

interface Props {
  data: ToolPageData;
}

const { data } = Astro.props;

const isHomePage = data.slug === 'index';

// Construct complete Schema.org JSON-LD graph matching visible content:
// - Organization & WebSite (on home page)
// - WebApplication (free offer, applicationCategory BusinessApplication, operatingSystem Any)
// - FAQPage (from visible FAQ items)
// - BreadcrumbList (from visible breadcrumbs)
const pageSchema = buildPageSchemaGraph({
  canonicalUrl: data.canonical || 'https://onlineinvoicecreator.com',
  title: data.h1,
  description: data.metaDescription,
  isHomePage,
  isToolPage: true,
  breadcrumbs: data.breadcrumbs,
  faqItems: data.faq?.items || [],
  webAppOptions: {
    name: data.h1,
    description: data.metaDescription,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    features: data.trustBadges,
  },
});

const trustBadges = data.trustBadges || [
  'Zero Watermarks',
  '30 Global Currencies',
  'Local Draft Auto-Save',
  'Instant Print / PDF',
];

const ogFilename = isHomePage ? 'og-invoice-generator.png' : `og-${data.slug}.png`;
const ogImageUrl = `/og/${ogFilename}`;
const ogImageAltText = `${data.h1} - Online Invoice Creator free client-side tool`;
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  canonical={data.canonical}
  ogImage={ogImageUrl}
  ogImageAlt={ogImageAltText}
  schema={pageSchema}
>
  <!-- Accessible Breadcrumb Navigation Bar -->
  <div class="border-b border-hairline/60 bg-surface-soft/40 no-print">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={data.breadcrumbs} />
    </div>
  </div>

  <!-- Hero Header Section -->
  <section class="relative pt-8 sm:pt-12 pb-4 sm:pb-8 border-b border-hairline/60">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-soft border border-hairline text-xs font-semibold text-charcoal shadow-2xs">
        <span class="flex h-2 w-2 rounded-full bg-accent-teal animate-pulse"></span>
        <span>{data.badge}</span>
      </div>

      <!-- Primary H1 Target -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink font-display leading-[1.08]">
        {data.h1Highlight && data.h1.includes(data.h1Highlight) ? (
          <Fragment>
            {data.h1.split(data.h1Highlight)[0]}
            <span class="text-primary">{data.h1Highlight}</span>
            {data.h1.split(data.h1Highlight)[1]}
          </Fragment>
        ) : (
          data.h1
        )}
      </h1>

      <!-- Featured Snippet Intro Paragraph (40-60 words answering main intent) -->
      <p class="max-w-3xl mx-auto text-base sm:text-lg text-mute font-normal leading-relaxed">
        {data.intro}
      </p>

      <!-- Short Numbered "How To" Quick Guide Near the Top -->
      {data.howTo && data.howTo.steps && data.howTo.steps.length > 0 && (
        <div class="pt-2 pb-1 max-w-4xl mx-auto text-left">
          <h2 class="text-xs font-bold uppercase tracking-wider text-charcoal mb-2.5 text-center sm:text-left flex items-center justify-center sm:justify-start gap-1.5">
            <svg
              class="h-3.5 w-3.5 text-primary"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"
              />
            </svg>
            <span>3-Step Quick Start</span>
          </h2>
          <ol
            class="grid grid-cols-1 sm:grid-cols-3 gap-3"
            aria-label="Quick steps to create your document"
          >
            {data.howTo.steps.slice(0, 3).map((step, idx) => (
              <li class="p-3.5 rounded-2xl bg-surface-card border border-hairline shadow-2xs space-y-1">
                <div class="flex items-center gap-2">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary text-xs font-bold">
                    {idx + 1}
                  </span>
                  <span class="text-xs font-bold text-ink truncate">{step.title}</span>
                </div>
                <p class="text-[11px] text-mute leading-relaxed pl-7">{step.description}</p>
              </li>
            ))}
          </ol>
        </div>
      )}

      <!-- Trust Badges Row -->
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8 pt-2 text-xs font-medium text-mute">
        {trustBadges.map((badgeText) => (
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-accent-teal shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"
              />
            </svg>
            <span>{badgeText}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Tool Canvas (Above the Fold) -->
  <main class="w-full bg-canvas">
    {data.toolType === 'receipt' ? (
      <ReceiptForm />
    ) : data.toolType === 'rent-receipt' ? (
      <RentReceiptForm />
    ) : (
      <InvoiceForm />
    )}
  </main>

  <!-- Post-Tool Content Container -->
  <div class="bg-surface-soft/60 border-t border-hairline">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
      <!-- 1. How-To Section -->
      <section class="space-y-6" aria-labelledby="how-to-heading">
        <div class="text-center sm:text-left">
          {data.howTo.badge && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary mb-2">
              {data.howTo.badge}
            </span>
          )}
          <h2
            id="how-to-heading"
            class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
          >
            {data.howTo.title}
          </h2>
          {data.howTo.subtitle && (
            <p class="text-sm sm:text-base text-mute mt-1.5 max-w-3xl leading-relaxed">
              {data.howTo.subtitle}
            </p>
          )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {data.howTo.steps.map((step) => (
            <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-3 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="h-10 w-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-bold text-sm shadow-2xs">
                  {step.step}
                </div>
                <h3 class="font-bold text-ink text-base sm:text-lg">{step.title}</h3>
                <p class="text-xs sm:text-sm text-mute leading-relaxed">{step.description}</p>
              </div>
              {step.tip && (
                <div class="pt-3 border-t border-hairline/60">
                  <p class="text-[11px] text-charcoal font-medium">
                    <span class="text-primary font-bold">Tip:</span>{' '}
                    <Fragment set:html={step.tip} />
                  </p>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Reserved Space Ad Unit (Zero CLS, Loads after Tool Interactivity) -->
      <AdSlot slotId={`ad-${data.slug}-content`} format="responsive" />

      <!-- Contextual Workflow & Cross-Tool Links Section -->
      {data.contextualLinks &&
        data.contextualLinks.items &&
        data.contextualLinks.items.length > 0 && (
          <section class="space-y-6" aria-labelledby="workflow-heading">
            <div class="text-center sm:text-left">
              {data.contextualLinks.badge && (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-teal/10 text-accent-teal mb-2">
                  {data.contextualLinks.badge}
                </span>
              )}
              <h2
                id="workflow-heading"
                class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
              >
                {data.contextualLinks.title}
              </h2>
              {data.contextualLinks.subtitle && (
                <p class="text-sm sm:text-base text-mute mt-1.5 max-w-3xl leading-relaxed">
                  {data.contextualLinks.subtitle}
                </p>
              )}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
              {data.contextualLinks.items.map((item) => (
                <div class="p-5 sm:p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-2.5 flex flex-col justify-between hover:border-primary/40 transition-all">
                  <div class="space-y-2">
                    <div class="flex items-center justify-between gap-2">
                      <span class="text-xs font-semibold text-primary">{item.prompt}</span>
                      {item.badge && (
                        <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-md bg-surface-soft text-charcoal border border-hairline">
                          {item.badge}
                        </span>
                      )}
                    </div>
                    <p class="text-xs text-mute leading-relaxed">{item.description}</p>
                  </div>
                  <div class="pt-3 border-t border-hairline/60">
                    <a
                      href={item.href}
                      class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-primary hover:text-primary-bright transition-colors"
                    >
                      <span>{item.text}</span>
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

      <!-- 2. What This Document Must Contain Section -->
      <section class="space-y-6" aria-labelledby="must-contain-heading">
        <div class="text-center sm:text-left">
          {data.whatItMustContain.badge && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-teal/10 text-accent-teal mb-2">
              {data.whatItMustContain.badge}
            </span>
          )}
          <h2
            id="must-contain-heading"
            class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
          >
            {data.whatItMustContain.title}
          </h2>
          {data.whatItMustContain.subtitle && (
            <p class="text-sm sm:text-base text-mute mt-1.5 max-w-3xl leading-relaxed">
              {data.whatItMustContain.subtitle}
            </p>
          )}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {data.whatItMustContain.items.map((item) => (
            <div class="p-5 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2">
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-bold text-ink text-sm sm:text-base">{item.title}</h3>
                {item.badge && (
                  <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-md bg-surface-soft text-charcoal border border-hairline">
                    {item.badge}
                  </span>
                )}
              </div>
              <p class="text-xs text-mute leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>

        {data.whatItMustContain.disclaimer && (
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline/80 flex items-center gap-2.5 text-xs text-mute">
            <svg class="h-4 w-4 text-mute shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"
              />
            </svg>
            <p>{data.whatItMustContain.disclaimer}</p>
          </div>
        )}
      </section>

      <!-- Comparison Table Section (Where a table fits) -->
      {data.comparisonTable && (
        <section class="space-y-6" aria-labelledby="comparison-heading">
          <div class="text-center sm:text-left">
            {data.comparisonTable.badge && (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-teal/10 text-accent-teal mb-2">
                {data.comparisonTable.badge}
              </span>
            )}
            <h2
              id="comparison-heading"
              class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
            >
              {data.comparisonTable.title}
            </h2>
            {data.comparisonTable.subtitle && (
              <p class="text-sm sm:text-base text-mute mt-1.5 max-w-3xl leading-relaxed">
                {data.comparisonTable.subtitle}
              </p>
            )}
          </div>

          <div class="overflow-x-auto rounded-3xl border border-hairline bg-surface-card shadow-card">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead>
                <tr class="border-b border-hairline bg-surface-soft/60 text-ink font-semibold">
                  <th scope="col" class="py-3.5 px-4 sm:px-6 w-1/3">
                    {data.comparisonTable.headers[0]}
                  </th>
                  <th scope="col" class="py-3.5 px-4 sm:px-6 w-1/3 text-primary font-bold">
                    {data.comparisonTable.headers[1]}
                  </th>
                  <th scope="col" class="py-3.5 px-4 sm:px-6 w-1/3 text-charcoal">
                    {data.comparisonTable.headers[2]}
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline/60">
                {data.comparisonTable.rows.map((row) => (
                  <tr class="hover:bg-surface-soft/30 transition-colors">
                    <td class="py-3.5 px-4 sm:px-6 font-semibold text-ink align-top">
                      {row.feature}
                    </td>
                    <td class="py-3.5 px-4 sm:px-6 text-charcoal align-top bg-primary/[0.02]">
                      <span class="inline-flex items-center gap-1.5 font-medium text-ink">
                        <svg
                          class="h-4 w-4 text-accent-teal shrink-0"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        <span>{row.ourValue}</span>
                      </span>
                    </td>
                    <td class="py-3.5 px-4 sm:px-6 text-mute align-top">{row.otherValue}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {data.comparisonTable.note && (
            <p class="text-xs text-mute italic">Note: {data.comparisonTable.note}</p>
          )}
        </section>
      )}

      <!-- 3. Example Section -->
      <section class="space-y-6" aria-labelledby="example-heading">
        <div class="text-center sm:text-left">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary mb-2">
            Practical Walkthrough
          </span>
          <h2
            id="example-heading"
            class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
          >
            {data.example.title}
          </h2>
          <p class="text-sm text-mute mt-1.5">
            Scenario: <span class="font-medium text-ink">{data.example.scenario}</span>
          </p>
        </div>

        <!-- Rendered Example Card (Styled like a modern document preview) -->
        <div class="p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-card space-y-6">
          <!-- Letterhead / Parties Header -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pb-6 border-b border-hairline">
            <div class="space-y-1">
              <span class="text-[11px] font-bold uppercase tracking-wider text-mute">
                From / Issuer
              </span>
              <p class="font-bold text-ink text-base">{data.example.sender.name}</p>
              <p class="text-xs text-mute leading-relaxed whitespace-pre-line">
                {data.example.sender.details}
              </p>
            </div>
            <div class="space-y-1 sm:text-right">
              <span class="text-[11px] font-bold uppercase tracking-wider text-mute">
                To / Billed Client
              </span>
              <p class="font-bold text-ink text-base">{data.example.recipient.name}</p>
              <p class="text-xs text-mute leading-relaxed whitespace-pre-line">
                {data.example.recipient.details}
              </p>
            </div>
          </div>

          <!-- Line Items Table -->
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="border-b border-hairline text-mute uppercase font-semibold tracking-wider">
                  <th scope="col" class="pb-3 text-left">
                    Item Description
                  </th>
                  <th scope="col" class="pb-3 text-center w-20">
                    Qty
                  </th>
                  <th scope="col" class="pb-3 text-right w-28">
                    Rate
                  </th>
                  <th scope="col" class="pb-3 text-right w-28">
                    Amount
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline/60">
                {data.example.items.map((item) => (
                  <tr>
                    <td class="py-3 font-medium text-ink">{item.description}</td>
                    <td class="py-3 text-center text-charcoal tabular-nums">
                      {item.quantity ?? 1}
                    </td>
                    <td class="py-3 text-right text-charcoal tabular-nums">
                      {item.rate ?? item.amount}
                    </td>
                    <td class="py-3 text-right font-bold text-ink tabular-nums">{item.amount}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Totals Summary & Notes -->
          <div class="pt-4 border-t border-hairline flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6">
            <div class="space-y-1.5 max-w-sm">
              {data.example.notes && (
                <div>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-mute">
                    Notes & Terms:
                  </span>
                  <p class="text-xs text-mute italic leading-relaxed mt-0.5">
                    {data.example.notes}
                  </p>
                </div>
              )}
              {data.example.disclaimer && (
                <p class="text-[11px] text-mute/80">{data.example.disclaimer}</p>
              )}
            </div>

            <div class="w-full sm:w-64 space-y-1.5 text-xs text-charcoal">
              {data.example.subtotal && (
                <div class="flex justify-between">
                  <span class="text-mute">Subtotal:</span>
                  <span class="font-medium text-ink tabular-nums">{data.example.subtotal}</span>
                </div>
              )}
              {data.example.tax && (
                <div class="flex justify-between">
                  <span class="text-mute">Tax / GST:</span>
                  <span class="font-medium text-ink tabular-nums">{data.example.tax}</span>
                </div>
              )}
              {data.example.discount && (
                <div class="flex justify-between text-accent-teal">
                  <span>Discount:</span>
                  <span class="tabular-nums">-{data.example.discount}</span>
                </div>
              )}
              <div class="flex justify-between text-sm sm:text-base font-bold text-ink pt-2 border-t border-hairline">
                <span>Total Amount:</span>
                <span class="text-primary tabular-nums">{data.example.total}</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Editorial Review & Official Statutory Sources (E-E-A-T) -->
      {data.editorialNote && (
        <EditorialNote
          lastReviewedDate={data.editorialNote.lastReviewedDate}
          reviewedBy={data.editorialNote.reviewedBy}
          topic={data.editorialNote.topic}
          officialSources={data.editorialNote.officialSources}
        />
      )}

      <!-- 4. Frequently Asked Questions (FAQ) Section -->
      {data.faq && data.faq.items && data.faq.items.length > 0 && (
        <section class="space-y-6 pt-4 border-t border-hairline" aria-labelledby="faq-heading">
          <div class="text-center sm:text-left">
            {data.faq.badge && (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary mb-2">
                {data.faq.badge}
              </span>
            )}
            <h2
              id="faq-heading"
              class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
            >
              {data.faq.title}
            </h2>
            {data.faq.subtitle && <p class="text-sm text-mute mt-1.5">{data.faq.subtitle}</p>}
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
            {data.faq.items.map((faq) => (
              <article class="p-5 sm:p-6 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2.5 transition-all hover:border-hairline/80">
                <h3 class="font-bold text-ink text-base sm:text-lg leading-snug">{faq.question}</h3>
                <p class="text-xs sm:text-sm text-mute leading-relaxed">{faq.answer}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- 5. Related Tools Section -->
      {data.relatedTools && data.relatedTools.items && data.relatedTools.items.length > 0 && (
        <section
          class="space-y-6 pt-4 border-t border-hairline"
          aria-labelledby="related-tools-heading"
        >
          <div class="text-center sm:text-left">
            <h2
              id="related-tools-heading"
              class="text-xl sm:text-2xl font-bold text-ink font-display"
            >
              {data.relatedTools.title}
            </h2>
            {data.relatedTools.subtitle && (
              <p class="text-sm text-mute mt-1">{data.relatedTools.subtitle}</p>
            )}
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {data.relatedTools.items.map((tool) => (
              <a
                href={tool.href}
                class="group p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs hover:shadow-card block"
              >
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-semibold px-2 py-0.5 rounded bg-surface-soft text-charcoal">
                    {tool.badge}
                  </span>
                  <span class="text-xs text-primary font-medium group-hover:translate-x-0.5 transition-transform">
                    &rarr;
                  </span>
                </div>
                <h3 class="font-bold text-ink text-base group-hover:text-primary transition-colors">
                  {tool.title}
                </h3>
                <p class="text-xs text-mute mt-1">{tool.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</BaseLayout>
