---
import BaseLayout, { type Props as BaseLayoutProps } from './BaseLayout.astro';

export type Props = BaseLayoutProps;

const props = Astro.props;
---

<BaseLayout {...props}>
  {Astro.slots.has('header') && <slot name="header" slot="header" />}
  <slot />
  {Astro.slots.has('footer') && <slot name="footer" slot="footer" />}
  {Astro.slots.has('schema') && <slot name="schema" slot="schema" />}
</BaseLayout>
