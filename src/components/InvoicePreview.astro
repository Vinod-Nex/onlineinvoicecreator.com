      </div>

      <!-- Instant Scan-to-Pay QR Code Box -->
      <div
        id="preview-qr-container"
        class="hidden flex flex-col sm:flex-row items-center sm:items-start gap-4 p-3.5 rounded-2xl bg-white border border-gray-200 shadow-2xs"
      >
        <div
          id="preview-qr-svg"
          class="w-24 h-24 shrink-0 bg-white p-1 rounded-xl border border-gray-200 shadow-2xs flex items-center justify-center overflow-hidden"
          aria-label="Scan-to-Pay QR Code"
        >
          <!-- SVG rendered dynamically -->
        </div>
        <div class="space-y-1 text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2">
            <span class="text-xs font-bold text-gray-900 tracking-tight">{locale === 'pt-br' ? 'Pague com QR Code' : locale === 'es' ? 'Paga con Código QR' : 'Instant Scan to Pay'}</span>
            <span
              id="preview-qr-badge"
              class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-primary/10 text-primary border border-primary/20"
            >
              UPI / Link
            </span>
          </div>
          <p id="preview-qr-hint" class="text-xs text-gray-600 leading-relaxed max-w-sm">
            {locale === 'pt-br' ? 'Escaneie este código no aplicativo do seu banco para pagar com agilidade.' : locale === 'es' ? 'Escanea este código en tu app bancaria o cámara para pagar con rapidez.' : 'Scan this code with your banking or camera app on your mobile phone to pay instantly.'}
          </p>
        </div>
      </div>
    </footer>
  </article>
</div>
