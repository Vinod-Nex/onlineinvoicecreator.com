---
const toolLinks = [
  { name: 'Free Invoice Generator', href: '/' },
  { name: 'Free Receipt Generator', href: '/free-online-receipt-generator' },
  { name: 'Rent Receipt Generator', href: '/free-rent-receipt-generator' },
  { name: 'Itemized Receipt Maker', href: '/receipt-maker-with-items' },
  { name: 'Excel Invoice Generator', href: '/invoice-generator-excel' },
];

const templateLinks = [
  { name: 'Freelancer Invoices', href: '/invoice-generator-for-freelancers' },
  { name: 'Contractor Invoices', href: '/contractor-invoice-template' },
  { name: 'Australia Tax Invoices (ATO)', href: '/tax-invoice-template-australia' },
  { name: 'Photography Invoices', href: '/photography-invoice-generator' },
  { name: 'Design System & Style Guide', href: '/style-guide' },
];

const resourceLinks = [
  { name: 'Invoicing Blog & Guides', href: '/blog' },
  { name: 'How to Invoice Clients', href: '/blog' },
  { name: 'Small Business Bookkeeping', href: '/blog' },
  { name: 'GST & VAT Compliance Guide', href: '/tax-invoice-template-australia' },
];

const companyLinks = [
  { name: 'About Online Invoice Creator', href: '/about' },
  { name: 'Product Changelog', href: '/changelog' },
  { name: 'Contact & Support', href: '/contact' },
  { name: 'Privacy Policy (Local-First)', href: '/privacy' },
  { name: 'Terms of Service', href: '/terms' },
];
---

<footer
  class="border-t border-hairline bg-surface-soft dark:bg-canvas text-body transition-colors"
  role="contentinfo"
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 space-y-12">
    <!-- Top Section: Brand Statement & Privacy Badge -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-12 border-b border-hairline">
      <div class="space-y-2 max-w-xl">
        <a
          href="/"
          class="group inline-flex items-center gap-2.5 text-ink transition-colors hover:text-primary"
        >
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-white shadow-xs">
            <svg
              class="h-4 w-4"
              viewBox="0 0 32 32"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <rect width="32" height="32" rx="8" fill="#494FDF" />
              <path
                d="M9 7C9 5.89543 9.89543 5 11 5H17.5858C18.1163 5 18.625 5.21071 19 5.58579L22.4142 9C22.7893 9.375 23 9.88371 23 10.4142V25C23 26.1046 22.1046 27 21 27H11C9.89543 27 9 26.1046 9 25V7Z"
                fill="white"
              />
              <path
                d="M17 5V9C17 9.55228 17.4477 10 18 10H22"
                stroke="#494FDF"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <span class="text-lg font-bold tracking-tight text-ink">OnlineInvoiceCreator</span>
        </a>
        <p class="text-xs text-mute leading-relaxed">
          The fast, private online invoice and receipt maker for freelancers, contractors, and small
          businesses worldwide. 100% free with instant PDF download and zero account required.
        </p>
      </div>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center gap-3 text-xs">
        <div class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-surface-card px-3 py-1.5 text-ink shadow-2xs font-medium">
          <svg
            class="h-3.5 w-3.5 text-accent-teal"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            />
          </svg>
          <span>100% Client-Side Private</span>
        </div>
        <div class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-surface-card px-3 py-1.5 text-ink shadow-2xs font-medium">
          <svg
            class="h-3.5 w-3.5 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>No Watermark · No Sign-Up</span>
        </div>
      </div>
    </div>

    <!-- 4-Column Navigation Links Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-xs">
      <!-- Col 1: Core Tools -->
      <div class="space-y-3">
        <p class="font-bold text-ink uppercase tracking-wider text-[11px]">Invoicing Tools</p>
        <ul class="space-y-2 text-mute">
          {toolLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Templates -->
      <div class="space-y-3">
        <p class="font-bold text-ink uppercase tracking-wider text-[11px]">Specialized Templates</p>
        <ul class="space-y-2 text-mute">
          {templateLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Resources -->
      <div class="space-y-3">
        <p class="font-bold text-ink uppercase tracking-wider text-[11px]">Guides & Resources</p>
        <ul class="space-y-2 text-mute">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Legal & Company -->
      <div class="space-y-3">
        <p class="font-bold text-ink uppercase tracking-wider text-[11px]">Company & Legal</p>
        <ul class="space-y-2 text-mute">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Compliance Notice: Mandatory Genuine Transactions Requirement -->
    <div class="rounded-xl border border-hairline bg-surface-card p-4 text-xs text-mute leading-relaxed">
      <div class="flex items-start gap-2.5">
        <svg
          class="h-4 w-4 shrink-0 text-accent-warning mt-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <p>
          <strong class="font-semibold text-ink">Important Notice:</strong> Tools and templates on
          OnlineInvoiceCreator.com are intended solely for genuine, lawful business transactions.
          Users are strictly responsible for the accuracy of their financial records and for
          complying with applicable local tax, statutory invoicing, and accounting regulations in
          their respective jurisdictions.
        </p>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Legal Slugs -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-hairline text-[11px] text-mute">
      <div>© 2026 Online Invoice Creator. All rights reserved. 100% Client-Side Architecture.</div>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="hover:text-ink transition-colors">
          Privacy
        </a>
        <span class="text-hairline">·</span>
        <a href="/terms" class="hover:text-ink transition-colors">
          Terms
        </a>
        <span class="text-hairline">·</span>
        <a href="/contact" class="hover:text-ink transition-colors">
          Support
        </a>
        <span class="text-hairline">·</span>
        <a href="/changelog" class="hover:text-ink transition-colors">
          Changelog
        </a>
        <span class="text-hairline">·</span>
        <a href="/style-guide" class="hover:text-ink transition-colors">
          Style Guide
        </a>
      </div>
    </div>
  </div>
</footer>
