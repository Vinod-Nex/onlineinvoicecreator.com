---
import { getDictionary } from '../i18n';
import { getRouteUrl } from '../i18n/routes';
import { type Locale, DEFAULT_LOCALE } from '../i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const d = getDictionary(locale);

const toolLinks = locale === 'pt-br'
  ? [
      { name: 'Gerador de Recibo de Pagamento', href: getRouteUrl('receipt', 'pt-br') },
      { name: 'Recibo de Aluguel Grátis', href: getRouteUrl('rent-receipt', 'pt-br') },
      { name: 'Modelo de Recibo', href: getRouteUrl('receipt-template', 'pt-br') },
      { name: 'Gerador de Fatura Comercial', href: `${getRouteUrl('home', 'pt-br')}#invoice-workspace` },
      { name: 'Início', href: getRouteUrl('home', 'pt-br') },
    ]
  : locale === 'es'
  ? [
      { name: 'Generador de Recibos de Pago', href: getRouteUrl('receipt', 'es') },
      { name: 'Factura Comercial y Cobro', href: `${getRouteUrl('home', 'es')}#workspace-recibos` },
      { name: 'Recibo de Alquiler', href: `${getRouteUrl('receipt', 'es')}?tipo=alquiler` },
      { name: 'Inicio', href: getRouteUrl('home', 'es') },
    ]
  : [
      { name: 'Free Invoice Generator', href: getRouteUrl('home', locale) },
      { name: 'Free Receipt Generator', href: getRouteUrl('receipt', locale) },
      { name: 'Rent Receipt Generator', href: getRouteUrl('rent-receipt', locale) },
      { name: 'Itemized Receipt Maker', href: getRouteUrl('receipt-items', locale) },
      { name: 'Excel Invoice Generator', href: getRouteUrl('invoice-excel', locale) },
    ];

const templateLinks = locale === 'pt-br'
  ? [
      { name: 'Recibo Simples e Gratuito', href: getRouteUrl('receipt', 'pt-br') },
      { name: 'Recibo com QR Code Pix', href: getRouteUrl('receipt', 'pt-br') },
      { name: 'Recibo de Aluguel com IPTU', href: getRouteUrl('rent-receipt', 'pt-br') },
      { name: 'Modelo de Recibo Pronto', href: getRouteUrl('receipt-template', 'pt-br') },
      { name: 'Recibo de Venda no Balcão', href: `${getRouteUrl('receipt', 'pt-br')}?tipo=venda` },
    ]
  : locale === 'es'
  ? [
      { name: 'Recibo de Pago Simple', href: getRouteUrl('receipt', 'es') },
      { name: 'Recibo con Código QR', href: getRouteUrl('receipt', 'es') },
      { name: 'Recibo de Alquiler y Fianza', href: `${getRouteUrl('receipt', 'es')}?tipo=alquiler` },
      { name: 'Factura Comercial con IVA', href: `${getRouteUrl('home', 'es')}#workspace-recibos` },
    ]
  : [
      { name: 'Freelancer Invoices', href: getRouteUrl('invoice-freelance', locale) },
      { name: 'Contractor Invoices', href: getRouteUrl('contractor-invoice', locale) },
      { name: 'Australia Tax Invoices (ATO)', href: getRouteUrl('tax-invoice-australia', locale) },
      { name: 'Photography Invoices', href: getRouteUrl('photography-invoice', locale) },
      { name: 'Design System & Style Guide', href: '/style-guide' },
    ];

const resourceLinks = locale === 'pt-br'
  ? [
      { name: 'Como Fazer um Recibo', href: `${getRouteUrl('receipt', 'pt-br')}#como-fazer` },
      { name: 'Recibo vs Nota Fiscal', href: `${getRouteUrl('receipt', 'pt-br')}#recibo-vs-nota-fiscal` },
      { name: 'Valor por Extenso Automático', href: `${getRouteUrl('receipt', 'pt-br')}#valor-por-extenso` },
      { name: 'Recibo de Locação Residencial', href: `${getRouteUrl('rent-receipt', 'pt-br')}#guia-aluguel` },
    ]
  : locale === 'es'
  ? [
      { name: 'Cómo Hacer un Recibo de Pago', href: `${getRouteUrl('receipt', 'es')}#como-hacer` },
      { name: 'Diferencias entre Recibo y Factura', href: `${getRouteUrl('receipt', 'es')}#recibo-vs-factura` },
      { name: 'Importe en Letras Automático', href: `${getRouteUrl('receipt', 'es')}#importe-en-letra` },
      { name: 'Aviso Legal (LSSI-CE)', href: getRouteUrl('aviso-legal', 'es') },
    ]
  : [
      { name: 'Invoicing Blog & Guides', href: getRouteUrl('blog', locale) },
      { name: 'How to Invoice Clients', href: getRouteUrl('blog-freelance', locale) },
      { name: 'Small Business Bookkeeping', href: getRouteUrl('blog', locale) },
      { name: 'GST & VAT Compliance Guide', href: getRouteUrl('tax-invoice-australia', locale) },
    ];

const companyLinks = locale === 'pt-br'
  ? [
      { name: 'Sobre Nós', href: getRouteUrl('about', 'pt-br') },
      { name: 'Contato e Suporte', href: getRouteUrl('contact', 'pt-br') },
      { name: 'Política de Privacidade (LGPD)', href: getRouteUrl('privacy', 'pt-br') },
      { name: 'Termos de Uso', href: getRouteUrl('terms', 'pt-br') },
    ]
  : locale === 'es'
  ? [
      { name: 'Sobre Nosotros', href: getRouteUrl('about', 'es') },
      { name: 'Contacto y Soporte', href: getRouteUrl('contact', 'es') },
      { name: 'Política de Privacidad (RGPD)', href: getRouteUrl('privacy', 'es') },
      { name: 'Términos y Condiciones', href: getRouteUrl('terms', 'es') },
      { name: 'Aviso Legal', href: getRouteUrl('aviso-legal', 'es') },
    ]
  : [
      { name: d.footer.aboutUs, href: getRouteUrl('about', locale) },
      { name: d.footer.contactUs, href: getRouteUrl('contact', locale) },
      { name: d.footer.privacyPolicy, href: getRouteUrl('privacy', locale) },
      { name: 'Terms and Conditions', href: getRouteUrl('terms', locale) },
      { name: 'Product Changelog', href: getRouteUrl('changelog', locale) },
    ];
---

<footer
  class="border-t border-hairline bg-surface-soft dark:bg-canvas text-body transition-colors"
  role="contentinfo"
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 space-y-12">
    <!-- Top Section: Brand Statement & Privacy Badge -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-12 border-b border-hairline">
      <div class="space-y-2 max-w-xl">
        <a
          href={getRouteUrl('home', locale)}
          class="group inline-flex items-center gap-2.5 text-ink transition-colors hover:text-primary"
        >
          <img
            src="/favicon.svg"
            alt="Online Invoice Creator"
            width="32"
            height="32"
            class="h-8 w-8 rounded-lg shadow-xs transition-transform group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <span class="text-lg font-bold tracking-tight text-ink">OnlineInvoiceCreator</span>
        </a>
        <p class="text-xs text-mute leading-relaxed">
          {d.footer.brandStatement}
        </p>
      </div>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center gap-3 text-xs">
        <div class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-surface-card px-3 py-1.5 text-ink shadow-2xs font-medium">
          <svg
            class="h-3.5 w-3.5 text-accent-teal"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            />
          </svg>
          <span>{d.form.clientSidePrivate}</span>
        </div>
        <div class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-surface-card px-3 py-1.5 text-ink shadow-2xs font-medium">
          <svg
            class="h-3.5 w-3.5 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>{d.form.noWatermarkNoSignup}</span>
        </div>
      </div>
    </div>

    <!-- 4-Column Navigation Links Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-xs">
      <!-- Col 1: Core Tools -->
      <div class="space-y-3">
        <p class="font-bold text-ink uppercase tracking-wider text-[11px]" set:html={d.footer.invoicingTools}></p>
        <ul class="space-y-2 text-mute">
          {toolLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Templates -->
      <div class="space-y-3">
        <p class="font-bold text-ink uppercase tracking-wider text-[11px]" set:html={d.footer.specializedTemplates}></p>
        <ul class="space-y-2 text-mute">
          {templateLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Resources -->
      <div class="space-y-3">
        <p class="font-bold text-ink uppercase tracking-wider text-[11px]" set:html={d.footer.guidesResources}></p>
        <ul class="space-y-2 text-mute">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Legal & Company -->
      <div class="space-y-3">
        <p class="font-bold text-ink uppercase tracking-wider text-[11px]" set:html={d.footer.companyLegal}></p>
        <ul class="space-y-2 text-mute">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Compliance Notice: Mandatory Genuine Transactions Requirement -->
    <div class="rounded-xl border border-hairline bg-surface-card p-4 text-xs text-mute leading-relaxed">
      <div class="flex items-start gap-2.5">
        <svg
          class="h-4 w-4 shrink-0 text-accent-warning mt-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <p>
          {d.footer.complianceNotice}
        </p>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Legal Slugs -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-hairline text-[11px] text-mute">
      <div>{d.footer.copyright}</div>
      <div class="flex items-center gap-4">
        <a href={getRouteUrl('privacy', locale)} class="hover:text-ink transition-colors">
          {d.footer.privacyPolicy}
        </a>
        <span class="text-hairline">·</span>
        <a href={getRouteUrl('terms', locale)} class="hover:text-ink transition-colors">
          {d.footer.termsOfService}
        </a>
        <span class="text-hairline">·</span>
        <a href={getRouteUrl('about', locale)} class="hover:text-ink transition-colors">
          {d.footer.aboutUs}
        </a>
        <span class="text-hairline">·</span>
        <a href={getRouteUrl('contact', locale)} class="hover:text-ink transition-colors">
          {d.footer.contactUs}
        </a>
        {locale === 'es' && (
          <>
            <span class="text-hairline">·</span>
            <a href={getRouteUrl('aviso-legal', locale)} class="hover:text-ink transition-colors">
              Aviso Legal
            </a>
          </>
        )}
        {locale === 'en' && (
          <>
            <span class="text-hairline">·</span>
            <a href={getRouteUrl('changelog', locale)} class="hover:text-ink transition-colors">
              {d.footer.changelog}
            </a>
          </>
        )}
      </div>
    </div>
  </div>
</footer>
