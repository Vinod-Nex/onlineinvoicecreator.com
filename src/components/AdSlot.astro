---
/**
 * AdSlot Component with Zero-CLS Reserved Space & Interaction Lazy-Loading
 *
 * Implements strict Core Web Vitals guarantees & revenue readiness:
 * 1. Reserved Space: Explicit min-height and containment ensures CLS = 0.00
 * 2. Interaction-Gated Lazy Loading: Scripts and network requests ONLY trigger AFTER user interaction
 * 3. Viewport Intersection: Elements only load when approaching the viewport via IntersectionObserver
 * 4. Non-Intrusive: Positioned strictly below the tool canvas, never inside forms, never covering download buttons
 * 5. Consent Aware: Cooperates with ConsentBanner (GDPR / UK ePrivacy compliance)
 */

interface Props {
  slotId?: string;
  format?: 'banner' | 'rectangle' | 'responsive';
  class?: string;
}

const { slotId = 'ad-slot-default', format = 'responsive', class: className = '' } = Astro.props;

// Standard format dimensions to prevent any layout shifts
const formatDimensions = {
  banner: 'min-h-[90px] max-w-[728px]',
  rectangle: 'min-h-[250px] max-w-[300px]',
  responsive: 'min-h-[100px] sm:min-h-[120px] max-w-4xl',
};

const dimensionClass = formatDimensions[format] || formatDimensions.responsive;
---

<div
  class={`ad-slot-container mx-auto my-8 w-full ${dimensionClass} ${className} relative overflow-hidden rounded-2xl border border-hairline/60 bg-surface-soft/40 p-4 transition-all no-print`}
  id={`container-${slotId}`}
  data-ad-slot={slotId}
  style="contain: layout paint style;"
>
  <!-- Ad Disclosure Label -->
  <div class="flex items-center justify-between text-[11px] font-medium text-mute pb-2 border-b border-hairline/40">
    <span class="tracking-wider uppercase">Advertisement</span>
    <span class="text-[10px] text-mute/80">Privacy-First • Lazy-Loaded After Interaction</span>
  </div>

  <!-- Ad Placeholder / Insertion Zone -->
  <div
    id={slotId}
    class="ad-content-target flex items-center justify-center min-h-[60px] sm:min-h-[80px] w-full text-xs text-mute/60 italic"
    aria-label="Sponsored placement"
  >
    <slot>
      <div class="flex items-center gap-2">
        <svg
          class="h-4 w-4 text-mute/40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
        <span>Reserved Ad Space (Loaded after user interaction)</span>
      </div>
    </slot>
  </div>
</div>

<script is:inline>
  (function () {
    // Core Web Vitals Protection:
    // 1. Wait for first meaningful user interaction (scroll, click, touch, keydown)
    // 2. Wait for idle time via requestIdleCallback
    // 3. Only load when the ad container intersects or approaches the viewport
    let hasInteracted = false;
    let interactionListenersBound = false;

    const targetContainer = document.getElementById(`container-${slotId}`);

    function loadAdScripts() {
      // Dispatches custom ad provider initialization hook when ready
      const event = new CustomEvent('oic:ad-slot-ready', {
        detail: {
          slotId: slotId,
          timestamp: performance.now(),
          consent: localStorage.getItem('oic_consent_status') || 'not_required',
        },
      });
      window.dispatchEvent(event);
    }

    function scheduleAdLoading() {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadAdScripts, { timeout: 3000 });
      } else {
        setTimeout(loadAdScripts, 1000);
      }
    }

    function onUserInteraction() {
      if (hasInteracted) return;
      hasInteracted = true;
      removeInteractionListeners();

      // Once user has interacted, observe when the container approaches viewport
      if ('IntersectionObserver' in window && targetContainer) {
        const observer = new IntersectionObserver(
          function (entries, obs) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                obs.disconnect();
                scheduleAdLoading();
              }
            });
          },
          { rootMargin: '250px' }
        );
        observer.observe(targetContainer);
      } else {
        scheduleAdLoading();
      }
    }

    function bindInteractionListeners() {
      if (interactionListenersBound) return;
      interactionListenersBound = true;
      const interactionEvents = ['pointerdown', 'scroll', 'keydown', 'touchstart', 'wheel'];
      interactionEvents.forEach(function (evt) {
        window.addEventListener(evt, onUserInteraction, { once: true, passive: true });
      });
    }

    function removeInteractionListeners() {
      const interactionEvents = ['pointerdown', 'scroll', 'keydown', 'touchstart', 'wheel'];
      interactionEvents.forEach(function (evt) {
        window.removeEventListener(evt, onUserInteraction);
      });
    }

    // Initialize interaction bindings once document is interactive
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', bindInteractionListeners);
    } else {
      bindInteractionListeners();
    }
  })();
</script>
