---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getDictionary } from '../i18n';
import { getRouteUrl } from '../i18n/routes';
import { type Locale, DEFAULT_LOCALE } from '../i18n/config';

interface Props {
  currentPath?: string;
  locale?: Locale;
}

const { currentPath = Astro.url.pathname.replace(/\/$/, '') || '/', locale = DEFAULT_LOCALE } = Astro.props;
const d = getDictionary(locale);

const tools = locale === 'pt-br'
  ? [
      {
        name: d.tools.invoiceGenerator,
        href: getRouteUrl('home', 'pt-br'),
        description: d.tools.invoiceGeneratorDesc,
      },
      {
        name: d.tools.receiptGenerator,
        href: getRouteUrl('receipt', 'pt-br'),
        description: d.tools.receiptGeneratorDesc,
      },
      {
        name: d.tools.rentReceiptGenerator,
        href: getRouteUrl('rent-receipt', 'pt-br'),
        description: d.tools.rentReceiptGeneratorDesc,
      },
    ]
  : locale === 'es'
  ? [
      {
        name: 'Generador de recibos',
        href: getRouteUrl('receipt', 'es'),
        description: 'Crea y descarga recibos de pago en PDF al instante',
      },
      {
        name: 'Factura y comprobante',
        href: `${getRouteUrl('home', 'es')}#workspace-recibos`,
        description: 'Documentos comerciales y de cobro en tu navegador',
      },
      {
        name: 'Recibo de alquiler',
        href: `${getRouteUrl('receipt', 'es')}?tipo=alquiler`,
        description: 'Comprobante de arrendamiento mensual con fianza',
      },
    ]
  : [
      {
        name: d.tools.invoiceGenerator,
        href: getRouteUrl('home', locale),
        description: d.tools.invoiceGeneratorDesc,
      },
      {
        name: d.tools.receiptGenerator,
        href: getRouteUrl('receipt', locale),
        description: d.tools.receiptGeneratorDesc,
      },
      {
        name: d.tools.rentReceiptGenerator,
        href: getRouteUrl('rent-receipt', locale),
        description: d.tools.rentReceiptGeneratorDesc,
      },
    ];

const templates = locale === 'pt-br'
  ? [
      { name: 'Recibo de pagamento', href: getRouteUrl('receipt', 'pt-br'), tag: 'Popular' },
      { name: 'Recibo de aluguel', href: getRouteUrl('rent-receipt', 'pt-br'), tag: 'Imóvel' },
      { name: 'Recibo de venda', href: `${getRouteUrl('receipt', 'pt-br')}?tipo=venda`, tag: 'Comércio' },
      { name: 'Modelo de recibo', href: getRouteUrl('receipt-template', 'pt-br'), tag: 'Exemplo' },
    ]
  : locale === 'es'
  ? [
      { name: 'Recibo de pago', href: getRouteUrl('receipt', 'es'), tag: 'Popular' },
      { name: 'Recibo de alquiler', href: `${getRouteUrl('receipt', 'es')}?tipo=alquiler`, tag: 'Inmueble' },
      { name: 'Factura simple', href: `${getRouteUrl('home', 'es')}#workspace-recibos`, tag: 'Comercial' },
      { name: 'Factura con IVA', href: `${getRouteUrl('home', 'es')}#workspace-recibos`, tag: 'IVA' },
    ]
  : [
      { name: d.templatesMenu.freelancerInvoices, href: getRouteUrl('invoice-freelance', locale), tag: d.templatesMenu.tagPopular },
      { name: d.templatesMenu.contractorInvoices, href: getRouteUrl('contractor-invoice', locale), tag: d.templatesMenu.tagTrade },
      { name: d.templatesMenu.australiaTaxInvoices, href: getRouteUrl('tax-invoice-australia', locale), tag: d.templatesMenu.tagGST },
      { name: d.templatesMenu.photographyInvoices, href: getRouteUrl('photography-invoice', locale), tag: d.templatesMenu.tagCreative },
      { name: d.templatesMenu.itemizedReceiptMaker, href: getRouteUrl('receipt-items', locale), tag: d.templatesMenu.tagRetail },
      { name: d.templatesMenu.excelInvoiceGenerator, href: getRouteUrl('invoice-excel', locale), tag: d.templatesMenu.tagSpreadsheet },
    ];
---

<header
  class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md transition-colors duration-200"
  role="banner"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-3 sm:px-6 lg:px-6 xl:px-8">
    <!-- Brand Logo -->
    <div class="flex items-center gap-2 sm:gap-3 min-w-0">
      <a
        href={getRouteUrl('home', locale)}
        class="group flex items-center gap-2 sm:gap-2.5 text-ink transition-colors hover:text-primary min-w-0"
        aria-label="Online Invoice Creator Homepage"
      >
        <img
          src="/favicon.svg"
          alt="Online Invoice Creator"
          width="36"
          height="36"
          class="h-8 w-8 sm:h-9 sm:w-9 rounded-xl shadow-xs transition-transform group-hover:scale-105 shrink-0"
          loading="eager"
          decoding="async"
        />
        <div class="flex flex-col min-w-0">
          <span class="text-sm sm:text-base font-bold tracking-tight text-ink truncate">OnlineInvoiceCreator</span>
          <span class="hidden xl:block text-[10px] font-medium uppercase tracking-wider text-mute">
            {d.nav.brandSubtitle}
          </span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-0.5 xl:gap-1.5" aria-label="Main Navigation">
      <!-- Invoice Link -->
      <a
        href={getRouteUrl('home', locale)}
        class={`px-2.5 xl:px-3 py-1.5 text-sm font-semibold rounded-full transition-colors ${
          currentPath === getRouteUrl('home', locale)
            ? 'bg-surface-soft text-primary dark:bg-surface-elevated'
            : 'text-ink hover:text-primary hover:bg-surface-soft dark:hover:bg-surface-elevated'
        }`}
      >
        {d.nav.invoice}
      </a>

      <!-- Receipt Link -->
      <a
        href={getRouteUrl('receipt', locale)}
        class={`px-2.5 xl:px-3 py-1.5 text-sm font-semibold rounded-full transition-colors ${
          currentPath === getRouteUrl('receipt', locale)
            ? 'bg-surface-soft text-primary dark:bg-surface-elevated'
            : 'text-ink hover:text-primary hover:bg-surface-soft dark:hover:bg-surface-elevated'
        }`}
      >
        {d.nav.receipt}
      </a>

      <!-- Rent Receipt Link -->
      {locale !== 'es' && (
        <a
          href={getRouteUrl('rent-receipt', locale)}
          class={`px-2.5 xl:px-3 py-1.5 text-sm font-semibold rounded-full transition-colors ${
            currentPath === getRouteUrl('rent-receipt', locale)
              ? 'bg-surface-soft text-primary dark:bg-surface-elevated'
              : 'text-ink hover:text-primary hover:bg-surface-soft dark:hover:bg-surface-elevated'
          }`}
        >
          {d.nav.rentReceipt}
        </a>
      )}

      <!-- Templates Dropdown (CSS Hover & Focus-Within) -->
      <div class="relative group">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 px-2.5 xl:px-3 py-1.5 text-sm font-semibold text-ink rounded-full hover:bg-surface-soft hover:text-primary transition-colors dark:hover:bg-surface-elevated cursor-pointer group-focus-within:bg-surface-soft"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>{d.nav.templates}</span>
          <svg
            class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 text-mute"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div class="invisible group-hover:visible group-focus-within:visible opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-all duration-150 absolute left-0 top-full mt-2 w-72 rounded-2xl border border-hairline bg-surface-card p-2 shadow-elevated z-50">
          <div class="px-3 py-2 text-[11px] font-bold uppercase tracking-wider text-mute border-b border-hairline mb-1">
            {d.nav.specializedTemplates}
          </div>
          <div class="space-y-0.5">
            {templates.map((tpl) => (
              <a
                href={tpl.href}
                class={`flex items-center justify-between px-3 py-2 text-xs font-semibold rounded-xl transition-colors ${
                  currentPath === tpl.href
                    ? 'bg-primary/10 text-primary'
                    : 'text-ink hover:bg-surface-soft hover:text-primary dark:hover:bg-surface-elevated'
                }`}
              >
                <span>{tpl.name}</span>
                <span class="rounded bg-surface-soft px-1.5 py-0.5 text-[10px] font-medium text-mute border border-hairline dark:bg-surface-deep">
                  {tpl.tag}
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Blog Link -->
      {locale === 'en' && (
        <a
          href={getRouteUrl('blog', locale)}
          class={`px-2.5 xl:px-3 py-1.5 text-sm font-semibold rounded-full transition-colors ${
            currentPath === getRouteUrl('blog', locale)
              ? 'bg-surface-soft text-primary dark:bg-surface-elevated'
              : 'text-ink hover:text-primary hover:bg-surface-soft dark:hover:bg-surface-elevated'
          }`}
        >
          {d.nav.guides}
        </a>
      )}

      <!-- About Us Link (Shown on XL+ to prevent 1024px squeezing) -->
      <a
        href={getRouteUrl('about', locale)}
        class={`hidden xl:inline-flex px-3 py-1.5 text-sm font-semibold rounded-full transition-colors ${
          currentPath === getRouteUrl('about', locale)
            ? 'bg-surface-soft text-primary dark:bg-surface-elevated'
            : 'text-ink hover:text-primary hover:bg-surface-soft dark:hover:bg-surface-elevated'
        }`}
      >
        {d.nav.about}
      </a>

      <!-- Contact Us Link (Shown on XL+ to prevent 1024px squeezing) -->
      <a
        href={getRouteUrl('contact', locale)}
        class={`hidden xl:inline-flex px-3 py-1.5 text-sm font-semibold rounded-full transition-colors ${
          currentPath === getRouteUrl('contact', locale)
            ? 'bg-surface-soft text-primary dark:bg-surface-elevated'
            : 'text-ink hover:text-primary hover:bg-surface-soft dark:hover:bg-surface-elevated'
        }`}
      >
        {d.nav.contact}
      </a>
    </nav>

    <!-- Header Actions (Desktop: Language Switcher, Theme Toggle & CTA) -->
    <div class="hidden lg:flex items-center gap-2 xl:gap-3 shrink-0">
      <LanguageSwitcher currentPath={currentPath} currentLocale={locale} />
      <ThemeToggle />
      <a
        href={`${getRouteUrl('home', locale)}#invoice-workspace`}
        id="header-btn-create-invoice"
        class="btn btn-cobalt h-9 px-3.5 xl:px-4 text-xs shadow-xs"
      >
        <span>{d.buttons.createInvoice}</span>
        <svg
          class="h-3.5 w-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Trigger (<details> based for zero JS dependency) -->
    <div class="flex items-center gap-1.5 sm:gap-2 lg:hidden shrink-0">
      <LanguageSwitcher currentPath={currentPath} currentLocale={locale} compact={true} />
      <ThemeToggle showLabel={false} />

      <details id="mobile-nav-details" class="group relative">
        <summary
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-hairline bg-surface-soft text-ink transition-colors hover:bg-surface-elevated cursor-pointer list-none [&::-webkit-details-marker]:hidden"
          aria-label={d.nav.openMenu}
        >
          <!-- Hamburger icon (closed state) -->
          <svg
            class="h-5 w-5 group-open:hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon (open state) -->
          <svg
            class="h-5 w-5 hidden group-open:block text-accent-danger"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </summary>

        <!-- Mobile Menu Drawer Dropdown -->
        <div class="absolute right-0 top-full mt-2 w-[calc(100vw-2rem)] max-w-xs sm:w-80 max-h-[calc(100vh-5rem)] overflow-y-auto rounded-2xl border border-hairline bg-surface-card p-5 shadow-elevated z-50 space-y-5 animate-in fade-in slide-in-from-top-2 duration-150">
          <!-- Tools Section -->
          <div class="space-y-2">
            <div class="text-[11px] font-bold uppercase tracking-wider text-mute">{d.nav.coreTools}</div>
            <div class="space-y-1">
              {tools.map((tool) => (
                <a
                  href={tool.href}
                  class={`block rounded-xl p-2.5 transition-colors ${
                    currentPath === tool.href
                      ? 'bg-primary/10 text-primary'
                      : 'hover:bg-surface-soft text-ink dark:hover:bg-surface-elevated'
                  }`}
                >
                  <div class="text-xs font-bold">{tool.name}</div>
                  <div class="text-[11px] text-mute">{tool.description}</div>
                </a>
              ))}
            </div>
          </div>

          <!-- Templates Section -->
          <div class="space-y-2 pt-3 border-t border-hairline">
            <div class="text-[11px] font-bold uppercase tracking-wider text-mute">{d.nav.templates}</div>
            <div class="grid grid-cols-2 gap-1 text-xs">
              {templates.map((tpl) => (
                <a
                  href={tpl.href}
                  class="rounded-lg px-2.5 py-1.5 font-medium text-ink hover:bg-surface-soft hover:text-primary transition-colors dark:hover:bg-surface-elevated"
                >
                  {tpl.name}
                </a>
              ))}
            </div>
          </div>

          <!-- Company & Legal Section -->
          <div class="space-y-2 pt-3 border-t border-hairline">
            <div class="text-[11px] font-bold uppercase tracking-wider text-mute" set:html={d.nav.companyLegal}></div>
            <div class="grid grid-cols-2 gap-1 text-xs">
              <a
                href={getRouteUrl('about', locale)}
                class={`rounded-lg px-2.5 py-1.5 font-medium transition-colors ${
                  currentPath === getRouteUrl('about', locale)
                    ? 'bg-primary/10 text-primary'
                    : 'text-ink hover:bg-surface-soft hover:text-primary dark:hover:bg-surface-elevated'
                }`}
              >
                {d.footer.aboutUs}
              </a>
              <a
                href={getRouteUrl('contact', locale)}
                class={`rounded-lg px-2.5 py-1.5 font-medium transition-colors ${
                  currentPath === getRouteUrl('contact', locale)
                    ? 'bg-primary/10 text-primary'
                    : 'text-ink hover:bg-surface-soft hover:text-primary dark:hover:bg-surface-elevated'
                }`}
              >
                {d.footer.contactUs}
              </a>
              <a
                href={getRouteUrl('privacy', locale)}
                class={`rounded-lg px-2.5 py-1.5 font-medium transition-colors ${
                  currentPath === getRouteUrl('privacy', locale)
                    ? 'bg-primary/10 text-primary'
                    : 'text-ink hover:bg-surface-soft hover:text-primary dark:hover:bg-surface-elevated'
                }`}
              >
                {d.footer.privacyPolicy}
              </a>
              <a
                href={getRouteUrl('terms', locale)}
                class={`rounded-lg px-2.5 py-1.5 font-medium transition-colors ${
                  currentPath === getRouteUrl('terms', locale)
                    ? 'bg-primary/10 text-primary'
                    : 'text-ink hover:bg-surface-soft hover:text-primary dark:hover:bg-surface-elevated'
                }`}
              >
                {d.footer.termsOfService}
              </a>
            </div>
          </div>

          <!-- Bottom Actions -->
          <div class="pt-3 border-t border-hairline space-y-2">
            {locale === 'en' && (
              <a
                href={getRouteUrl('blog', locale)}
                class="flex items-center justify-between text-xs font-semibold text-ink hover:text-primary p-1"
              >
                <span set:html={d.nav.billingGuides}></span>
                <span>→</span>
              </a>
            )}
            <a href={`${getRouteUrl('home', locale)}#workspace-recibos`} id="mobile-btn-create-invoice" class="btn btn-cobalt w-full text-xs h-10 shadow-sm">
              {d.nav.createFreeInvoice}
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<!-- Accessibility & Navigation Helper -->
<script>
  function initHeaderHelpers() {
    const details = document.getElementById('mobile-nav-details') as HTMLDetailsElement | null;
    if (details) {
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && details.open) {
          details.open = false;
        }
      });

      document.addEventListener('click', (e) => {
        if (details.open && !details.contains(e.target as Node)) {
          details.open = false;
        }
      });
    }

    const handleInvoiceScroll = (e: Event) => {
      const isHome =
        window.location.pathname === '/' ||
        window.location.pathname === '' ||
        window.location.pathname === '/pt-br' ||
        window.location.pathname === '/pt-br/' ||
        window.location.pathname === '/es' ||
        window.location.pathname === '/es/';
      if (isHome) {
        e.preventDefault();
        const ws = document.getElementById('workspace-recibos') || document.getElementById('invoice-workspace');
        if (ws) {
          ws.scrollIntoView({ behavior: 'smooth' });
        }
      }
    };

    document.getElementById('header-btn-create-invoice')?.addEventListener('click', handleInvoiceScroll);
    document.getElementById('mobile-btn-create-invoice')?.addEventListener('click', handleInvoiceScroll);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderHelpers);
  } else {
    initHeaderHelpers();
  }
  document.addEventListener('astro:after-swap', initHeaderHelpers);
</script>
