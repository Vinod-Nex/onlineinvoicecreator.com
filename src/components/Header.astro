---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname.replace(/\/$/, '') || '/' } = Astro.props;

const tools = [
  {
    name: 'Invoice Generator',
    href: '/',
    description: 'Free, watermark-free invoices with instant PDF export',
  },
  {
    name: 'Receipt Generator',
    href: '/free-online-receipt-generator',
    description: 'Professional payment receipts for business & clients',
  },
  {
    name: 'Rent Receipt Generator',
    href: '/free-rent-receipt-generator',
    description: 'Monthly rent proofs for landlords and tenants',
  },
];

const templates = [
  { name: 'Freelancer Invoices', href: '/invoice-generator-for-freelancers', tag: 'Popular' },
  { name: 'Contractor Invoices', href: '/contractor-invoice-template', tag: 'Trade' },
  { name: 'Australia Tax Invoices (ATO)', href: '/tax-invoice-template-australia', tag: 'GST' },
  { name: 'Photography Invoices', href: '/photography-invoice-generator', tag: 'Creative' },
  { name: 'Itemized Receipt Maker', href: '/receipt-maker-with-items', tag: 'Retail' },
  { name: 'Excel Invoice Generator', href: '/invoice-generator-excel', tag: 'Spreadsheet' },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md transition-colors duration-200"
  role="banner"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <div class="flex items-center gap-3">
      <a
        href="/"
        class="group flex items-center gap-2.5 text-ink transition-colors hover:text-primary"
        aria-label="Online Invoice Creator Homepage"
      >
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary text-white shadow-xs transition-transform group-hover:scale-105">
          <svg
            class="h-5 w-5"
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect width="32" height="32" rx="8" fill="#494FDF" />
            <path
              d="M9 7C9 5.89543 9.89543 5 11 5H17.5858C18.1163 5 18.625 5.21071 19 5.58579L22.4142 9C22.7893 9.375 23 9.88371 23 10.4142V25C23 26.1046 22.1046 27 21 27H11C9.89543 27 9 26.1046 9 25V7Z"
              fill="white"
            />
            <path
              d="M17 5V9C17 9.55228 17.4477 10 18 10H22"
              stroke="#494FDF"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <line
              x1="12"
              y1="14"
              x2="20"
              y2="14"
              stroke="#494FDF"
              stroke-width="1.75"
              stroke-linecap="round"
            />
            <line
              x1="12"
              y1="18"
              x2="20"
              y2="18"
              stroke="#8D969E"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <line
              x1="12"
              y1="22"
              x2="16"
              y2="22"
              stroke="#8D969E"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-base font-bold tracking-tight text-ink">OnlineInvoiceCreator</span>
          <span class="text-[10px] font-medium uppercase tracking-wider text-mute">
            100% Free · No Signup
          </span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
      <!-- Invoice Link -->
      <a
        href="/"
        class={`px-3 py-1.5 text-sm font-semibold rounded-full transition-colors ${
          currentPath === '/'
            ? 'bg-surface-soft text-primary dark:bg-surface-elevated'
            : 'text-ink hover:text-primary hover:bg-surface-soft dark:hover:bg-surface-elevated'
        }`}
      >
        Invoice
      </a>

      <!-- Receipt Link -->
      <a
        href="/free-online-receipt-generator"
        class={`px-3 py-1.5 text-sm font-semibold rounded-full transition-colors ${
          currentPath === '/free-online-receipt-generator'
            ? 'bg-surface-soft text-primary dark:bg-surface-elevated'
            : 'text-ink hover:text-primary hover:bg-surface-soft dark:hover:bg-surface-elevated'
        }`}
      >
        Receipt
      </a>

      <!-- Rent Receipt Link -->
      <a
        href="/free-rent-receipt-generator"
        class={`px-3 py-1.5 text-sm font-semibold rounded-full transition-colors ${
          currentPath === '/free-rent-receipt-generator'
            ? 'bg-surface-soft text-primary dark:bg-surface-elevated'
            : 'text-ink hover:text-primary hover:bg-surface-soft dark:hover:bg-surface-elevated'
        }`}
      >
        Rent Receipt
      </a>

      <!-- Templates Dropdown (CSS Hover & Focus-Within) -->
      <div class="relative group">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-semibold text-ink rounded-full hover:bg-surface-soft hover:text-primary transition-colors dark:hover:bg-surface-elevated cursor-pointer group-focus-within:bg-surface-soft"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>Templates</span>
          <svg
            class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 text-mute"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div class="invisible group-hover:visible group-focus-within:visible opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-all duration-150 absolute left-0 top-full mt-2 w-72 rounded-2xl border border-hairline bg-surface-card p-2 shadow-elevated z-50">
          <div class="px-3 py-2 text-[11px] font-bold uppercase tracking-wider text-mute border-b border-hairline mb-1">
            Specialized Templates
          </div>
          <div class="space-y-0.5">
            {templates.map((tpl) => (
              <a
                href={tpl.href}
                class={`flex items-center justify-between px-3 py-2 text-xs font-semibold rounded-xl transition-colors ${
                  currentPath === tpl.href
                    ? 'bg-primary/10 text-primary'
                    : 'text-ink hover:bg-surface-soft hover:text-primary dark:hover:bg-surface-elevated'
                }`}
              >
                <span>{tpl.name}</span>
                <span class="rounded bg-surface-soft px-1.5 py-0.5 text-[10px] font-medium text-mute border border-hairline dark:bg-surface-deep">
                  {tpl.tag}
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Blog Link -->
      <a
        href="/blog"
        class={`px-3 py-1.5 text-sm font-semibold rounded-full transition-colors ${
          currentPath === '/blog'
            ? 'bg-surface-soft text-primary dark:bg-surface-elevated'
            : 'text-ink hover:text-primary hover:bg-surface-soft dark:hover:bg-surface-elevated'
        }`}
      >
        Guides
      </a>
    </nav>

    <!-- Header Actions (Desktop: Theme Toggle & CTA) -->
    <div class="hidden lg:flex items-center gap-3">
      <ThemeToggle />
      <a href="/" class="btn btn-cobalt h-9 px-4 text-xs shadow-xs">
        <span>Create Invoice</span>
        <svg
          class="h-3.5 w-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Trigger (<details> based for zero JS dependency) -->
    <div class="flex items-center gap-2 lg:hidden">
      <ThemeToggle showLabel={false} />

      <details id="mobile-nav-details" class="group relative">
        <summary
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-hairline bg-surface-soft text-ink transition-colors hover:bg-surface-elevated cursor-pointer list-none [&::-webkit-details-marker]:hidden"
          aria-label="Open mobile navigation menu"
        >
          <!-- Hamburger icon (closed state) -->
          <svg
            class="h-5 w-5 group-open:hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon (open state) -->
          <svg
            class="h-5 w-5 hidden group-open:block text-accent-danger"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </summary>

        <!-- Mobile Menu Drawer Dropdown -->
        <div class="absolute right-0 top-full mt-3 w-[calc(100vw-2rem)] max-w-xs sm:w-80 rounded-2xl border border-hairline bg-surface-card p-5 shadow-elevated z-50 space-y-5 animate-in fade-in slide-in-from-top-2 duration-150">
          <!-- Tools Section -->
          <div class="space-y-2">
            <div class="text-[11px] font-bold uppercase tracking-wider text-mute">Core Tools</div>
            <div class="space-y-1">
              {tools.map((tool) => (
                <a
                  href={tool.href}
                  class={`block rounded-xl p-2.5 transition-colors ${
                    currentPath === tool.href
                      ? 'bg-primary/10 text-primary'
                      : 'hover:bg-surface-soft text-ink dark:hover:bg-surface-elevated'
                  }`}
                >
                  <div class="text-xs font-bold">{tool.name}</div>
                  <div class="text-[11px] text-mute">{tool.description}</div>
                </a>
              ))}
            </div>
          </div>

          <!-- Templates Section -->
          <div class="space-y-2 pt-3 border-t border-hairline">
            <div class="text-[11px] font-bold uppercase tracking-wider text-mute">Templates</div>
            <div class="grid grid-cols-2 gap-1 text-xs">
              {templates.map((tpl) => (
                <a
                  href={tpl.href}
                  class="rounded-lg px-2.5 py-1.5 font-medium text-ink hover:bg-surface-soft hover:text-primary transition-colors dark:hover:bg-surface-elevated"
                >
                  {tpl.name}
                </a>
              ))}
            </div>
          </div>

          <!-- Bottom Actions -->
          <div class="pt-3 border-t border-hairline space-y-2">
            <a
              href="/blog"
              class="flex items-center justify-between text-xs font-semibold text-ink hover:text-primary p-1"
            >
              <span>Billing Guides & Articles</span>
              <span>→</span>
            </a>
            <a href="/" class="btn btn-cobalt w-full text-xs h-10 shadow-sm">
              Create Free Invoice
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<!-- Tiny accessibility helper: closes mobile menu on Escape key or outside click -->
<script>
  function initMobileMenuHelper() {
    const details = document.getElementById('mobile-nav-details') as HTMLDetailsElement | null;
    if (!details) return;

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.open) {
        details.open = false;
      }
    });

    document.addEventListener('click', (e) => {
      if (details.open && !details.contains(e.target as Node)) {
        details.open = false;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenuHelper);
  } else {
    initMobileMenuHelper();
  }
  document.addEventListener('astro:after-swap', initMobileMenuHelper);
</script>
