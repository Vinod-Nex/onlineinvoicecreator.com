---
/**
 * BrazilianReceiptForm Component
 *
 * Ferramenta brasileira nativa para geração de recibos e faturas comerciais.
 * Suporta:
 * - Recibo de Pagamento (padrão)
 * - Recibo de Aluguel (com detalhamento de condomínio, IPTU e água)
 * - Recibo de Venda
 * - Fatura Comercial
 * - Valor por extenso automático em português do Brasil
 * - Máscaras e validação de CPF e CNPJ
 * - Geração de QR Code Pix estático (EMV BR Code)
 * - 4 layouts (Moderno, Clássico, Mínimo, Corporativo)
 * - Exportação instantânea em PDF A4 e PNG sem servidor e sem marca d'água
 */

interface Props {
  defaultType?: 'pagamento' | 'aluguel' | 'venda' | 'fatura';
}

const { defaultType = 'pagamento' } = Astro.props;
---

<div
  id="brazilian-receipt-root"
  data-default-type={defaultType}
  class="w-full max-w-[1560px] mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-8"
>
  <!-- Privacy & Serverless Guarantee Banner -->
  <aside
    class="mb-6 rounded-3xl bg-surface-card border border-hairline p-4 sm:p-5 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4 no-print"
    aria-label="Garantia de privacidade"
  >
    <div class="flex items-start sm:items-center gap-3.5">
      <div class="h-10 w-10 rounded-2xl bg-accent-teal/10 border border-accent-teal/20 flex items-center justify-center shrink-0 text-accent-teal">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <p class="text-xs sm:text-sm font-bold text-ink">
            100% Privado e no Navegador (Conformidade com a LGPD)
          </p>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-accent-teal/10 text-accent-teal border border-accent-teal/20">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-teal animate-pulse"></span>
            <span>Processamento Local</span>
          </span>
        </div>
        <p class="text-xs text-mute mt-0.5 leading-relaxed">
          Nenhum dado é enviado para servidores externos. Seus recibos, dados de clientes e valores ficam exclusivamente salvos no armazenamento local do seu navegador.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        id="btn-clear-br-data"
        class="h-9 px-3.5 text-xs font-semibold rounded-full text-accent-danger bg-accent-danger/10 hover:bg-accent-danger/20 border border-accent-danger/30 transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs"
        title="Apaga os dados salvos no navegador"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
        <span>Limpar meus dados</span>
      </button>
    </div>
  </aside>

  <!-- Legal & Tax Notice -->
  <!-- verificar: verificar com fonte oficial ou contador -->
  <div class="mb-6 rounded-2xl bg-amber-500/10 border border-amber-500/20 p-4 text-xs text-amber-900 dark:text-amber-200 no-print">
    <div class="flex items-start gap-2.5">
      <svg class="h-4 w-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <div class="space-y-1">
        <p class="font-bold">Aviso legal e tributário importante:</p>
        <p class="leading-relaxed">
          O recibo serve como comprovante de pagamento e quitação entre as partes. Este documento <strong>não substitui a Nota Fiscal (NF-e ou NFS-e)</strong>, cuja emissão é obrigatória para empresas e determinadas pessoas jurídicas conforme as normas da Receita Federal e legislações municipais/estaduais. Esta ferramenta gratuita não emite notas fiscais.
        </p>
        <!-- verificar: verificar com fonte oficial ou contador -->
        <p class="text-[11px] text-mute dark:text-amber-300/80 italic">
          Informação geral, não é orientação jurídica ou contábil. Consulte seu contador ou o portal do Sebrae para orientações específicas da sua atividade.
        </p>
      </div>
    </div>
  </div>

  <!-- Mobile Segmented View Toggle -->
  <div class="lg:hidden sticky top-18 z-30 mb-5 bg-surface-card/95 backdrop-blur-md p-1.5 rounded-2xl border border-hairline shadow-card flex items-center gap-1.5 no-print">
    <button
      type="button"
      id="btn-toggle-br-form"
      class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 bg-primary text-white shadow-2xs cursor-pointer"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
      </svg>
      <span>Editar Recibo</span>
    </button>
    <button
      type="button"
      id="btn-toggle-br-prev"
      class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 text-ink hover:bg-surface-soft cursor-pointer"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <span>Prévia do Documento</span>
    </button>
  </div>

  <!-- Main 2-Column Grid (Form on Left, Live Preview on Right) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- LEFT COLUMN: Interactive Form -->
    <div id="br-form-col" class="lg:col-span-6 space-y-6">
      
      <!-- Document Type Selection -->
      <section class="bg-surface-card border border-hairline rounded-2xl p-4 sm:p-5 shadow-xs space-y-3">
        <label class="block text-xs font-bold uppercase tracking-wider text-mute">
          Tipo de Documento
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <button
            type="button"
            class="btn-doc-type px-3 py-2 text-xs font-semibold rounded-xl border border-hairline text-center transition-all cursor-pointer {defaultType === 'pagamento' ? 'bg-primary text-white' : 'bg-surface-card text-ink hover:bg-surface-soft'}"
            data-type="pagamento"
          >
            Recibo de Pagamento
          </button>
          <button
            type="button"
            class="btn-doc-type px-3 py-2 text-xs font-semibold rounded-xl border border-hairline text-center transition-all cursor-pointer {defaultType === 'aluguel' ? 'bg-primary text-white' : 'bg-surface-card text-ink hover:bg-surface-soft'}"
            data-type="aluguel"
          >
            Recibo de Aluguel
          </button>
          <button
            type="button"
            class="btn-doc-type px-3 py-2 text-xs font-semibold rounded-xl border border-hairline text-center transition-all cursor-pointer {defaultType === 'venda' ? 'bg-primary text-white' : 'bg-surface-card text-ink hover:bg-surface-soft'}"
            data-type="venda"
          >
            Recibo de Venda
          </button>
          <button
            type="button"
            class="btn-doc-type px-3 py-2 text-xs font-semibold rounded-xl border border-hairline text-center transition-all cursor-pointer {defaultType === 'fatura' ? 'bg-primary text-white' : 'bg-surface-card text-ink hover:bg-surface-soft'}"
            data-type="fatura"
          >
            Fatura Comercial
          </button>
        </div>
      </section>

      <!-- Layout Style Selection -->
      <section class="bg-surface-card border border-hairline rounded-2xl p-4 sm:p-5 shadow-xs space-y-3">
        <label class="block text-xs font-bold uppercase tracking-wider text-mute">
          Estilo do Modelo (Layout)
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <button
            type="button"
            class="btn-doc-layout px-3 py-2 text-xs font-semibold rounded-xl border border-primary bg-primary/5 text-ink text-center transition-all cursor-pointer"
            data-layout="modern"
          >
            Moderno
          </button>
          <button
            type="button"
            class="btn-doc-layout px-3 py-2 text-xs font-semibold rounded-xl border border-hairline bg-surface-card hover:bg-surface-soft text-ink text-center transition-all cursor-pointer"
            data-layout="classic"
          >
            Clássico
          </button>
          <button
            type="button"
            class="btn-doc-layout px-3 py-2 text-xs font-semibold rounded-xl border border-hairline bg-surface-card hover:bg-surface-soft text-ink text-center transition-all cursor-pointer"
            data-layout="minimal"
          >
            Mínimo
          </button>
          <button
            type="button"
            class="btn-doc-layout px-3 py-2 text-xs font-semibold rounded-xl border border-hairline bg-surface-card hover:bg-surface-soft text-ink text-center transition-all cursor-pointer"
            data-layout="corporate"
          >
            Corporativo
          </button>
        </div>
      </section>

      <!-- Document Meta: Número, Data, Cidade -->
      <section class="bg-surface-card border border-hairline rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
        <h2 class="text-sm font-bold text-ink">Dados do Documento</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label for="br-receipt-number" class="block text-xs font-medium text-mute mb-1">
              Número do Recibo
            </label>
            <input
              type="text"
              id="br-receipt-number"
              class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </div>
          <div>
            <label for="br-receipt-date" class="block text-xs font-medium text-mute mb-1">
              Data de Emissão (dd/mm/aaaa)
            </label>
            <input
              type="text"
              id="br-receipt-date"
              class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </div>
          <div>
            <label for="br-receipt-city" class="block text-xs font-medium text-mute mb-1">
              Cidade e UF
            </label>
            <input
              type="text"
              id="br-receipt-city"
              placeholder="São Paulo - SP"
              class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </div>
        </div>
      </section>

      <!-- Emissor (Quem Recebe) -->
      <section class="bg-surface-card border border-hairline rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-ink">Quem Recebe (Emissor / Beneficiário)</h2>
          <span class="text-[11px] text-mute">Pessoa Física ou Jurídica</span>
        </div>
        <div class="space-y-3">
          <div>
            <label for="br-receiver-name" class="block text-xs font-medium text-mute mb-1">
              Nome Completo ou Razão Social
            </label>
            <input
              type="text"
              id="br-receiver-name"
              placeholder="Ex: João Pereira da Silva ou Silva & Filhos LTDA"
              class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <div class="flex items-center justify-between mb-1">
                <label for="br-receiver-doc" class="block text-xs font-medium text-mute">
                  CPF ou CNPJ
                </label>
                <div id="badge-receiver-doc"></div>
              </div>
              <input
                type="text"
                id="br-receiver-doc"
                placeholder="000.000.000-00 ou 00.000.000/0000-00"
                class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
              />
            </div>
            <div>
              <label for="br-receiver-phone" class="block text-xs font-medium text-mute mb-1">
                Telefone / Celular
              </label>
              <input
                type="text"
                id="br-receiver-phone"
                placeholder="(11) 98765-4321"
                class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
              />
            </div>
          </div>
          <div>
            <label for="br-receiver-address" class="block text-xs font-medium text-mute mb-1">
              Endereço Completo
            </label>
            <input
              type="text"
              id="br-receiver-address"
              placeholder="Rua, número, bairro, cidade - UF"
              class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </div>
        </div>
      </section>

      <!-- Pagador (Quem Paga) -->
      <section class="bg-surface-card border border-hairline rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-ink">Quem Pagou (Cliente / Pagador / Inquilino)</h2>
        </div>
        <div class="space-y-3">
          <div>
            <label for="br-payer-name" class="block text-xs font-medium text-mute mb-1">
              Nome do Pagador / Empresa
            </label>
            <input
              type="text"
              id="br-payer-name"
              placeholder="Ex: Maria Fernandes dos Santos"
              class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <div class="flex items-center justify-between mb-1">
                <label for="br-payer-doc" class="block text-xs font-medium text-mute">
                  CPF ou CNPJ do Pagador
                </label>
                <div id="badge-payer-doc"></div>
              </div>
              <input
                type="text"
                id="br-payer-doc"
                placeholder="000.000.000-00 ou 00.000.000/0000-00"
                class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
              />
            </div>
            <div>
              <label for="br-payer-address" class="block text-xs font-medium text-mute mb-1">
                Endereço do Pagador
              </label>
              <input
                type="text"
                id="br-payer-address"
                placeholder="Cidade, bairro ou endereço"
                class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Specialized Rent Fields (Shown when docType === 'aluguel') -->
      <section
        id="br-rent-fields"
        class="bg-surface-card border border-hairline rounded-2xl p-4 sm:p-5 shadow-xs space-y-4 {defaultType === 'aluguel' ? '' : 'hidden'}"
      >
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-ink">Especificações da Locação (Aluguel)</h2>
          <span class="text-[11px] text-accent-teal font-medium">Lei do Inquilinato</span>
        </div>
        <div class="space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="br-rent-property" class="block text-xs font-medium text-mute mb-1">
                Endereço Completo do Imóvel Alugado
              </label>
              <input
                type="text"
                id="br-rent-property"
                placeholder="Rua, número, apto, bairro, cidade"
                class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
              />
            </div>
            <div>
              <label for="br-rent-month" class="block text-xs font-medium text-mute mb-1">
                Mês de Referência (Período)
              </label>
              <input
                type="text"
                id="br-rent-month"
                placeholder="Ex: Janeiro / 2026"
                class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1">
            <div>
              <label for="br-rent-val" class="block text-[11px] font-medium text-mute mb-1">
                Aluguel (R$)
              </label>
              <input
                type="number"
                id="br-rent-val"
                step="0.01"
                class="w-full px-2.5 py-1.5 text-xs rounded-lg border border-hairline bg-surface text-ink"
              />
            </div>
            <div>
              <label for="br-rent-condo" class="block text-[11px] font-medium text-mute mb-1">
                Condomínio (R$)
              </label>
              <input
                type="number"
                id="br-rent-condo"
                step="0.01"
                class="w-full px-2.5 py-1.5 text-xs rounded-lg border border-hairline bg-surface text-ink"
              />
            </div>
            <div>
              <label for="br-rent-iptu" class="block text-[11px] font-medium text-mute mb-1">
                IPTU (R$)
              </label>
              <input
                type="number"
                id="br-rent-iptu"
                step="0.01"
                class="w-full px-2.5 py-1.5 text-xs rounded-lg border border-hairline bg-surface text-ink"
              />
            </div>
            <div>
              <label for="br-rent-water" class="block text-[11px] font-medium text-mute mb-1">
                Água/Outros (R$)
              </label>
              <input
                type="number"
                id="br-rent-water"
                step="0.01"
                class="w-full px-2.5 py-1.5 text-xs rounded-lg border border-hairline bg-surface text-ink"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Valores, Extenso, Descrição e Forma de Pagamento -->
      <section class="bg-surface-card border border-hairline rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
        <h2 class="text-sm font-bold text-ink">Valores e Descrição do Pagamento</h2>
        <div class="space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="br-amount" class="block text-xs font-medium text-mute mb-1">
                Valor Total (R$)
              </label>
              <div class="relative">
                <span class="absolute left-3 top-2.5 text-sm font-semibold text-mute">R$</span>
                <input
                  type="number"
                  id="br-amount"
                  step="0.01"
                  class="w-full pl-10 pr-3 py-2 text-sm font-bold rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
                />
              </div>
            </div>
            <div>
              <label for="br-payment-method" class="block text-xs font-medium text-mute mb-1">
                Forma de Pagamento
              </label>
              <select
                id="br-payment-method"
                class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
              >
                <option value="Pix">Pix (Instantâneo)</option>
                <option value="Dinheiro">Dinheiro em espécie</option>
                <option value="Transferência Bancária (TED/DOC)">Transferência Bancária</option>
                <option value="Boleto Bancário">Boleto Bancário</option>
                <option value="Cartão de Crédito">Cartão de Crédito</option>
                <option value="Cartão de Débito">Cartão de Débito</option>
              </select>
            </div>
          </div>

          <div>
            <label for="br-extenso" class="block text-xs font-medium text-mute mb-1">
              Valor por Extenso (Gerado Automaticamente em Português)
            </label>
            <input
              type="text"
              id="br-extenso"
              class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20 italic text-mute"
            />
          </div>

          <div>
            <label for="br-description" class="block text-xs font-medium text-mute mb-1">
              Referente a (Descrição detalhada do pagamento ou serviço)
            </label>
            <textarea
              id="br-description"
              rows="3"
              class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
            ></textarea>
          </div>
        </div>
      </section>

      <!-- Pix QR Code Integration -->
      <section class="bg-surface-card border border-hairline rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <input
              type="checkbox"
              id="br-pix-enabled"
              checked
              class="h-4 w-4 rounded border-hairline text-primary focus:ring-primary"
            />
            <label for="br-pix-enabled" class="text-sm font-bold text-ink cursor-pointer">
              Incluir QR Code Pix no Recibo
            </label>
          </div>
          <span class="text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">
            Padrão BR Code BCB
          </span>
        </div>

        <div id="br-pix-container" class="space-y-3 pt-2">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="br-pix-type" class="block text-xs font-medium text-mute mb-1">
                Tipo de Chave Pix
              </label>
              <select
                id="br-pix-type"
                class="w-full px-3 py-2 text-sm rounded-xl border border-hairline bg-surface text-ink focus:outline-none focus:ring-2 focus:ring-primary/20"
              >
                <option value="cpf">CPF</option>
                <option value="cnpj">CNPJ</option>
                <option value="phone">Celular (+55 DDD)</option>
                <option value="email">E-mail</option>
                <option value="evp">Chave Aleatória (EVP/UUID)</option>
              </select>
            </div>
            <div>
              <label for="br-pix-key" class="block text-xs font-medium text-mute mb-1">
                Chave Pix do Recebedor
              </label>
              <input
                type="text"
                id="br-pix-key"
                placeholder="Insira a chave Pix"
