---
/**
 * LanguageSwitcher Component
 *
 * Header language selector:
 * 1. Shows ONLY published locales.
 * 2. Links to the translated equivalent of the current page via routes.ts.
 * 3. Falls back to that locale's home if no equivalent exists.
 * 4. Remembers user's preference in localStorage inside try/catch.
 * 5. Conforms to DESIGN.md tokens & WCAG accessibility standards.
 */

import { getPublishedLocales, LOCALE_CONFIGS, type Locale, DEFAULT_LOCALE } from '../i18n/config';
import { getLocalizedEquivalentUrl } from '../i18n/routes';

interface Props {
  currentPath?: string;
  currentLocale?: Locale;
  compact?: boolean;
}

const {
  currentPath = Astro.url.pathname,
  currentLocale = DEFAULT_LOCALE,
  compact = false,
} = Astro.props;

const publishedLocales = getPublishedLocales();
const currentConfig = LOCALE_CONFIGS[currentLocale] || LOCALE_CONFIGS[DEFAULT_LOCALE];

const localeLinks = publishedLocales.map((loc) => {
  const config = LOCALE_CONFIGS[loc];
  return {
    code: loc,
    lang: config.lang,
    displayName: config.displayName,
    href: getLocalizedEquivalentUrl(currentPath, loc),
    isCurrent: loc === currentLocale,
  };
});
---

{publishedLocales.length > 1 ? (
  <div class="relative group/lang inline-block text-left" id="oic-lang-switcher">
    <!-- Desktop / Menu Button -->
    <button
      type="button"
      class={`inline-flex items-center gap-1 sm:gap-1.5 px-2 py-1 sm:px-2.5 sm:py-1.5 text-xs font-semibold text-ink rounded-full border border-hairline bg-surface-card hover:bg-surface-soft hover:text-primary transition-colors cursor-pointer group-focus-within/lang:border-primary shadow-2xs ${compact ? 'px-1.5 py-1' : ''}`}
      aria-haspopup="true"
      aria-expanded="false"
      aria-label={`Select language. Current: ${currentConfig.displayName}`}
      id={compact ? 'mobile-lang-switcher-btn' : 'lang-switcher-btn'}
    >
      <svg
        class="h-3.5 w-3.5 text-mute shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      {compact ? (
        <span class="uppercase text-[11px] font-bold tracking-wider">{currentConfig.code === 'pt-br' ? 'PT' : currentConfig.code.toUpperCase()}</span>
      ) : (
        <span class="truncate max-w-[90px]">{currentConfig.displayName}</span>
      )}
      <svg
        class="h-3 w-3 text-mute transition-transform duration-150 group-hover/lang:rotate-180 group-focus-within/lang:rotate-180 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <!-- Dropdown Menu -->
    <div
      class="invisible opacity-0 group-hover/lang:visible group-hover/lang:opacity-100 group-focus-within/lang:visible group-focus-within/lang:opacity-100 transition-all duration-150 absolute right-0 top-full mt-1.5 w-48 rounded-2xl border border-hairline bg-surface-card p-1.5 shadow-elevated z-50 focus:outline-none"
      role="menu"
      aria-orientation="vertical"
      aria-labelledby="lang-switcher-btn"
    >
      <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-mute border-b border-hairline/60 mb-1">
        Language / Idioma
      </div>
      <div class="space-y-0.5">
        {localeLinks.map((item) => (
          <a
            href={item.href}
            class={`lang-choice-link flex items-center justify-between px-2.5 py-1.5 text-xs font-semibold rounded-xl transition-colors ${
              item.isCurrent
                ? 'bg-primary/10 text-primary'
                : 'text-ink hover:bg-surface-soft hover:text-primary dark:hover:bg-surface-elevated'
            }`}
            data-locale={item.code}
            role="menuitem"
            hreflang={item.lang}
          >
            <span>{item.displayName}</span>
            {item.isCurrent && (
              <span class="text-primary font-bold">✓</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
) : (
  <span class="hidden" data-single-published-locale={currentConfig.code}></span>
)}

<script>
  function setupLanguageSwitcher() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.lang-choice-link');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        const locale = link.getAttribute('data-locale');
        if (locale) {
          try {
            localStorage.setItem('oic_preferred_locale', locale);
          } catch {
            // localStorage unavailable or blocked
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLanguageSwitcher);
  } else {
    setupLanguageSwitcher();
  }
  document.addEventListener('astro:after-swap', setupLanguageSwitcher);
</script>

