---
/**
 * AffiliatePartners Component
 *
 * Implements clearly labelled, contextual affiliate placeholders for accounting software:
 * 1. Prominent Disclosure: Explicit FTC-compliant sponsorship badges and disclosure statement
 * 2. Context-Aware Recommendations: Selects relevant tools (FreshBooks, QuickBooks, Xero, Landlord software)
 * 3. Strict Link Attributes: rel="noopener sponsored" on all outbound affiliate links
 * 4. Zero Tool Obstruction: In-flow placement below generator canvas, never covering download buttons
 */

interface Props {
  context?: 'general' | 'freelance' | 'contractor' | 'australia' | 'excel' | 'landlord';
  class?: string;
}

const { context = 'general', class: className = '' } = Astro.props;

interface Partner {
  name: string;
  badge: string;
  tagline: string;
  description: string;
  highlights: string[];
  ctaLabel: string;
  ctaHref: string;
  highlighted?: boolean;
}

const partnersByContext: Record<string, Partner[]> = {
