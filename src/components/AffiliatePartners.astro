      ],
      ctaLabel: 'Explore QuickBooks (50% Off)',
      ctaHref: 'https://quickbooks.intuit.com/',
      highlighted: true,
    },
    {
      name: 'FreshBooks',
      badge: 'Best for Solo Contractors',
      tagline: 'Effortless client billing and time tracking.',
      description:
        'Simple double-entry bookkeeping that turns work hours and expenses into client invoices in seconds.',
      highlights: [
        'Automatic late payment reminders',
        'Client review and approval portal',
        'Zero accounting jargon',
      ],
      ctaLabel: 'Try FreshBooks Free for 30 Days',
      ctaHref: 'https://www.freshbooks.com/',
    },
  ],
  freelance: [
    {
      name: 'FreshBooks',
      badge: 'Top Pick for Freelancers',
      tagline: 'Made for solo freelancers, creatives, and digital consultants.',
      description:
        'Track client billable hours, automate recurring retainers, and log expenses effortlessly.',
      highlights: [
        'Multi-currency client billing',
        'Automatic expense categorization',
        'Client portal with instant card payments',
      ],
      ctaLabel: 'Start Free 30-Day Trial',
      ctaHref: 'https://www.freshbooks.com/',
      highlighted: true,
    },
    {
      name: 'QuickBooks Solopreneur',
      badge: 'Best for Tax Deductions',
      tagline: 'Separate business and personal expenses with ease.',
      description:
