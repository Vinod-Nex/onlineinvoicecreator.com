        'Automatic bank feeds (CBA, ANZ, NAB, Westpac)',
        'One-click GST & BAS preparation',
        'Superannuation & Single Touch Payroll',
      ],
      ctaLabel: 'Try Xero Free for 30 Days',
      ctaHref: 'https://www.xero.com/au/',
      highlighted: true,
    },
    {
      name: 'QuickBooks Online',
      badge: 'Best for Contractors & Mileage',
      tagline: 'Automated expense tracking and contractor 1099/ABN management.',
      description:
        'Track income, capture receipts on mobile, and claim business deductions automatically.',
      highlights: [
        'Automated GPS mileage tracking',
        'Custom professional estimates & quotes',
        'Live accountant collaboration',
      ],
      ctaLabel: 'Save 50% for 3 Months',
      ctaHref: 'https://quickbooks.intuit.com/au/',
    },
  ],
  contractor: [
    {
      name: 'QuickBooks Online',
      badge: 'Best for Trade Contractors',
      tagline: 'Track project costs, mileage, and sub-contractor 1099s.',
      description:
        'Built for independent trade contractors, builders, and field technicians needing mobile expense capture.',
      highlights: [
