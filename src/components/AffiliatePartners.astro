const activePartners = partnersByContext[context] || partnersByContext.general;
---

<section
  class={`affiliate-partners-container my-12 rounded-3xl border border-hairline/80 bg-surface-card p-6 sm:p-8 lg:p-10 shadow-card transition-all no-print ${className}`}
  aria-labelledby="affiliate-partners-heading"
>
  <!-- Sponsorship Disclosure Header -->
  <div class="space-y-2 border-b border-hairline/60 pb-6 text-center sm:text-left">
    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wider uppercase bg-primary/10 text-primary">
        Sponsored Recommendations
      </span>
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase tracking-wider bg-surface-soft text-mute border border-hairline">
        Affiliate Partners
      </span>
    </div>

    <h2
      id="affiliate-partners-heading"
      class="text-xl sm:text-2xl font-bold text-ink font-display tracking-tight"
    >
      Need Automated Bookkeeping & Tax Compliance?
    </h2>

    <p class="text-xs sm:text-sm text-mute max-w-3xl leading-relaxed">
      If your business has outgrown manual PDF invoicing and needs automated bank reconciliation,
      double-entry bookkeeping, or tax filing, we recommend these industry-certified accounting
      platforms.
    </p>

    <!-- Clear FTC Disclosure -->
    <p class="text-[11px] text-mute/80 italic pt-1">
      <strong>Transparency Disclosure:</strong> When you purchase or sign up for accounting software
      through the links below, we may earn an affiliate commission at no extra cost to you. We only
      recommend platforms that satisfy professional accounting and security standards.
    </p>
  </div>

  <!-- Partner Cards Grid -->
  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
    {activePartners.map((partner) => (
      <div
        class={`flex flex-col justify-between rounded-2xl border p-6 transition-all ${
          partner.highlighted
            ? 'border-primary/40 bg-surface-soft/40 shadow-xs'
            : 'border-hairline bg-surface-card hover:border-hairline/80'
        }`}
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-bold text-ink">{partner.name}</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-primary/10 text-primary">
              {partner.badge}
            </span>
          </div>

          <p class="text-sm font-semibold text-ink leading-snug">{partner.tagline}</p>

          <p class="text-xs text-mute leading-relaxed">{partner.description}</p>

          <ul class="space-y-1.5 pt-2 border-t border-hairline/40">
            {partner.highlights.map((item) => (
              <li class="flex items-center gap-2 text-xs text-ink/90">
                <svg
                  class="h-3.5 w-3.5 text-accent-teal shrink-0"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-hairline/60">
          <a
            href={partner.ctaHref}
            target="_blank"
            rel="noopener sponsored"
            class={`inline-flex items-center justify-center w-full px-4 py-2.5 rounded-xl text-xs font-semibold transition-all shadow-xs gap-1.5 ${
              partner.highlighted
                ? 'bg-primary hover:bg-primary-deep text-white'
                : 'bg-surface-soft hover:bg-surface border border-hairline text-ink'
            }`}
          >
            <span>{partner.ctaLabel}</span>
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
