---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }];

const privacySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy - Online Invoice Creator',
  description:
    'Privacy Policy for Online Invoice Creator: 100% in-browser processing, zero server uploads, what localStorage holds, analytics, and cookie policy.',
  url: 'https://onlineinvoicecreator.com/privacy',
};
---

<BaseLayout
  title="Privacy Policy | Online Invoice Creator"
  description="Read our plain-English privacy policy: 100% in-browser document processing, zero server uploads, what localStorage stores, and cookie usage."
  canonical="https://onlineinvoicecreator.com/privacy"
  schema={privacySchema}
>
  <!-- Breadcrumb Navigation -->
  <div class="border-b border-hairline/60 bg-surface-soft/40 no-print">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12">
    <!-- Header -->
    <header class="space-y-4 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent-teal/10 border border-accent-teal/20 text-xs font-semibold text-accent-teal">
        <span class="flex h-2 w-2 rounded-full bg-accent-teal"></span>
        <span>Local-First Architecture</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-display leading-[1.1]">
        Privacy Policy
      </h1>
      <p class="text-sm sm:text-base text-mute">
        Last updated: October 2026 &bull; Effective immediately
      </p>
      <p class="text-base sm:text-lg text-mute max-w-2xl leading-relaxed">
        We believe your financial records belong to you alone. This policy plainly explains how
        Online Invoice Creator processes data, what your browser stores locally, and how analytics
        and cookies operate.
      </p>
    </header>

    <!-- Key Principle: Processing Happens in the Browser -->
    <section
      class="p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-card space-y-4"
      aria-labelledby="in-browser-heading"
    >
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-2xl bg-accent-teal/10 text-accent-teal flex items-center justify-center font-bold text-lg">
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div>
          <h2 id="in-browser-heading" class="text-lg sm:text-xl font-bold text-ink">
            1. All Document Processing Happens in Your Browser
          </h2>
          <span class="text-xs font-semibold text-accent-teal">
            Zero Server Uploads &bull; Zero Cloud Storage
          </span>
        </div>
      </div>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        Online Invoice Creator is engineered as a client-side web application. When you create an
        invoice, receipt, or rent receipt, all calculations, line-item arithmetic, logo image
        scaling, and vector PDF generations execute{' '}
        <strong class="text-ink">strictly inside your web browser</strong> using JavaScript.
      </p>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        <strong class="text-ink">Nothing is uploaded to our servers.</strong> We do not operate a
        remote database that receives, stores, or processes your client names, billing rates,
        banking details, tax identifiers, or itemized invoices. When you click "Download PDF" or
        "Export PNG", the file is generated directly in your browser's local memory and saved
        directly to your computer or phone.
      </p>
    </section>

    <!-- Section 2: What LocalStorage Holds -->
    <section class="space-y-4" aria-labelledby="localstorage-heading">
      <h2 id="localstorage-heading" class="text-xl sm:text-2xl font-bold text-ink font-display">
        2. What LocalStorage Holds and How You Control It
      </h2>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        To prevent you from having to re-type your business details on every visit, Online Invoice
        Creator uses your browser's built-in{' '}
        <code class="px-1.5 py-0.5 rounded bg-surface-soft text-charcoal font-mono text-xs">
          localStorage
        </code>{' '}
        facility. This storage is completely private to your specific browser on your specific
        device.
      </p>

      <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-4">
        <h3 class="font-bold text-ink text-sm sm:text-base">
          Data saved in your local storage includes:
        </h3>
        <ul class="text-xs sm:text-sm text-mute space-y-2 list-disc list-inside">
          <li>
            <strong class="text-ink">Business Details:</strong> Your trading name, email, phone
            number, address, and tax registration number.
          </li>
          <li>
            <strong class="text-ink">Client Details:</strong> The most recent client name, billing
            address, and contact email.
          </li>
          <li>
            <strong class="text-ink">Active Draft:</strong> The current invoice or receipt number,
            dates, line items, rates, taxes, discounts, and payment terms.
          </li>
          <li>
            <strong class="text-ink">Logo Image:</strong> A client-side base64 image representation
            of your uploaded brand logo, stored locally so it re-appears on reload.
          </li>
          <li>
            <strong class="text-ink">Preferences:</strong> Your selected currency (e.g., USD, EUR,
            AUD, INR), page format (A4 or US Letter), and visual template choice (Classic, Modern,
            Minimal, Compact).
          </li>
        </ul>

        <div class="pt-3 border-t border-hairline space-y-2">
          <h4 class="font-bold text-ink text-xs uppercase tracking-wider">
            How to clear your stored data:
          </h4>
          <p class="text-xs text-mute leading-relaxed">
            You maintain complete control. Every generator tool features a prominent{' '}
            <strong class="text-accent-danger">"Clear my data"</strong> button that instantly wipes
            your stored drafts from localStorage. Alternatively, you can clear site data and cookies
            directly in your browser settings at any time.
          </p>
          <p class="text-xs text-mute leading-relaxed">
            If your browser disables localStorage (for example, in strict private browsing modes),
            our application gracefully falls back to transient in-memory storage, ensuring the tool
            continues to function smoothly without throwing errors.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: What Analytics and Ads Collect -->
    <section class="space-y-4" aria-labelledby="analytics-heading">
      <h2 id="analytics-heading" class="text-xl sm:text-2xl font-bold text-ink font-display">
        3. What Analytics and Advertising Collect
      </h2>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        To maintain website availability, measure performance, and keep our tools free without
        subscription paywalls, we use privacy-respecting analytics and third-party advertising
        partners:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="p-5 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <h3 class="font-bold text-ink text-sm sm:text-base">Website Analytics</h3>
          <p class="text-xs text-mute leading-relaxed">
            We collect aggregated, non-personally identifiable traffic statistics, including page
            views, visit timestamps, referral URLs, approximate geographic country/region, and
            device/browser user agent.
          </p>
          <p class="text-xs text-primary font-medium">
            Analytics scripts NEVER record, inspect, or log your invoice amounts, line items, client
            identities, or business numbers.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <h3 class="font-bold text-ink text-sm sm:text-base">Third-Party Advertising</h3>
          <p class="text-xs text-mute leading-relaxed">
            We partner with programmatic advertising networks to fund ongoing development and
            serverless hosting costs. Ad partners may collect non-personal identifiers, IP
            addresses, and interaction metrics to serve relevant, non-intrusive ads.
          </p>
          <p class="text-xs text-mute leading-relaxed">
            You can opt out of personalized interest-based advertising via the{' '}
            <a
              href="https://optout.aboutads.info"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary underline"
            >
              Digital Advertising Alliance
            </a>{' '}
            or{' '}
            <a
              href="https://youronlinechoices.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary underline"
            >
              Your Online Choices
            </a>
            .
          </p>
        </div>
      </div>
    </section>

    <!-- Section 4: Cookie Usage -->
    <section class="space-y-4" aria-labelledby="cookies-heading">
      <h2 id="cookies-heading" class="text-xl sm:text-2xl font-bold text-ink font-display">
        4. Cookie Usage
      </h2>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        Cookies are small text files placed on your device by your web browser. We categorize
        cookies used on Online Invoice Creator into three types:
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border border-hairline rounded-2xl bg-surface-card">
          <thead>
            <tr class="border-b border-hairline text-mute uppercase font-semibold tracking-wider bg-surface-soft/60">
              <th class="py-3 px-4">Cookie Category</th>
              <th class="py-3 px-4">Purpose</th>
              <th class="py-3 px-4">Duration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline/60">
            <tr>
              <td class="py-3 px-4 font-bold text-ink">Essential / Functional</td>
              <td class="py-3 px-4 text-mute">
                Stores your interface theme preference (Dark or Light mode) and facilitates
                localStorage draft recovery.
              </td>
              <td class="py-3 px-4 text-charcoal">Persistent (Local)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-ink">Performance & Metrics</td>
              <td class="py-3 px-4 text-mute">
                Measures Core Web Vitals, page load speeds, and aggregated visitor flows to detect
                outages and bugs.
              </td>
              <td class="py-3 px-4 text-charcoal">Up to 12 months</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-ink">Advertising & Monetization</td>
              <td class="py-3 px-4 text-mute">
                Enables ad networks to prevent impression fraud, cap ad frequency, and measure
                programmatic ad delivery.
              </td>
              <td class="py-3 px-4 text-charcoal">Session to 13 months</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-mute leading-relaxed">
        You can configure your browser to reject all cookies or notify you when a cookie is set.
        Disabling cookies will not impair your ability to create, download, or print invoices on
        this website.
      </p>
    </section>

    <!-- Section 5: User Rights & Data Ownership -->
    <section
      class="space-y-4 p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-xs"
      aria-labelledby="rights-heading"
    >
      <h2 id="rights-heading" class="text-xl sm:text-2xl font-bold text-ink font-display">
        5. Your Data Ownership & Rights (GDPR & CCPA)
      </h2>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        Under regulations such as GDPR and CCPA, you have the right to access, rectify, or delete
        your personal data. Because Online Invoice Creator operates on a 100% serverless,
        zero-knowledge architecture,{' '}
        <strong class="text-ink">we do not possess your financial records on our servers</strong>.
      </p>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        There is no cloud database containing your invoices for us to query, modify, or hand over to
        third parties. You have total sovereign ownership of your financial records directly on your
        local device.
      </p>
    </section>

    <!-- Contact & Institutional Links -->
    <section class="space-y-4 pt-4 border-t border-hairline text-xs text-mute">
      <h2 class="text-base font-bold text-ink font-display">
        Questions About This Privacy Policy?
      </h2>
      <p class="leading-relaxed">
        If you have questions regarding this policy or our local-first privacy practices, please
        contact us via our{' '}
        <a href="/contact" class="text-primary font-semibold underline">
          Contact Form
        </a>{' '}
        or email us directly at{' '}
        <a
          href="mailto:support@onlineinvoicecreator.com"
          class="text-primary font-semibold underline"
        >
          support@onlineinvoicecreator.com
        </a>
        .
      </p>
      <div class="pt-4 flex flex-wrap gap-4 text-xs font-semibold text-ink">
        <a href="/terms" class="hover:text-primary transition-colors">
          Terms of Service &rarr;
        </a>
        <a href="/about" class="hover:text-primary transition-colors">
          About Online Invoice Creator &rarr;
        </a>
        <a href="/" class="hover:text-primary transition-colors">
          Free Invoice Generator &rarr;
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
