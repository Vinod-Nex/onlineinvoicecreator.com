---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildPageSchemaGraph } from '../lib/schema';
import { BLOG_ARTICLES } from '../data/blog-articles';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Blog & Guides' }];

const blogFaqs = [
  {
    question: 'How do I choose between issuing an invoice or a payment receipt?',
    answer:
      'You should issue an invoice before receiving payment to formally request client funds, and issue a receipt immediately after receiving payment as official proof. Invoices outline payment terms, due dates, and bank transfer details, whereas receipts confirm payment method and transaction completion.',
  },
  {
    question: 'What are the essential elements required on a commercial invoice?',
    answer:
      'Every commercial invoice must include a prominent Invoice header, unique sequential invoice number, issue date, payment due date, seller and buyer details, itemized goods or services, and total amount. Including accurate tax identification numbers prevents processing delays with corporate accounts payable departments.',
  },
  {
    question: 'Can freelancers bill hourly rates and project milestones together?',
    answer:
      'Yes, freelancers can easily combine hourly labor charges and fixed-price project milestones on a single commercial invoice. Simply list billable hours with their respective rates on one line, and add milestone deliverables or software licenses as separate line items for clear client billing.',
  },
  {
    question: 'How do Australian tax invoices differ from standard international invoices?',
    answer:
      'Australian tax invoices must prominently display the words Tax Invoice, the seller Australian Business Number, and an explicit Goods and Services Tax calculation. Documents exceeding one thousand dollars must also clearly specify the buyer name, address, or ABN for tax credits.',
  },
  {
    question: 'Do I need paid accounting software to generate compliant business invoices?',
    answer:
      'No, you do not need expensive monthly accounting software to generate professional, legally compliant invoices for your business. Free browser-based tools produce clean, watermark-free PDF invoices with automatic totals, local privacy protection, and complete tax breakdown without any ongoing subscription costs or software downloads.',
  },
];

const fullArticles = BLOG_ARTICLES.filter((a) => a.isFull);
const allOutlines = BLOG_ARTICLES;

const blogSchema = {
  '@type': 'CollectionPage',
  name: 'Invoicing & Small Business Billing Guides',
  description:
    'Free invoicing guides, billing tutorials, and tax checklists for freelancers and contractors.',
  url: 'https://onlineinvoicecreator.com/blog',
};

const pageSchema = buildPageSchemaGraph({
  canonicalUrl: 'https://onlineinvoicecreator.com/blog',
  title: 'Invoicing Guides & Billing Tips | Online Invoice Creator',
  description:
    'Free invoicing guides, billing tutorials, and tax checklists for freelancers and contractors. Learn how to bill clients cleanly and get paid faster.',
  breadcrumbs: breadcrumbItems,
  faqItems: blogFaqs,
  customSchemas: [blogSchema],
});
---

<BaseLayout
  title="Invoicing Guides & Billing Tips | Online Invoice Creator"
  description="Free invoicing guides, billing tutorials, and tax checklists for freelancers and contractors. Learn how to bill clients cleanly and get paid faster."
  canonical="https://onlineinvoicecreator.com/blog"
  ogImage="/og/og-blog.png"
  ogImageAlt="Invoicing and Billing Guides - Online Invoice Creator"
  schema={pageSchema}
>
  <!-- Breadcrumb Navigation -->
  <div class="border-b border-hairline/60 bg-surface-soft/40 no-print">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
    <!-- Header -->
    <header class="space-y-4 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-soft border border-hairline text-xs font-semibold text-charcoal">
        <span class="flex h-2 w-2 rounded-full bg-primary animate-pulse"></span>
        <span>Knowledge Hub & Invoicing Guides</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-display leading-[1.1]">
        Invoicing Guides & <span class="text-primary">Billing Tips</span>
      </h1>
      <p class="text-base sm:text-lg text-mute max-w-3xl leading-relaxed">
        Practical billing advice, statutory tax guides, and payment workflows for solo freelancers,
        trade contractors, and small business owners worldwide. Each guide includes worked examples,
        calculations, and direct links to our free generator tools.
      </p>

      <!-- Primary Action CTAs -->
      <div class="pt-4 flex flex-wrap items-center gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-deep text-white font-semibold text-sm transition-all shadow-xs"
        >
          <span>Create Free Invoice Now</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href="/free-online-receipt-generator"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-surface-card hover:bg-surface-soft border border-hairline text-ink font-semibold text-sm transition-all shadow-xs"
        >
          <span>Generate Payment Receipt</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </header>

    <!-- Featured Deep-Dive Guides (Full Articles) -->
    <section class="space-y-6" aria-labelledby="featured-guides-heading">
      <div class="text-center sm:text-left">
        <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary">
          <span>In-Depth Tutorials</span>
        </div>
        <h2
          id="featured-guides-heading"
          class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
        >
          Featured Full Invoicing Guides
        </h2>
        <p class="text-sm text-mute mt-1.5">
          Comprehensive step-by-step documentation with real worked calculations, downloadable
          sample payloads, and audit compliance advice.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {fullArticles.map((article) => (
          <article class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-4 flex flex-col justify-between hover:border-primary/50 transition-all">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs">
                <span class="font-semibold text-primary px-2.5 py-0.5 rounded-full bg-primary/10">
                  {article.category}
                </span>
                <span class="text-mute">{article.readTime}</span>
              </div>
              <h3 class="text-xl font-bold text-ink font-display leading-snug">
                <a href={`/blog/${article.slug}`} class="hover:text-primary transition-colors">
                  {article.title}
                </a>
              </h3>
              <p class="text-sm text-mute leading-relaxed">{article.description}</p>

              <!-- Differentiator Badge -->
              <div class="p-3 rounded-xl bg-surface-soft border border-hairline/60 text-xs text-charcoal flex items-start gap-2">
                <span class="text-emerald-500 font-bold">&check;</span>
                <div>
                  <strong class="text-ink">{article.differentiator.label}:</strong>
                  <span class="text-mute block mt-0.5">{article.differentiator.description}</span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-hairline/60 flex items-center justify-between">
              <a
                href={`/blog/${article.slug}`}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary-deep"
              >
                <span>Read Complete Guide</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a
                href={article.tool.href}
                class="text-xs text-mute hover:text-ink transition-colors underline"
              >
                {article.tool.name}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 12 Informational Article Outlines Curriculum -->
    <section class="space-y-8 pt-8 border-t border-hairline" aria-labelledby="curriculum-heading">
      <div class="text-center sm:text-left space-y-2">
        <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary">
          <span>Complete Editorial Index</span>
        </div>
        <h2
          id="curriculum-heading"
          class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
        >
          12 Core Informational Invoicing Topics & Outlines
        </h2>
        <p class="text-sm text-mute max-w-3xl">
          Derived directly from high-intent commercial keyword research. Each outline provides the
          exact heading architecture, core takeaways, and unique practical value lacking in generic
          internet articles.
        </p>
      </div>

      <div class="space-y-6">
        {allOutlines.map((item, idx) => (
          <div
            id={item.slug}
            class="p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-6"
          >
            <!-- Card Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline/60 pb-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2 text-xs">
                  <span class="font-bold text-primary font-mono">#{idx + 1}</span>
                  <span class="text-mute">&bull;</span>
                  <span class="font-semibold text-charcoal">{item.category}</span>
                  <span class="text-mute">&bull;</span>
                  <span class="text-mute font-mono">Target Keyword: "{item.primaryKeyword}"</span>
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-ink font-display">
                  {item.isFull ? (
                    <a href={`/blog/${item.slug}`} class="hover:text-primary transition-colors">
                      {item.title}
                    </a>
                  ) : (
                    <span>{item.title}</span>
                  )}
                </h3>
              </div>

              <!-- Tool CTA Badge -->
              <div class="shrink-0">
                <a
                  href={item.tool.href}
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-surface-soft hover:bg-primary/10 border border-hairline text-primary font-semibold text-xs transition-all"
                >
                  <span>{item.tool.ctaLabel}</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>

            <!-- Value Differentiator Box -->
            <div class="p-4 rounded-2xl bg-surface-soft/60 border border-hairline text-sm space-y-1">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                ★ Unique Practical Element (Non-Generic Value)
              </span>
              <p class="text-ink font-semibold">{item.differentiator.label}</p>
              <p class="text-xs text-mute leading-relaxed">{item.differentiator.description}</p>
            </div>

            <!-- Outline Tree -->
            <div class="space-y-3">
              <h4 class="text-xs font-bold uppercase tracking-wider text-charcoal">
                Structured Article Outline (H2 / H3 Blueprint)
              </h4>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                {item.outline.map((sec) => (
                  <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline/50 space-y-2 text-xs">
                    <p class="font-bold text-ink">{sec.heading}</p>
                    <ul class="text-mute space-y-1 list-disc list-inside">
                      {sec.subheadings.map((sub) => (
                        <li class="line-clamp-1">{sub}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>

            <!-- Read Link for Full Articles -->
            {item.isFull && (
              <div class="pt-2 flex items-center justify-end">
                <a
                  href={`/blog/${item.slug}`}
                  class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:text-primary-deep"
                >
                  <span>Read Full Article with Interactive Tools & Downloadable Assets</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="space-y-6 pt-8 border-t border-hairline" aria-labelledby="faq-heading">
      <div class="text-center sm:text-left space-y-1">
        <h2
          id="faq-heading"
          class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
        >
          Frequently Asked Questions
        </h2>
        <p class="text-sm text-mute">
          Direct, practical answers to common invoicing, receipt creation, and tax accounting
          questions.
        </p>
      </div>

      <div class="space-y-4">
        {blogFaqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2">
            <h3 class="text-base font-semibold text-ink font-display">{faq.question}</h3>
            <p class="text-sm text-mute leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
