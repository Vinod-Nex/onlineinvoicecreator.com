---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildPageSchemaGraph } from '../lib/schema';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Blog & Guides' }];

const blogFaqs = [
  {
    question: 'How do I choose between issuing an invoice or a payment receipt?',
    answer:
      'You should issue an invoice before receiving payment to formally request client funds, and issue a receipt immediately after receiving payment as official proof. Invoices outline payment terms, due dates, and bank transfer details, whereas receipts confirm payment method and transaction completion.',
  },
  {
    question: 'What are the essential elements required on a commercial invoice?',
    answer:
      'Every commercial invoice must include a prominent Invoice header, unique sequential invoice number, issue date, payment due date, seller and buyer details, itemized goods or services, and total amount. Including accurate tax identification numbers prevents processing delays with corporate accounts payable departments.',
  },
  {
    question: 'Can freelancers bill hourly rates and project milestones together?',
    answer:
      'Yes, freelancers can easily combine hourly labor charges and fixed-price project milestones on a single commercial invoice. Simply list billable hours with their respective rates on one line, and add milestone deliverables or software licenses as separate line items for clear client billing.',
  },
  {
    question: 'How do Australian tax invoices differ from standard international invoices?',
    answer:
      'Australian tax invoices must prominently display the words Tax Invoice, the seller Australian Business Number, and an explicit Goods and Services Tax calculation. Documents exceeding one thousand dollars must also clearly specify the buyer name, address, or ABN for tax credits.',
  },
  {
    question: 'Do I need paid accounting software to generate compliant business invoices?',
    answer:
      'No, you do not need expensive monthly accounting software to generate professional, legally compliant invoices for your business. Free browser-based tools produce clean, watermark-free PDF invoices with automatic totals, local privacy protection, and complete tax breakdown without any ongoing subscription costs or software downloads.',
  },
];

const guides = [
  {
    category: 'Freelancing',
    title: 'How to Invoice as a Freelancer: Rates, Terms, and Getting Paid',
    description:
      'A complete guide to calculating hourly rates, setting 14-day payment terms, and avoiding late client payments.',
    toolTitle: 'Use Freelancer Invoice Generator',
    toolHref: '/invoice-generator-for-freelancers',
    readTime: '6 min read',
  },
  {
    category: 'Trades & Construction',
    title: 'Contractor Invoicing Guide: Materials, Labor, and Milestone Billing',
    description:
      'Learn how trade contractors structure billing for raw supplies, subcontractor labor, and staged project completion.',
    toolTitle: 'Use Contractor Invoice Template',
    toolHref: '/contractor-invoice-template',
    readTime: '5 min read',
  },
  {
    category: 'Tax & Compliance',
    title: 'Australian GST Invoicing Rules: ATO Compliance Checklist',
    description:
      'Everything sole traders and Australian companies need to know about ABN display, 10% GST breakdown, and tax records.',
    toolTitle: 'Use Australia Tax Invoice Template',
    toolHref: '/tax-invoice-template-australia',
    readTime: '7 min read',
  },
  {
    category: 'Creative Industry',
    title: 'Photography Billing Essentials: Session Fees & Image Licensing',
    description:
      'How commercial and portrait photographers separate creative day rates, usage licenses, and print deliverables.',
    toolTitle: 'Use Photography Invoice Generator',
    toolHref: '/photography-invoice-generator',
    readTime: '5 min read',
  },
  {
    category: 'Real Estate & Tenancy',
    title: 'Rent Receipts for Landlords and Tenants: HRA Tax Proof Guide',
    description:
      'How to issue valid monthly rent payment receipts, landlord PAN requirements, and employee tax deduction documentation.',
    toolTitle: 'Use Free Rent Receipt Generator',
    toolHref: '/free-rent-receipt-generator',
    readTime: '4 min read',
  },
  {
    category: 'Retail & POS',
    title: 'Itemized Receipts vs Simple Payment Slips: When to Detail Line Items',
    description:
      'Understand when retail sales, material sales, and client reimbursements require line-by-line itemized proof of payment.',
    toolTitle: 'Use Itemized Receipt Maker',
    toolHref: '/receipt-maker-with-items',
    readTime: '4 min read',
  },
  {
    category: 'Workflow & Tools',
    title: 'Why Browser-Based Invoicing Outperforms Spreadsheet Templates',
    description:
      'Discover why local-first web generators prevent broken spreadsheet formulas and protect confidential client data.',
    toolTitle: 'Explore Excel Invoice Alternative',
    toolHref: '/invoice-generator-excel',
    readTime: '5 min read',
  },
  {
    category: 'Bookkeeping Fundamentals',
    title: 'The Core Difference Between Invoices and Payment Receipts',
    description:
      'Clarify billing terminology: understand the transition from payment request to payment receipt in double-entry bookkeeping.',
    toolTitle: 'Use Free Receipt Generator',
    toolHref: '/free-online-receipt-generator',
    readTime: '4 min read',
  },
];

const blogSchema = {
  '@type': 'CollectionPage',
  name: 'Invoicing & Small Business Billing Guides',
  description:
    'Free invoicing guides, billing tutorials, and tax checklists for freelancers and contractors.',
  url: 'https://onlineinvoicecreator.com/blog',
};

const pageSchema = buildPageSchemaGraph({
  canonicalUrl: 'https://onlineinvoicecreator.com/blog',
  title: 'Invoicing Guides & Billing Tips | Online Invoice Creator',
  description:
    'Free invoicing guides, billing tutorials, and tax checklists for freelancers and contractors. Learn how to bill clients cleanly and get paid faster.',
  breadcrumbs: breadcrumbItems,
  faqItems: blogFaqs,
  customSchemas: [blogSchema],
});
---

<BaseLayout
  title="Invoicing Guides & Billing Tips | Online Invoice Creator"
  description="Free invoicing guides, billing tutorials, and tax checklists for freelancers and contractors. Learn how to bill clients cleanly and get paid faster."
  canonical="https://onlineinvoicecreator.com/blog"
  schema={pageSchema}
>
  <!-- Breadcrumb Navigation -->
  <div class="border-b border-hairline/60 bg-surface-soft/40 no-print">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
    <!-- Header -->
    <header class="space-y-4 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-soft border border-hairline text-xs font-semibold text-charcoal">
        <span class="flex h-2 w-2 rounded-full bg-primary animate-pulse"></span>
        <span>Knowledge Hub & Resources</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-display leading-[1.1]">
        Invoicing Guides & <span class="text-primary">Billing Tips</span>
      </h1>
      <p class="text-base sm:text-lg text-mute max-w-3xl leading-relaxed">
        Practical billing advice, statutory tax guides, and payment workflows for solo freelancers,
        trade contractors, and small business owners worldwide.
      </p>

      <!-- Primary Action CTAs -->
      <div class="pt-4 flex flex-wrap items-center gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-deep text-white font-semibold text-sm transition-all shadow-xs"
        >
          <span>Create Free Invoice Now</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href="/free-online-receipt-generator"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-surface-card hover:bg-surface-soft border border-hairline text-ink font-semibold text-sm transition-all shadow-xs"
        >
          <span>Generate Payment Receipt</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </header>

    <!-- Guides Grid -->
    <section class="space-y-6" aria-labelledby="guides-grid-heading">
      <div class="text-center sm:text-left">
        <h2 id="guides-grid-heading" class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight">
          Featured Invoicing & Billing Articles
        </h2>
        <p class="text-sm text-mute mt-1.5">
          Step-by-step documentation to help you create compliant invoices and collect client payments faster.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {guides.map((guide) => (
          <article class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-4 flex flex-col justify-between hover:border-primary/50 transition-all">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs">
                <span class="font-semibold text-primary px-2.5 py-0.5 rounded-full bg-primary/10">
                  {guide.category}
                </span>
                <span class="text-mute">{guide.readTime}</span>
              </div>
              <h3 class="font-bold text-ink text-lg leading-snug">
                {guide.title}
              </h3>
              <p class="text-xs sm:text-sm text-mute leading-relaxed">
                {guide.description}
              </p>
            </div>

            <div class="pt-3 border-t border-hairline/60">
              <a
                href={guide.toolHref}
                class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-primary hover:text-primary-bright transition-colors"
              >
                <span>{guide.toolTitle}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Fast Document Generators Block -->
    <section class="space-y-6 pt-6 border-t border-hairline" aria-labelledby="tools-directory-heading">
      <div class="text-center sm:text-left">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-teal/10 text-accent-teal mb-2">
          Tools Directory
        </span>
        <h2 id="tools-directory-heading" class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight">
          Free Invoicing & Receipt Generators
        </h2>
        <p class="text-sm text-mute mt-1.5">
          Jump directly to our free, browser-based document creators with zero signup and instant PDF download.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/" class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block">
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-surface-soft text-charcoal">Core Tool</span>
          <h3 class="font-bold text-ink text-base mt-2">Free Online Invoice Generator</h3>
          <p class="text-xs text-mute mt-1">Create professional invoices with instant PDF export and zero watermarks.</p>
        </a>
        <a href="/free-online-receipt-generator" class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block">
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-surface-soft text-charcoal">Core Tool</span>
          <h3 class="font-bold text-ink text-base mt-2">Free Online Receipt Generator</h3>
          <p class="text-xs text-mute mt-1">Generate official proof of payment and payment receipts in seconds.</p>
        </a>
        <a href="/invoice-generator-for-freelancers" class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block">
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-surface-soft text-charcoal">Freelancers</span>
          <h3 class="font-bold text-ink text-base mt-2">Freelancer Invoice Generator</h3>
          <p class="text-xs text-mute mt-1">Hourly rate and project retainer billing for digital professionals.</p>
        </a>
        <a href="/contractor-invoice-template" class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block">
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-surface-soft text-charcoal">Trades</span>
          <h3 class="font-bold text-ink text-base mt-2">Contractor Invoice Template</h3>
          <p class="text-xs text-mute mt-1">Labor, materials, and staged construction milestone billing.</p>
        </a>
        <a href="/tax-invoice-template-australia" class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block">
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-surface-soft text-charcoal">Australia</span>
          <h3 class="font-bold text-ink text-base mt-2">Australia Tax Invoice Template</h3>
          <p class="text-xs text-mute mt-1">ATO-compliant 10% GST breakdown and ABN registration fields.</p>
        </a>
        <a href="/free-rent-receipt-generator" class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block">
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-surface-soft text-charcoal">Tenancy</span>
          <h3 class="font-bold text-ink text-base mt-2">Free Rent Receipt Generator</h3>
          <p class="text-xs text-mute mt-1">Monthly rent proofs for landlords and tenants with PAN support.</p>
        </a>
      </div>
    </section>

    <!-- Frequently Asked Questions (FAQ) Section -->
    <section class="space-y-6 pt-6 border-t border-hairline" aria-labelledby="blog-faq-heading">
      <div class="text-center sm:text-left">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary mb-2">
          Billing FAQs
        </span>
        <h2 id="blog-faq-heading" class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight">
          Frequently Asked Questions About Billing & Invoicing
        </h2>
        <p class="text-sm text-mute mt-1.5">
          Answers to common small business billing, receipting, and compliance questions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
        {blogFaqs.map((faq) => (
          <article class="p-5 sm:p-6 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2.5">
            <h3 class="font-bold text-ink text-base sm:text-lg leading-snug">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-mute leading-relaxed">
              {faq.answer}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- Institutional Cross-Links Banner -->
    <footer class="p-6 rounded-3xl bg-surface-soft border border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-accent-teal shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"
          />
        </svg>
        <span>Looking for privacy guarantees or legal terms?</span>
      </div>
      <div class="flex items-center gap-4 font-semibold text-ink">
        <a href="/about" class="hover:text-primary transition-colors">
          About Us
        </a>
        <span>&bull;</span>
        <a href="/privacy" class="hover:text-primary transition-colors">
          Privacy Policy
        </a>
        <span>&bull;</span>
        <a href="/terms" class="hover:text-primary transition-colors">
          Terms of Service
        </a>
        <span>&bull;</span>
        <a href="/contact" class="hover:text-primary transition-colors">
          Contact Support
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>
