---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InvoiceForm from '../../components/InvoiceForm.astro';
import { getRouteUrl } from '../../i18n/routes';
import { buildPageSchemaGraph } from '../../lib/schema';

const title = 'Gerador de Recibo e Fatura Grátis Online';
const description = "Crie recibos online grátis e baixe o PDF. Sem cadastro, sem marca d'água. Seus dados ficam no seu navegador.";
const canonical = 'https://onlineinvoicecreator.com/pt-br';
const locale = 'pt-br';

const breadcrumbs = [
  { label: 'Início', href: getRouteUrl('home', locale) },
];

const tools = [
  {
    title: 'Fatura Comercial para Cobrança',
    badge: 'Gerador Ativo',
    badgeColor: 'bg-purple-500/10 text-purple-600 border-purple-500/20',
    description: 'Documento comercial completo para discriminar produtos ou serviços, prazos e condições de pagamento entre partes. Preencha e baixe seu PDF diretamente no gerador.',
    href: '#invoice-workspace',
    buttonText: 'Usar Gerador de Fatura',
    icon: 'M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z',
    features: ['Discriminação de itens e valores em R$', 'Cálculo automático de descontos e taxas', 'Exportação em PDF A4 sem marca d\'água', 'Totalmente no navegador'],
  },
  {
    title: 'Gerador de Recibo de Pagamento',
    badge: 'Mais Utilizado',
    badgeColor: 'bg-emerald-500/10 text-emerald-600 border-emerald-500/20',
    description: 'Emita recibos de pagamento simples e completos para serviços, autônomos, MEI ou comércio com valor por extenso automático.',
    href: getRouteUrl('receipt', locale),
    buttonText: 'Abrir Gerador de Recibo',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    features: ['Valor por extenso em R$', 'QR Code Pix integrado', 'Validação de CPF e CNPJ', 'Exportação em PDF A4'],
  },
  {
    title: 'Recibo de Aluguel Grátis',
    badge: 'Locação Residencial & Comercial',
    badgeColor: 'bg-primary/10 text-primary border-primary/20',
    description: 'Comprovante mensal de locação de imóveis com cálculo automático de aluguel, condomínio, IPTU e taxa de água conforme a Lei do Inquilinato.',
    href: getRouteUrl('rent-receipt', locale),
    buttonText: 'Gerar Recibo de Aluguel',
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
    features: ['Discriminação de IPTU e condomínio', 'Mês de referência', 'Dados do locador e locatário', 'Sem necessidade de cadastro'],
  },
  {
    title: 'Modelo de Recibo Pronto',
    badge: 'Exemplo Preenchido',
    badgeColor: 'bg-amber-500/10 text-amber-600 border-amber-500/20',
    description: 'Confira um modelo pronto e formatado para preenchimento rápido. Entenda todos os campos obrigatórios e baixe o modelo em branco ou preenchido.',
    href: getRouteUrl('receipt-template', locale),
    buttonText: 'Ver Modelo Pronto',
    icon: 'M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2',
    features: ['Campos legais obrigatórios', 'Exemplo visual completo', 'Download imediato', 'Ideal para autônomos'],
  },
];

const pageSchema = buildPageSchemaGraph({
  canonicalUrl: canonical,
  title,
  description,
  isHomePage: true,
  isToolPage: true,
  breadcrumbs,
  inLanguage: 'pt-BR',
  webAppOptions: {
    name: 'Gerador de Fatura e Recibo Online',
    description: 'Gerador de fatura comercial e recibo de pagamento online grátis com exportação para PDF e sem cadastro.',
    applicationCategory: 'BusinessApplication',
    features: [
      'Emissão de fatura comercial com itens detalhados',
      'Cálculo de subtotal, descontos, taxas e frete',
      'Download em PDF A4 sem marca d\'água',
      'Suporte a pagamentos via Pix e dados bancários',
      'Armazenamento local privado no navegador (LGPD)',
    ],
  },
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  schema={pageSchema}
  ogImage="/og/og-pt-br-index.png"
  ogImageAlt="Gerador de Recibo e Fatura Grátis Online"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10 sm:space-y-14">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Section -->
    <section class="text-center max-w-3xl mx-auto space-y-5">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 shadow-2xs">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>100% Grátis · Sem Cadastro · No Seu Navegador</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-display leading-tight">
        Gerador de Recibo e Fatura Grátis Online
      </h1>

      <p class="text-base sm:text-lg text-mute leading-relaxed">
        Crie faturas comerciais e recibos de pagamento profissionais em instantes. Com discriminação de itens, cálculo automático de impostos, suporte a Pix e exportação em PDF A4 sem marca d'água.
      </p>

      <div class="pt-3 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#invoice-workspace"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-sm shadow-sm transition-all active:scale-98"
        >
          <span>Criar Fatura Agora</span>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href={getRouteUrl('receipt', locale)}
          class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-surface-card border border-hairline hover:bg-surface-soft text-ink font-semibold text-sm transition-colors"
        >
          <span>Gerador de Recibo</span>
        </a>
        <a
          href={getRouteUrl('rent-receipt', locale)}
          class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-surface-card border border-hairline hover:bg-surface-soft text-ink font-semibold text-sm transition-colors"
        >
          <span>Recibo de Aluguel</span>
        </a>
      </div>
    </section>

    <!-- Legal Notice -->
    <div class="rounded-2xl bg-amber-500/10 border border-amber-500/20 p-5 text-xs text-amber-900 dark:text-amber-200">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div class="space-y-1">
          <p class="font-bold">Aviso legal e tributário:</p>
          <p class="leading-relaxed">
            A fatura comercial e o recibo de pagamento comprovam acordos, prestação de serviços e quitações financeiras entre as partes. Este documento <strong>não substitui a Nota Fiscal (NF-e ou NFS-e)</strong>, documento oficial regulamentado pela Receita Federal e secretarias de fazenda municipais. Nossa plataforma gratuita não emite notas fiscais eletrônicas.
          </p>
          <p class="text-[11px] text-mute dark:text-amber-300/80 italic">
            Informação geral informativa, não constitui assessoria contábil ou jurídica.
          </p>
        </div>
      </div>
    </div>

    <!-- Interactive Invoice Generator Workspace -->
    <main class="w-full bg-canvas -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
      <InvoiceForm locale={locale} />
    </main>

    <!-- Tools Grid -->
    <section class="space-y-6 pt-6">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink font-display">
          Escolha o Modelo Ideal para a Sua Necessidade
        </h2>
        <p class="text-sm text-mute">
          Todas as ferramentas rodam 100% no seu navegador. Seus dados financeiros permanecem privados e seguros.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        {tools.map((t) => (
          <div class="rounded-3xl border border-hairline bg-surface-card p-6 sm:p-8 shadow-xs hover:shadow-card transition-all flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-3">
                <div class="h-12 w-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d={t.icon} stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border ${t.badgeColor}`}>
                  {t.badge}
                </span>
              </div>

              <div>
                <h3 class="text-xl font-bold text-ink">
                  {t.title}
                </h3>
                <p class="text-sm text-mute mt-2 leading-relaxed">
                  {t.description}
                </p>
              </div>

              <ul class="space-y-2 pt-2 border-t border-hairline text-xs text-mute">
                {t.features.map((feat) => (
                  <li class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={t.href}
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-surface hover:bg-surface-soft border border-hairline text-ink font-semibold text-xs transition-colors"
            >
              <span>{t.buttonText}</span>
              <svg class="h-3.5 w-3.5 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Value Propositions & Trust -->
    <section class="rounded-3xl border border-hairline bg-surface-card p-6 sm:p-10 shadow-xs space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold text-ink font-display">
          Por que Usar Nosso Gerador de Faturas e Recibos?
        </h2>
        <p class="text-sm text-mute">
          Desenvolvido com foco na realidade dos profissionais e empresas brasileiras.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center sm:text-left">
        <div class="space-y-2">
          <div class="h-10 w-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center mx-auto sm:mx-0">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-ink">Privacidade LGPD Total</h3>
          <p class="text-xs text-mute leading-relaxed">
            Seus dados financeiros não passam por servidores nem são compartilhados com terceiros. Tudo é processado no seu navegador.
          </p>
        </div>

        <div class="space-y-2">
          <div class="h-10 w-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mx-auto sm:mx-0">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <rect x="7" y="7" width="3" height="3" />
              <rect x="14" y="7" width="3" height="3" />
              <rect x="7" y="14" width="3" height="3" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-ink">QR Code Pix no Padrão BCB</h3>
          <p class="text-xs text-mute leading-relaxed">
            Gere o payload EMV Pix válido com chave, valor e recebedor diretamente no documento para agilizar pagamentos instantâneos.
          </p>
        </div>

        <div class="space-y-2">
          <div class="h-10 w-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mx-auto sm:mx-0">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-ink">Valor por Extenso em Português</h3>
          <p class="text-xs text-mute leading-relaxed">
            Ao digitar o número, o valor por extenso é preenchido de forma imediata e correta, prevenindo rasuras e divergências no documento.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
