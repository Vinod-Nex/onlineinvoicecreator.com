---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BrazilianReceiptForm from '../../components/BrazilianReceiptForm.astro';
import { getRouteUrl } from '../../i18n/routes';
import { buildPageSchemaGraph } from '../../lib/schema';

const title = 'Modelo de Recibo Grátis – Preencha e Baixe PDF';
const description = 'Use um modelo de recibo pronto: preencha online, confira a prévia e baixe em PDF. Grátis, sem cadastro e sem marca d\'água.';
const canonical = 'https://onlineinvoicecreator.com/pt-br/modelo-de-recibo';
const locale = 'pt-br';

const breadcrumbs = [
  { label: 'Início', href: getRouteUrl('home', locale) },
  { label: 'Modelo de Recibo', href: getRouteUrl('receipt-template', locale) },
];

const templateFaqItems = [
  {
    question: 'Posso usar este modelo de recibo para qualquer serviço?',
    answer: 'Sim, o modelo de recibo atende a qualquer prestação de serviço, venda pontual entre particulares, locação ou quitação de pagamentos. Você pode preencher os campos com a descrição exata da sua transação e gerar um comprovante formal em formato PDF.',
  },
  {
    question: 'Como baixar o modelo de recibo em branco?',
    answer: 'Para emitir um modelo de recibo em branco para preenchimento manual posterior, basta clicar no botão "Limpar meus dados" acima, deixar os campos de valores e descrição vazios e clicar diretamente em "Baixar PDF" ou "Imprimir".',
  },
  {
    question: 'É necessário imprimir o recibo para ele ter validade?',
    answer: 'Não necessariamente. O recibo pode ser assinado eletronicamente ou enviado digitalmente em PDF por e-mail ou WhatsApp, desde que as partes reconheçam a autenticidade da assinatura digital e da manifestação de vontade, conforme a legislação civil brasileira.',
  },
];

const pageSchema = buildPageSchemaGraph({
  canonicalUrl: canonical,
  title,
  description,
  isHomePage: false,
  isToolPage: false,
  breadcrumbs,
  faqItems: templateFaqItems,
  inLanguage: 'pt-BR',
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  schema={pageSchema}
  ogImage="/og/og-pt-br-modelo-de-recibo.png"
  ogImageAlt="Modelo de Recibo Grátis – Preencha e Baixe PDF"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Page Header (H1) -->
    <header class="text-center max-w-3xl mx-auto space-y-3 pt-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 border border-amber-500/20">
        <span class="flex h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>Modelo Pronto e Formatado para Preenchimento</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-display">
        Modelo de Recibo Grátis
      </h1>

      <p class="text-sm sm:text-base text-mute leading-relaxed">
        Utilize nosso modelo de recibo pronto para preencher seus dados online ou baixar em branco para impressão. Totalmente gratuito, sem necessidade de cadastro e formatado para impressão em folha A4.
      </p>
    </header>

    <!-- Interactive Form Pre-filled as a Template Sample -->
    <BrazilianReceiptForm defaultType="pagamento" />

    <!-- Content on Receipt Template Guidelines (500 - 800 Words) -->
    <article class="max-w-4xl mx-auto space-y-10 pt-12 pb-16 border-t border-hairline text-ink">
      
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight font-display">
          Como usar um modelo de recibo pronto
        </h2>
        <p class="text-sm sm:text-base text-mute leading-relaxed">
          Ter um modelo de recibo estruturado evita esquecimentos de dados cruciais e assegura que o comprovante tenha validade jurídica em eventuais contestações cíveis ou fiscais. Nossa ferramenta oferece duas opções convenientes de utilização:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
          <div class="rounded-2xl border border-hairline bg-surface-card p-5 space-y-2">
            <h3 class="text-base font-bold text-ink">Opção 1: Preencher Online e Baixar</h3>
            <p class="text-xs text-mute leading-relaxed">
              Basta editar os dados no formulário interativo acima. Conforme você digita o valor, o sistema calcula o valor por extenso em reais e atualiza a prévia visual instantaneamente. Ao terminar, clique em "Baixar PDF" para obter um documento pronto para assinatura e envio por e-mail ou WhatsApp.
            </p>
          </div>

          <div class="rounded-2xl border border-hairline bg-surface-card p-5 space-y-2">
            <h3 class="text-base font-bold text-ink">Opção 2: Imprimir Modelo em Branco</h3>
            <p class="text-xs text-mute leading-relaxed">
              Caso precise de talões para preenchimento manual em visitas presenciais ou obras, apague os dados do formulário e clique em "Imprimir". Você terá um modelo em branco limpo, com linhas para identificação, valor por extenso e assinatura manual.
            </p>
          </div>
        </div>
      </section>

      <!-- Checklist of Required Fields -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight font-display">
          Campos essenciais em qualquer modelo de recibo
        </h2>
        <p class="text-sm sm:text-base text-mute leading-relaxed">
          Um modelo completo deve seguir uma ordem lógica de informações para facilitar a conferência e o arquivamento por departamentos contábeis ou pelas partes envolvidas:
        </p>

        <div class="rounded-2xl border border-hairline bg-surface-card p-5 space-y-3 text-xs text-mute leading-relaxed">
          <div class="flex items-start gap-2">
            <span class="font-bold text-ink min-w-[140px]">1. Cabeçalho e Número:</span>
            <span>Identifica o tipo de documento e o código sequencial de controle (ex: REC-2026-001).</span>
          </div>
          <div class="flex items-start gap-2 border-t border-hairline pt-2">
            <span class="font-bold text-ink min-w-[140px]">2. Identificação das Partes:</span>
            <span>Quem recebe (beneficiário) e quem pagou, acompanhados de CPF ou CNPJ válidos.</span>
          </div>
          <div class="flex items-start gap-2 border-t border-hairline pt-2">
            <span class="font-bold text-ink min-w-[140px]">3. Valor Numérico e Extenso:</span>
            <span>O total em reais e sua grafia em palavras (ex: R$ 850,00 - oitocentos e cinquenta reais).</span>
          </div>
          <div class="flex items-start gap-2 border-t border-hairline pt-2">
            <span class="font-bold text-ink min-w-[140px]">4. Referência do Pagamento:</span>
            <span>Descrição objetiva do trabalho realizado, honorários, venda de produto ou período locatício.</span>
          </div>
          <div class="flex items-start gap-2 border-t border-hairline pt-2">
            <span class="font-bold text-ink min-w-[140px]">5. Data, Local e Assinatura:</span>
            <span>Município, estado, data de emissão e assinatura com nome legível do recebedor.</span>
          </div>
        </div>
      </section>

      <!-- Legal and Regulatory Notice -->
      <!-- verificar: verificar com fonte oficial ou contador -->
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-ink">
          Validade e Recomendações Contábeis
        </h2>
        <p class="text-xs sm:text-sm text-mute leading-relaxed">
          O recibo emitido a partir deste modelo comprova a quitação de débitos perante o Código Civil. No entanto, lembre-se de que ele <strong>não substitui a Nota Fiscal (NF-e ou NFS-e)</strong> quando houver obrigatoriedade legal de emissão por pessoas jurídicas junto às esferas tributárias.
        </p>
        <!-- verificar: verificar com fonte oficial ou contador -->
        <p class="text-xs text-mute italic bg-surface-soft p-3 rounded-xl border border-hairline">
          Informação geral, não é orientação jurídica ou contábil. Consulte seu contador para adequação às normas fiscais do seu município e estado.
        </p>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-4 pt-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight font-display">
          Perguntas Frequentes sobre Modelos de Recibo
        </h2>
        <div class="space-y-3">
          {templateFaqItems.map((item) => (
            <details class="group rounded-2xl border border-hairline bg-surface-card p-4 sm:p-5 transition-all">
              <summary class="flex items-center justify-between cursor-pointer font-bold text-sm sm:text-base text-ink select-none">
                <span>{item.question}</span>
                <svg class="h-4 w-4 text-mute transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="mt-3 text-xs sm:text-sm text-mute leading-relaxed pt-2 border-t border-hairline">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- Internal Navigation -->
      <section class="rounded-3xl border border-hairline bg-surface-soft/60 p-6 sm:p-8 space-y-4">
        <h2 class="text-xl font-bold text-ink">Acesse Nossas Outras Ferramentas Gratuitas</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <a href={getRouteUrl('receipt', locale)} class="p-3 rounded-xl bg-surface-card border border-hairline hover:border-primary transition-colors flex items-center justify-between text-ink font-semibold">
            <span>Gerador de Recibo de Pagamento (Pilar)</span>
            <span class="text-primary">→</span>
          </a>
          <a href={getRouteUrl('rent-receipt', locale)} class="p-3 rounded-xl bg-surface-card border border-hairline hover:border-primary transition-colors flex items-center justify-between text-ink font-semibold">
            <span>Recibo de Aluguel com IPTU e Condomínio</span>
            <span class="text-primary">→</span>
          </a>
        </div>
      </section>

    </article>
  </div>
</BaseLayout>

