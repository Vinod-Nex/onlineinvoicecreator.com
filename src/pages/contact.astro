---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildPageSchemaGraph } from '../lib/schema';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Contact' }];

const contactSchema = {
  '@type': 'ContactPage',
  name: 'Contact Support - Online Invoice Creator',
  description:
    'Contact the Online Invoice Creator team for support, feature feedback, partnership inquiries, and bug reports.',
  url: 'https://onlineinvoicecreator.com/contact',
};

const contactFaqs = [
  {
    question: 'How do I report a calculation issue or software bug?',
    answer:
      'You can report a calculation issue or software bug directly using our contact form or by emailing our technical support team. Please describe the calculation discrepancy, the currency or tax settings you used, and your device browser type. Our engineering team investigates and resolves calculation and layout reports promptly.',
  },
  {
    question: 'How can I submit invoice tool feedback or suggest new features?',
    answer:
      'We welcome user invoice tool feedback and template suggestions through our contact message form. Let us know what regional tax templates, payment methods, or currency formats would improve your business workflow. We actively prioritize user requests in our continuous product update roadmap to better support small businesses.',
  },
  {
    question: 'Do you offer phone or live chat customer support?',
    answer:
      'No, we do not currently offer phone or live chat support because Online Invoice Creator is a free, serverless utility. All customer support, feature suggestions, and bug inquiries are handled efficiently via email and our contact form. We aim to reply to all business inquiries within one business day.',
  },
  {
    question: 'How does Cloudflare Turnstile protect the contact form?',
    answer:
      'Cloudflare Turnstile provides privacy-preserving spam protection on our contact form without forcing users to solve frustrating image puzzles. It verifies human interaction cryptographically in the background without collecting invasive personal tracking data or cookies, keeping our support channels open and spam-free for genuine users.',
  },
  {
    question: 'Is my message kept private when I submit the contact form?',
    answer:
      'Yes, your contact submission is transmitted securely over HTTPS directly to our private Cloudflare Worker API. We use your provided name, email address, and message content solely to investigate your inquiry and reply to your feedback. We never sell, share, or monetize contact communications with third-party advertisers.',
  },
];

const pageSchema = buildPageSchemaGraph({
  canonicalUrl: 'https://onlineinvoicecreator.com/contact',
  title: 'Contact Support & Feedback | Online Invoice Creator',
  description:
    'Contact the Online Invoice Creator team. Send feedback, suggest templates, report bugs, or reach us directly via email.',
  breadcrumbs: breadcrumbItems,
  faqItems: contactFaqs,
  customSchemas: [contactSchema],
});
---

<BaseLayout
  title="Contact Support & Feedback | Online Invoice Creator"
  description="Contact the Online Invoice Creator team. Send feedback, suggest templates, report bugs, or reach us directly via email."
  canonical="https://onlineinvoicecreator.com/contact"
  ogImage="/og/og-contact.png"
  ogImageAlt="Contact Online Invoice Creator Support and Feedback"
  schema={pageSchema}
>
  <!-- Breadcrumb Navigation -->
  <div class="border-b border-hairline/60 bg-surface-soft/40 no-print">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12">
    <!-- Header -->
    <header class="space-y-4 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-xs font-semibold text-primary">
        <span class="flex h-2 w-2 rounded-full bg-primary"></span>
        <span>Support & Feedback</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-display leading-[1.1]">
        Contact Online Invoice Creator & <span class="text-primary">Support</span>
      </h1>
      <p class="text-base sm:text-lg text-mute max-w-3xl leading-relaxed">
        You can contact the Online Invoice Creator team directly for technical support, new template
        requests, bug reports, and partnership inquiries via our web form or direct email at
        support@onlineinvoicecreator.com. We read and respond to all user inquiries within one
        business day, providing dedicated assistance for freelancers, contractors, and businesses
        worldwide.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Interactive Contact Form -->
      <div class="lg:col-span-7">
        <div class="p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-card space-y-6">
          <h2 class="text-xl sm:text-2xl font-bold text-ink font-display">
            Invoice Generator Support & Template Feedback
          </h2>
          <form id="contact-form" action="/api/contact" method="POST" class="space-y-4" novalidate>
            <!-- Honeypot anti-spam field (hidden from genuine users) -->
            <div class="hidden" aria-hidden="true">
              <label for="contact-hp">Leave this field empty</label>
              <input type="text" id="contact-hp" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Name Field -->
            <div class="space-y-1.5">
              <label for="contact-name" class="block text-xs font-bold text-ink">
                Your Name <span class="text-accent-danger">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full h-11 px-3.5 rounded-xl bg-canvas border border-hairline text-ink text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-hidden"
              />
            </div>

            <!-- Email Field -->
            <div class="space-y-1.5">
              <label for="contact-email" class="block text-xs font-bold text-ink">
                Email Address <span class="text-accent-danger">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="jane@example.com"
                class="w-full h-11 px-3.5 rounded-xl bg-canvas border border-hairline text-ink text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-hidden"
              />
            </div>

            <!-- Subject Field -->
            <div class="space-y-1.5">
              <label for="contact-subject" class="block text-xs font-bold text-ink">
                Subject <span class="text-accent-danger">*</span>
              </label>
              <select
                id="contact-subject"
                name="subject"
                required
                class="w-full h-11 px-3.5 rounded-xl bg-canvas border border-hairline text-ink text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-hidden"
              >
                <option value="General Feedback">General Feedback & Ideas</option>
                <option value="Template Request">Request a New Template or Region</option>
                <option value="Bug Report">Report a Bug or Calculation Issue</option>
                <option value="Privacy Inquiry">Privacy & Data Question</option>
                <option value="Partnership">Commercial Partnership Inquiry</option>
              </select>
            </div>

            <!-- Message Field -->
            <div class="space-y-1.5">
              <label for="contact-message" class="block text-xs font-bold text-ink">
                Message <span class="text-accent-danger">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder="Write your message here..."
                class="w-full p-3.5 rounded-xl bg-canvas border border-hairline text-ink text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-hidden leading-relaxed resize-y"
              ></textarea>
            </div>

            <!-- Cloudflare Turnstile Spam Protection Widget Container -->
            <div class="space-y-1">
              <div
                class="cf-turnstile"
                id="cf-turnstile-container"
                data-sitekey="1x00000000000000000000AA"
                data-theme="auto"
              ></div>
              <p class="text-[11px] text-mute">
                Protected by Cloudflare Turnstile against automated spam.
              </p>
            </div>

            <!-- Submission Status Alerts -->
            <div
              id="contact-alert-success"
              class="hidden p-4 sm:p-5 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 dark:text-emerald-200 text-xs sm:text-sm space-y-3"
            >
              <div class="flex items-start gap-2.5">
                <svg
                  class="h-5 w-5 shrink-0 text-emerald-600 mt-0.5"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"
                  />
                </svg>
                <div>
                  <p class="font-bold text-sm text-ink">Redirecting to Email / Gmail Compose...</p>
                  <p class="text-xs text-mute mt-0.5 leading-relaxed">
                    Your message draft has been prepared for <strong class="text-ink">support@onlineinvoicecreator.com</strong>.
                    If your email window did not open automatically, click below:
                  </p>
                </div>
              </div>

              <div class="flex flex-wrap items-center gap-2 pt-1">
                <a
                  id="btn-alert-open-gmail"
                  href="https://mail.google.com/mail/?view=cm&fs=1&to=support@onlineinvoicecreator.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-white font-semibold text-xs hover:bg-primary-hover shadow-xs transition-all cursor-pointer"
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                  </svg>
                  <span>Open in Gmail (Google Email) &rarr;</span>
                </a>
                <a
                  id="btn-mailto-fallback"
                  href="mailto:support@onlineinvoicecreator.com"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-surface-card hover:bg-surface-elevated border border-hairline font-semibold text-xs text-ink transition-all"
                >
                  <span>Open in Mail App</span>
                </a>
                <button
                  type="button"
                  id="btn-alert-copy-message"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-surface-card hover:bg-surface-elevated border border-hairline font-semibold text-xs text-mute hover:text-ink transition-all cursor-pointer"
                >
                  <span id="btn-alert-copy-text">Copy Draft</span>
                </button>
              </div>
            </div>

            <div
              id="contact-alert-error"
              class="hidden p-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-700 dark:text-red-300 text-xs space-y-2"
            >
              <p class="font-bold" id="contact-error-message">
                Please fill in all required fields (Name, Email, Message).
              </p>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="btn-submit-contact"
              class="w-full h-12 rounded-full bg-primary text-white font-semibold text-sm hover:bg-primary-hover active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-xs disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <span id="btn-submit-text">Send Message</span>
              <svg id="btn-submit-icon" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
              </svg>
            </button>
          </form>
        </div>
      </div>

      <!-- Right Column: Direct Mailto & Help Info -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Direct Email Card -->
        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-4">
          <div class="h-10 w-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-bold">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-ink">Prefer to Email Directly?</h2>
            <p class="text-xs sm:text-sm text-mute leading-relaxed mt-1">
              If you prefer not using the contact form or have an email attachment to send, write
              directly to our support desk:
            </p>
          </div>
          <div class="space-y-2 pt-1">
            <!-- Direct Google Mail (Gmail Web) Compose Link -->
            <a
              id="btn-direct-gmail"
              href="https://mail.google.com/mail/?view=cm&fs=1&to=support@onlineinvoicecreator.com&su=Support%20Inquiry%20-%20Online%20Invoice%20Creator"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-between gap-3 px-4 py-3 rounded-2xl bg-primary text-white hover:bg-primary-hover font-semibold text-sm transition-all shadow-xs group cursor-pointer"
            >
              <div class="flex items-center gap-2.5 min-w-0">
                <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
                <span class="truncate">support@onlineinvoicecreator.com</span>
              </div>
              <span class="text-xs font-normal opacity-90 shrink-0 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                Open in Gmail &rarr;
              </span>
            </a>

            <!-- Fallback Actions: 1-Click Copy and Default Mail App -->
            <div class="flex items-center gap-2 pt-0.5">
              <button
                type="button"
                id="btn-copy-support-email"
                class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-surface-soft hover:bg-surface-soft/80 border border-hairline text-xs font-medium text-ink transition-all cursor-pointer"
                title="Copy email address to clipboard"
              >
                <svg class="h-3.5 w-3.5 text-mute" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M8 2a1 1 0 000 2h2a1 1 0 100-2H8z" />
                  <path d="M3 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v6h-4.586l1.293-1.293a1 1 0 00-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L10.586 13H15v3a2 2 0 01-2 2H5a2 2 0 01-2-2V5z" />
                </svg>
                <span id="btn-copy-email-text">Copy Email</span>
              </button>

              <a
                id="btn-direct-mailto"
                href="mailto:support@onlineinvoicecreator.com"
                class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-surface-soft hover:bg-surface-soft/80 border border-hairline text-xs font-medium text-mute hover:text-ink transition-all"
                title="Open in your default mail app"
              >
                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                </svg>
                <span>Mail App</span>
              </a>
            </div>
          </div>
          <p class="text-[11px] text-mute pt-1">
            We typically respond within 24–48 business hours.
          </p>
        </div>

        <!-- Privacy & Local Data Note -->
        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <h3 class="text-sm font-bold text-ink flex items-center gap-1.5">
            <svg class="h-4 w-4 text-accent-teal" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"
              />
            </svg>
            <span>Confidentiality Guarantee</span>
          </h3>
          <p class="text-xs text-mute leading-relaxed">
            Your contact details are used solely to reply to your inquiry. We never share or sell
            contact details to marketing lists or third parties. Read our{' '}
            <a href="/privacy" class="text-primary underline">
              Privacy Policy
            </a>
            .
          </p>
        </div>

        <!-- Quick Links -->
        <div class="p-6 rounded-3xl bg-surface-soft border border-hairline space-y-2 text-xs">
          <h3 class="text-sm font-bold text-ink">Need a Document Immediately?</h3>
          <ul class="space-y-1.5 text-mute">
            <li>
              &bull;{' '}
              <a href="/" class="text-primary hover:underline">
                Create a Free Invoice
              </a>
            </li>
            <li>
              &bull;{' '}
              <a href="/free-online-receipt-generator" class="text-primary hover:underline">
                Generate a Payment Receipt
              </a>
            </li>
            <li>
              &bull;{' '}
              <a href="/free-rent-receipt-generator" class="text-primary hover:underline">
                Generate an HRA Rent Receipt
              </a>
            </li>
            <li>
              &bull;{' '}
              <a href="/about" class="text-primary hover:underline">
                About Online Invoice Creator
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Frequently Asked Questions (FAQ) Section -->
    <section class="space-y-6 pt-8 border-t border-hairline" aria-labelledby="contact-faq-heading">
      <div class="text-center sm:text-left">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary mb-2">
          Support FAQs
        </span>
        <h2
          id="contact-faq-heading"
          class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
        >
          Frequently Asked Questions About Contact & Support
        </h2>
        <p class="text-sm text-mute mt-1.5">
          Quick answers about bug reports, support response times, and feature suggestions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
        {contactFaqs.map((faq) => (
          <article class="p-5 sm:p-6 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2.5">
            <h3 class="font-bold text-ink text-base sm:text-lg leading-snug">{faq.question}</h3>
            <p class="text-xs sm:text-sm text-mute leading-relaxed">{faq.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<!-- Turnstile Script Loading & Form Handling Script -->
<script>
  // Dynamically load Cloudflare Turnstile script
  (function loadTurnstile() {
    if (!document.querySelector('script[src*="turnstile"]')) {
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?compat=true';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    }
  })();

  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const btnSubmit = document.getElementById('btn-submit-contact') as HTMLButtonElement | null;
  const btnSubmitText = document.getElementById('btn-submit-text');
  const alertSuccess = document.getElementById('contact-alert-success');
  const alertError = document.getElementById('contact-alert-error');
  const errorMsg = document.getElementById('contact-error-message');
  const mailtoFallback = document.getElementById('btn-mailto-fallback') as HTMLAnchorElement | null;
  const btnAlertOpenGmail = document.getElementById('btn-alert-open-gmail') as HTMLAnchorElement | null;
  const btnAlertCopyMessage = document.getElementById('btn-alert-copy-message') as HTMLButtonElement | null;
  const btnAlertCopyText = document.getElementById('btn-alert-copy-text');

  // Copy email button on the right card
  const btnCopySupportEmail = document.getElementById('btn-copy-support-email') as HTMLButtonElement | null;
  const btnCopyEmailText = document.getElementById('btn-copy-email-text');

  if (btnCopySupportEmail) {
    btnCopySupportEmail.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('support@onlineinvoicecreator.com');
        if (btnCopyEmailText) {
          const original = btnCopyEmailText.textContent;
          btnCopyEmailText.textContent = 'Copied!';
          setTimeout(() => {
            if (btnCopyEmailText) btnCopyEmailText.textContent = original;
          }, 2000);
        }
      } catch (e) {
        console.warn('Clipboard write failed:', e);
      }
    });
  }

  let formattedDraftText = '';

  if (btnAlertCopyMessage) {
    btnAlertCopyMessage.addEventListener('click', async () => {
      if (!formattedDraftText) return;
      try {
        await navigator.clipboard.writeText(formattedDraftText);
        if (btnAlertCopyText) {
          const orig = btnAlertCopyText.textContent;
          btnAlertCopyText.textContent = 'Copied!';
          setTimeout(() => {
            if (btnAlertCopyText) btnAlertCopyText.textContent = orig;
          }, 2000);
        }
      } catch (e) {
        console.warn('Clipboard write failed:', e);
      }
    });
  }

  if (contactForm && btnSubmit) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Check honeypot anti-spam
      const hp = (document.getElementById('contact-hp') as HTMLInputElement)?.value;
      if (hp) {
        // Silently reject bots
        if (alertSuccess) alertSuccess.classList.remove('hidden');
        contactForm.reset();
        return;
      }

      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
      const subject = (document.getElementById('contact-subject') as HTMLSelectElement)?.value || 'General Feedback';
      const message = (
        document.getElementById('contact-message') as HTMLTextAreaElement
      )?.value.trim();

      if (!name || !email || !message) {
        if (alertError && errorMsg) {
          alertError.classList.remove('hidden');
          errorMsg.textContent = 'Please fill in all required fields (Name, Email, Message).';
        }
        return;
      }

      // Hide error alert
      if (alertError) alertError.classList.add('hidden');

      // Construct formatted email content
      const emailSubject = `[Online Invoice Creator] ${subject} - ${name}`;
      const emailBody = `Hello Online Invoice Creator Team,\n\n${message}\n\n---\nSender: ${name}\nEmail: ${email}\nTopic: ${subject}\nSource: onlineinvoicecreator.com/contact`;
      
      formattedDraftText = `To: support@onlineinvoicecreator.com\nSubject: ${emailSubject}\n\n${emailBody}`;

      const encodedSubject = encodeURIComponent(emailSubject);
      const encodedBody = encodeURIComponent(emailBody);
      const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=support@onlineinvoicecreator.com&su=${encodedSubject}&body=${encodedBody}`;
      const mailtoUrl = `mailto:support@onlineinvoicecreator.com?subject=${encodedSubject}&body=${encodedBody}`;

      if (btnAlertOpenGmail) {
        btnAlertOpenGmail.href = gmailUrl;
      }
      if (mailtoFallback) {
        mailtoFallback.href = mailtoUrl;
      }

      // Show success alert immediately
      if (alertSuccess) alertSuccess.classList.remove('hidden');

      // Open Gmail compose directly in a new tab
      try {
        window.open(gmailUrl, '_blank', 'noopener,noreferrer');
      } catch (err) {
        console.warn('Could not open Gmail window directly:', err);
      }

      // Background attempt to POST to /api/contact if worker route exists, without blocking or erroring
      try {
        const formData = new FormData(contactForm);
        const payload: Record<string, string> = {};
        formData.forEach((val, key) => {
          if (typeof val === 'string') payload[key] = val;
        });
        fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).catch(() => {});
      } catch (_) {}
    });
  }
</script>
