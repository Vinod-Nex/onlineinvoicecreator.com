---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildPageSchemaGraph } from '../lib/schema';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Terms of Service' }];

const termsFaqs = [
  {
    question: 'Are invoices created on Online Invoice Creator legally valid business documents?',
    answer:
      'Yes, invoices generated through our platform are legally valid business documents when filled with authentic commercial transaction details. They include all essential accounting fields required by commercial law, including invoice dates, unique numbers, seller and buyer details, itemized goods, and taxes. Users are solely responsible for ensuring accuracy under local tax legislation.',
  },
  {
    question: 'What are the acceptable invoicing practices under these terms?',
    answer:
      'Our acceptable invoicing practices require that all generated documents represent genuine, lawful commercial transactions between consenting parties. You agree never to use our service to generate fraudulent invoices, fictitious receipts for tax evasion, misleading billing statements, or unauthorized impersonations. Any abusive or unlawful document generation violates our terms of service.',
  },
  {
    question: 'Is there any warranty or financial liability provided with these free tools?',
    answer:
      'No, our software is provided on an as-is basis without express or implied financial or legal warranties. While our calculation engines are designed for precision, users must verify that figures, currency rates, and tax percentages match their local regulatory requirements. Online Invoice Creator assumes no liability for billing disputes.',
  },
  {
    question: 'Can I use Online Invoice Creator for commercial business billing without an account?',
    answer:
      'Yes, you are fully authorized to use our tools for commercial business billing without creating an account or paying fees. Freelancers, contractors, agencies, and small enterprises may generate unlimited invoices and receipts for daily business operations, client billing, and tax bookkeeping under our permissive terms of service.',
  },
  {
    question: 'Can access to the invoice creator be restricted or terminated?',
    answer:
      'We reserve the right to restrict or terminate access to users who attempt automated scraping, DDoS attacks, or exploit the service for fraud. Lawful users may use the platform freely and indefinitely for genuine business paperwork without fear of sudden account locking or paywall restrictions.',
  },
];

const termsSchema = {
  '@type': 'WebPage',
  name: 'Terms of Service - Online Invoice Creator',
  description:
    'Terms of Service for Online Invoice Creator: Authorized usage for genuine business documents, prohibited activities, and user responsibilities.',
  url: 'https://onlineinvoicecreator.com/terms',
};

const pageSchema = buildPageSchemaGraph({
  canonicalUrl: 'https://onlineinvoicecreator.com/terms',
  title: 'Terms of Service | Online Invoice Creator',
  description:
    'Terms of service and acceptable use policy for Online Invoice Creator. Our free tools are provided strictly for genuine, lawful business documents.',
  breadcrumbs: breadcrumbItems,
  faqItems: termsFaqs,
  customSchemas: [termsSchema],
});
---

<BaseLayout
  title="Terms of Service | Online Invoice Creator"
  description="Terms of service and acceptable use policy for Online Invoice Creator. Our free tools are provided strictly for genuine, lawful business documents."
  canonical="https://onlineinvoicecreator.com/terms"
  schema={pageSchema}
>
  <!-- Breadcrumb Navigation -->
  <div class="border-b border-hairline/60 bg-surface-soft/40 no-print">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12">
    <!-- Header -->
    <header class="space-y-4 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-soft border border-hairline text-xs font-semibold text-charcoal">
        <span class="flex h-2 w-2 rounded-full bg-accent-teal"></span>
        <span>Acceptable Use & Terms</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-display leading-[1.1]">
        Invoice Generator <span class="text-primary">Terms of Service</span>
      </h1>
      <p class="text-sm sm:text-base text-mute">
        Last updated: October 2026 &bull; Effective immediately
      </p>
      <p class="text-base sm:text-lg text-mute max-w-2xl leading-relaxed">
        Please read these terms carefully. By accessing or using Online Invoice Creator, you agree
        to be bound by these terms and conditions.
      </p>
    </header>

    <!-- Core Clause: Genuine Business Documents -->
    <section
      class="p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-card space-y-4"
      aria-labelledby="genuine-documents-heading"
    >
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-bold text-lg">
          §
        </div>
        <div>
          <h2 id="genuine-documents-heading" class="text-lg sm:text-xl font-bold text-ink">
            1. Dedicated Exclusively for Genuine Business Documents
          </h2>
          <span class="text-xs font-semibold text-primary">Strict Acceptable Use Policy</span>
        </div>
      </div>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        All templates, generators, mathematical calculation tools, and PDF export features provided
        on OnlineInvoiceCreator.com are intended{' '}
        <strong class="text-ink">
          strictly and solely for creating genuine, lawful business documents
        </strong>
        . This includes legitimate commercial invoicing, authentic retail sales receipts, verifiable
        trade contractor billing, and bona fide residential or commercial rent payment receipts.
      </p>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        You warrant and agree that any document you create, customize, download, or print using our
        services reflects real, bona fide commercial, professional, or tenancy transactions between
        consenting parties.
      </p>
    </section>

    <!-- Prohibited Uses -->
    <section class="space-y-4" aria-labelledby="prohibited-heading">
      <h2 id="prohibited-heading" class="text-xl sm:text-2xl font-bold text-ink font-display">
        2. Prohibited Uses & Unlawful Activities
      </h2>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        You may not use our website, tools, or templates for any unlawful, deceptive, or fraudulent
        purpose. Prohibited activities include, but are not limited to:
      </p>

      <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-3">
        <ul class="text-xs sm:text-sm text-mute space-y-2.5 list-disc list-inside">
          <li>
            <strong class="text-ink">Fraudulent Billing & False Invoicing:</strong> Generating
            fictitious invoices or receipts for goods or services that were never provided, or
            inflating invoice amounts to mislead buyers, auditors, lenders, or insurance carriers.
          </li>
          <li>
            <strong class="text-ink">Tax Evasion & Fake Tax Numbers:</strong> Fabricating invalid or
            unassigned Tax IDs, Australian Business Numbers (ABN), VAT numbers, or Employer
            Identification Numbers (EIN), or attempting to claim unlawful input tax credits.
          </li>
          <li>
            <strong class="text-ink">Fictitious Rent Receipts:</strong> Fabricating false tenancy
            records, forging landlord signatures, or creating fake rent receipts for fraudulent
            House Rent Allowance (HRA) claims or tax deductions.
          </li>
          <li>
            <strong class="text-ink">Impersonation & Forgery:</strong> Using registered trademarks,
            company names, or logos of third parties without explicit authorization to impersonate
            other entities.
          </li>
          <li>
            <strong class="text-ink">Malicious Automation:</strong> Scraping, spamming,
            denial-of-service attacks, or attempting to compromise the availability or security of
            our infrastructure.
          </li>
        </ul>
      </div>
    </section>

    <!-- User Responsibilities & Tax Compliance -->
    <section class="space-y-4" aria-labelledby="compliance-heading">
      <h2 id="compliance-heading" class="text-xl sm:text-2xl font-bold text-ink font-display">
        3. User Responsibilities & Statutory Tax Compliance
      </h2>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        Users are exclusively responsible for verifying the accuracy, truthfulness, and completeness
        of all data entered into our generators. Specifically:
      </p>
      <ul class="text-xs sm:text-sm text-mute space-y-2 list-disc list-inside pl-1">
        <li>
          You are responsible for ensuring your invoices comply with statutory invoicing rules in
          your jurisdiction (for example, ATO rules in Australia, HMRC in the UK, IRS in the United
          States, or GST regulations in India).
        </li>
        <li>
          You are responsible for verifying mathematical line items, tax percentage calculations,
          currency symbols, and discounts prior to transmitting documents to clients or tax
          authorities.
        </li>
        <li>
          You are responsible for retaining archive copies of your issued documents in accordance
          with local statutory business record retention laws.
        </li>
      </ul>
      <p class="text-xs sm:text-sm text-mute font-medium pt-1">
        General information, not legal or tax advice. Check your local rules.
      </p>
    </section>

    <!-- Disclaimer of Warranties & Limitation of Liability -->
    <section
      class="space-y-4 p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-xs"
      aria-labelledby="disclaimer-heading"
    >
      <h2 id="disclaimer-heading" class="text-xl sm:text-2xl font-bold text-ink font-display">
        4. Disclaimer of Warranties & Limitation of Liability
      </h2>
      <p class="text-xs sm:text-sm text-mute leading-relaxed uppercase tracking-wider font-semibold">
        Provided "As Is" and "As Available"
      </p>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        Online Invoice Creator is provided free of charge on an "as is" and "as available" basis
        without warranties of any kind, whether express, statutory, or implied. We do not warrant
        that the website will be uninterrupted, error-free, secure, or free from omissions.
      </p>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        To the fullest extent permitted by law, Online Invoice Creator, its founders, and
        contributors shall not be liable for any direct, indirect, incidental, special,
        consequential, or punitive damages, including loss of profits, loss of data, client
        disputes, or regulatory fines arising out of your use or inability to use the tools.
      </p>
    </section>

    <!-- Intellectual Property -->
    <section class="space-y-4" aria-labelledby="ip-heading">
      <h2 id="ip-heading" class="text-xl sm:text-2xl font-bold text-ink font-display">
        5. Intellectual Property & Your Content Ownership
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="p-5 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <h3 class="font-bold text-ink text-sm sm:text-base">Our Platform IP</h3>
          <p class="text-xs text-mute leading-relaxed">
            The software, layout code, graphic designs, template styling, and branding of Online
            Invoice Creator are the exclusive property of Online Invoice Creator and protected by
            applicable copyright and intellectual property laws.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <h3 class="font-bold text-ink text-sm sm:text-base">Your Document Ownership</h3>
          <p class="text-xs text-mute leading-relaxed">
            You retain 100% full and unencumbered ownership of all content, company names, logos,
            client records, and line-item details you enter into the tools. We claim zero rights,
            titles, or licenses to your generated invoices or receipts.
          </p>
        </div>
      </div>
    </section>

    <!-- Governing Law & Modifications -->
    <section class="space-y-4" aria-labelledby="modifications-heading">
      <h2 id="modifications-heading" class="text-xl sm:text-2xl font-bold text-ink font-display">
        6. Modifications to Terms
      </h2>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        We reserve the right to modify or replace these Terms of Service at any time. Changes become
        effective immediately upon being posted to this page. Your continued use of the website
        following any changes constitutes acceptance of the revised terms.
      </p>
    </section>

    <!-- Frequently Asked Questions (FAQ) Section -->
    <section class="space-y-6 pt-6 border-t border-hairline" aria-labelledby="terms-faq-heading">
      <div class="text-center sm:text-left">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary mb-2">
          Terms FAQs
        </span>
        <h2
          id="terms-faq-heading"
          class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
        >
          Frequently Asked Questions About Terms & Acceptable Use
        </h2>
        <p class="text-sm text-mute mt-1.5">
          Common legal and operational questions regarding legitimate billing, liability, and ownership.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
        {termsFaqs.map((faq) => (
          <article class="p-5 sm:p-6 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2.5">
            <h3 class="font-bold text-ink text-base sm:text-lg leading-snug">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-mute leading-relaxed">
              {faq.answer}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- Institutional Cross-Links Banner -->
    <footer class="p-6 rounded-3xl bg-surface-soft border border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-accent-teal shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"
          />
        </svg>
        <span>Questions about our terms? We are here to help.</span>
      </div>
      <div class="flex items-center gap-4 font-semibold text-ink">
        <a href="/privacy" class="hover:text-primary transition-colors">
          Privacy Policy
        </a>
        <span>&bull;</span>
        <a href="/about" class="hover:text-primary transition-colors">
          About Us
        </a>
        <span>&bull;</span>
        <a href="/contact" class="hover:text-primary transition-colors">
          Contact Support
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>
