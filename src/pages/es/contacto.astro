---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getRouteUrl } from '../../i18n/routes';
import { buildPageSchemaGraph } from '../../lib/schema';

const title = 'Contacto y Soporte – Online Invoice Creator';
const description = 'Ponte en contacto con nuestro equipo para dudas, sugerencias o asistencia sobre el generador de recibos y facturas en PDF.';
const canonical = 'https://onlineinvoicecreator.com/es/contacto';
const locale = 'es';

const breadcrumbs = [
  { label: 'Inicio', href: getRouteUrl('home', locale) },
  { label: 'Contacto', href: getRouteUrl('contact', locale) },
];

const pageSchema = buildPageSchemaGraph({
  canonicalUrl: canonical,
  title,
  description,
  isHomePage: false,
  isToolPage: false,
  breadcrumbs,
  inLanguage: 'es',
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  schema={pageSchema}
  ogImage="/og/og-es-contacto.png"
  ogImageAlt="Contacto – Online Invoice Creator"
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-3 pb-6 border-b border-hairline">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
        <span>Canal Oficial de Asistencia</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink font-display">
        Contacto y Asistencia
      </h1>

      <p class="text-base text-mute leading-relaxed">
        ¿Tienes alguna duda sobre el uso de la herramienta o deseas proponernos una mejora? Estamos a tu disposición.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
      <div class="p-6 rounded-2xl bg-card border border-hairline space-y-4 shadow-2xs">
        <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>

        <h2 class="text-lg font-bold text-ink font-display">Correo Electrónico Directo</h2>
        <p class="text-xs text-mute leading-relaxed">
          Para consultas generales, sugerencias de nuevas funciones o asistencia con tus comprobantes en PDF:
        </p>

        <a
          href="mailto:support@onlineinvoicecreator.com"
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-hover underline underline-offset-4"
        >
          support@onlineinvoicecreator.com
        </a>
      </div>

      <div class="p-6 rounded-2xl bg-card border border-hairline space-y-4 shadow-2xs">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>

        <h2 class="text-lg font-bold text-ink font-display">Privacidad y Dudas Legales</h2>
        <p class="text-xs text-mute leading-relaxed">
          Recuerda que no almacenamos tus documentos en ningún servidor. Si deseas conocer los detalles sobre el tratamiento de datos técnicos o el uso de almacenamiento local:
        </p>

        <a
          href={getRouteUrl('privacy', locale)}
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-ink hover:text-primary transition-colors"
        >
          Consultar Política de Privacidad &rarr;
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
