---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Picture } from 'astro:assets';
import editorPreview from '../assets/invoice-generator-preview.png';
import { buildPageSchemaGraph, createOrganizationSchema } from '../lib/schema';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'About Us' }];

const aboutSchema = {
  '@type': 'AboutPage',
  name: 'About Online Invoice Creator',
  description:
    'Learn who built Online Invoice Creator and why: 100% private, serverless, watermark-free invoicing for freelancers, contractors, and small businesses.',
  url: 'https://onlineinvoicecreator.com/about',
};

const aboutFaqs = [
  {
    question: 'Who created Online Invoice Creator and why is it free?',
    answer:
      'Online Invoice Creator was built by an independent software engineer and former freelance contractor frustrated with predatory SaaS paywalls, forced watermarks, and cloud data leaks. We keep it free as a permanent public utility powered by efficient static web hosting and non-intrusive reserved-space advertising.',
  },
  {
    question: 'How does client-side processing ensure financial confidentiality?',
    answer:
      'Our architecture executes all invoice calculations, currency conversions, and vector PDF rendering locally in your web browser. Your client identities, hourly billing rates, bank account numbers, and document totals are never transmitted across the network to remote servers or stored in cloud databases.',
  },
  {
    question: 'How do you verify the accuracy of your tax invoice templates?',
    answer:
      'Our editorial and engineering team reviews all document templates and billing guides against official government revenue authorities, including the Australian Taxation Office (ATO), UK HM Revenue & Customs (HMRC), US Internal Revenue Service (IRS), and the Income Tax Department of India.',
  },
  {
    question: 'Are invoices and receipts generated here legally binding?',
    answer:
      'Yes, invoices and receipts generated on Online Invoice Creator satisfy standard commercial and statutory accounting requirements worldwide. They feature unique sequential numbering, explicit buyer and seller identifiers, issue dates, itemized breakdowns, and clear payment terms. As long as entered business details are genuine, the exported vector PDFs serve as authentic accounting records for client billing, remittance, and tax audits.',
  },
  {
    question: 'How can I report a bug, suggest a feature, or contact support?',
    answer:
      'You can contact our support and engineering team directly via email at support@onlineinvoicecreator.com or through our contact page form. We read every inquiry and typically reply within 24 to 48 business hours with technical assistance, bug investigation, or regional tax template updates.',
  },
];

const pageSchema = buildPageSchemaGraph({
  canonicalUrl: 'https://onlineinvoicecreator.com/about',
  title: 'About Us | Online Invoice Creator',
  description:
    'Learn who built Online Invoice Creator and why: 100% private, serverless, watermark-free invoicing for freelancers, contractors, and small businesses.',
  breadcrumbs: breadcrumbItems,
  faqItems: aboutFaqs,
  customSchemas: [aboutSchema, createOrganizationSchema('https://onlineinvoicecreator.com')],
});
---

<BaseLayout
  title="About Us | Online Invoice Creator"
  description="Learn who built Online Invoice Creator and why: 100% private, serverless, watermark-free invoicing for freelancers, contractors, and small businesses."
  canonical="https://onlineinvoicecreator.com/about"
  ogImage="/og/og-about.png"
  ogImageAlt="About Online Invoice Creator - Free & Private Invoicing"
  schema={pageSchema}
>
  <!-- Breadcrumb Navigation -->
  <div class="border-b border-hairline/60 bg-surface-soft/40 no-print">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
    <!-- Hero Header -->
    <header class="space-y-4 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-soft border border-hairline text-xs font-semibold text-charcoal">
        <span class="flex h-2 w-2 rounded-full bg-accent-teal"></span>
        <span>Creator Story & Architecture</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-display leading-[1.1]">
        About Online Invoice Creator: Built for Speed, Privacy, and{' '}
        <span class="text-primary">Zero Gimmicks</span>
      </h1>
      <p class="text-base sm:text-lg text-mute max-w-2xl leading-relaxed">
        Online Invoice Creator was built by an independent software engineer and former freelance
        contractor to eliminate subscription paywalls, forced promotional watermarks, and
        confidential financial data leaks.
      </p>
    </header>

    <!-- Visual Showcase of Client-Side Editor -->
    <div class="relative overflow-hidden rounded-3xl border border-hairline bg-surface-card p-2 sm:p-3 shadow-card">
      <Picture
        src={editorPreview}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(max-width: 800px) 100vw, 896px"
        alt="Online Invoice Creator client-side editor and live preview showcase"
        loading="lazy"
        decoding="async"
        class="w-full h-auto rounded-2xl object-cover"
      />
    </div>

    <!-- Who Built This & Why: The Independent Engineer's Story -->
    <section class="space-y-6" aria-labelledby="who-built-this-heading">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary">
          <span>Our Origin Story</span>
        </div>
        <h2
          id="who-built-this-heading"
          class="text-2xl sm:text-3xl font-bold text-ink font-display"
        >
          Who Built Online Invoice Creator & Why
        </h2>
      </div>

      <div class="p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-4 text-sm sm:text-base text-mute leading-relaxed">
        <p>
          Online Invoice Creator was conceived, designed, and developed by an independent software
          engineer who worked for years as a freelance contractor. Like millions of solo
          professionals, trade contractors, and small business owners, our founder encountered the
          same infuriating cycle every month:
        </p>
        <blockquote class="p-4 rounded-2xl bg-surface-soft border-l-4 border-primary text-ink italic text-sm">
          "You spend fifteen minutes carefully calculating hours, verifying milestone deliverables,
          and entering client remittance information, only to click 'Download PDF' and hit a
          surprise $20/month subscription paywall, a giant promotional watermark stamped across your
          customer bill, or an invasive registration form demanding credit card details."
        </blockquote>
        <p>
          Even more concerning was the <strong class="text-ink">data privacy problem</strong>. Most
          web-based invoice generators quietly transmit your client names, physical addresses,
          hourly rate cards, banking details, and invoice totals across the internet into
          centralized cloud databases and third-party tracking networks.
        </p>
        <p>
          We asked a simple question:{' '}
          <em class="text-ink font-medium">
            Why should generating a standard commercial PDF bill require a remote database, an
            ongoing subscription fee, or surrendering your client's financial confidentiality?
          </em>
        </p>
        <p>
          The answer is that it shouldn't. Online Invoice Creator was built from the ground up as a{' '}
          <strong class="text-ink">local-first, serverless utility</strong>. All calculations,
          currency formatting, and vector PDF rendering take place directly inside your web browser
          using modern JavaScript and WebAssembly. Your business data never touches a remote server.
        </p>
      </div>
    </section>

    <!-- The Problem with Traditional Invoicing Software -->
    <section class="space-y-6" aria-labelledby="why-we-exist-heading">
      <h2 id="why-we-exist-heading" class="text-2xl sm:text-3xl font-bold text-ink font-display">
        The Problem with Most Invoicing Tools
      </h2>
      <p class="text-sm sm:text-base text-mute leading-relaxed">
        Commercial billing software has become increasingly hostile to solo operators and
        micro-businesses:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-3">
          <div class="h-10 w-10 rounded-2xl bg-accent-danger/10 text-accent-danger flex items-center justify-center font-bold text-lg">
            ✕
          </div>
          <h3 class="text-lg font-bold text-ink">The Bait-and-Switch Paywall</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            Many commercial invoice apps let you fill in form items for free, but hold your
            completed document hostage behind a mandatory monthly subscription or stamp an
            unprofessional "Created with App" logo on the bottom of your client-facing invoice.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-3">
          <div class="h-10 w-10 rounded-2xl bg-accent-danger/10 text-accent-danger flex items-center justify-center font-bold text-lg">
            ✕
          </div>
          <h3 class="text-lg font-bold text-ink">The Privacy & Surveillance Problem</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            Older free tools clutter the interface with intrusive popups and transmit sensitive
            client rates, banking details, and proprietary project scopes to remote servers where
            they are stored, analyzed, or exposed in cloud data breaches.
          </p>
        </div>
      </div>
    </section>

    <!-- Our 4 Core Commitments -->
    <section class="space-y-6" aria-labelledby="core-commitments-heading">
      <h2
        id="core-commitments-heading"
        class="text-2xl sm:text-3xl font-bold text-ink font-display"
      >
        Our Four Core Commitments
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-teal/10 text-accent-teal">
            1. Zero Server Uploads
          </div>
          <h3 class="font-bold text-ink text-base">100% Client-Side Processing</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            All document calculations, tax math, logo processing, and vector PDF rendering occur
            locally in your browser. We never store or transmit your invoices, rates, or client
            names.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary">
            2. Never Any Watermarks
          </div>
          <h3 class="font-bold text-ink text-base">100% Watermark-Free</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            Your bills represent your business reputation. Every PDF and PNG export is clean,
            pristine, and ready for official corporate accounting, client remittance, and statutory
            audits.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary">
            3. Instant Utility
          </div>
          <h3 class="font-bold text-ink text-base">No Mandatory Signup</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            Open the website and start creating immediately. Download your completed invoice in
            under thirty seconds. We believe essential everyday business utility should be
            frictionless.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-teal/10 text-accent-teal">
            4. Local-First Draft Memory
          </div>
          <h3 class="font-bold text-ink text-base">Private Local Storage</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            Your browser's local storage automatically saves your business letterhead, currency
            preference, and draft state without contacting external servers. You can clear your data
            anytime with one click.
          </p>
        </div>
      </div>
    </section>

    <!-- Editorial Standards & Regulatory Verification (E-E-A-T) -->
    <section class="space-y-6" aria-labelledby="editorial-standards-heading">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
          <span>Trust & Accuracy</span>
        </div>
        <h2
          id="editorial-standards-heading"
          class="text-2xl sm:text-3xl font-bold text-ink font-display"
        >
          Editorial Standards & Regulatory Verification
        </h2>
      </div>

      <div class="p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-4 text-xs sm:text-sm text-mute leading-relaxed">
        <p>
          Billing documentation carries legal and statutory consequences for businesses of every
          size. To ensure our templates and guides reflect real-world compliance, our editorial and
          engineering contributors verify requirements against official government revenue agencies
          and statutory guidance:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs">
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline/60 space-y-1">
            <strong class="text-ink flex items-center gap-1.5 font-bold">
              <span class="h-2 w-2 rounded-full bg-primary"></span>
              Australian Taxation Office (ATO)
            </strong>
            <p class="text-mute leading-relaxed">
              Verified compliance for Australian tax invoice rules, active ABN validation, and the
              statutory 1/11th GST extraction calculation for supplies exceeding $1,000.
            </p>
            <a
              href="https://www.ato.gov.au/businesses-and-organisations/gst-excise-and-indirect-taxes/gst/tax-invoices"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-primary hover:underline font-medium pt-1"
            >
              <span>ATO Tax Invoices Official Guidance</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline/60 space-y-1">
            <strong class="text-ink flex items-center gap-1.5 font-bold">
              <span class="h-2 w-2 rounded-full bg-accent-teal"></span>
              HM Revenue & Customs (HMRC - UK)
            </strong>
            <p class="text-mute leading-relaxed">
              Standardized formatting for UK sole trader invoices, VAT-registered tax bills,
              sequential numbering rules under VAT Notice 700, and Construction Industry Scheme
              (CIS) details.
            </p>
            <a
              href="https://www.gov.uk/invoicing-and-taking-payment-from-customers/invoices-what-they-must-include"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-primary hover:underline font-medium pt-1"
            >
              <span>HMRC Invoicing Statutory Standards</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline/60 space-y-1">
            <strong class="text-ink flex items-center gap-1.5 font-bold">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              Internal Revenue Service (IRS - US)
            </strong>
            <p class="text-mute leading-relaxed">
              Substantiation guidelines under IRC Section 162, independent contractor documentation
              for Form 1099-NEC, and Schedule C gross receipt recordkeeping standards.
            </p>
            <a
              href="https://www.irs.gov/businesses/small-businesses-self-employed/recordkeeping"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-primary hover:underline font-medium pt-1"
            >
              <span>IRS Small Business Recordkeeping</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline/60 space-y-1">
            <strong class="text-ink flex items-center gap-1.5 font-bold">
              <span class="h-2 w-2 rounded-full bg-indigo-500"></span>
              Income Tax Department of India
            </strong>
            <p class="text-mute leading-relaxed">
              Statutory rent receipt criteria for House Rent Allowance (HRA) tax exemption under
              Section 10(13A), Form 12BB declaration formatting, and landlord PAN threshold mandates
              (&gt;₹1,00,000/yr).
            </p>
            <a
              href="https://incometaxindia.gov.in/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-primary hover:underline font-medium pt-1"
            >
              <span>Income Tax Department of India Portal</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <p class="pt-2 text-[11px] text-mute italic">
          Disclaimer: While our templates and guides are regularly reviewed against official
          statutory publications, tax regulations vary widely by jurisdiction and transaction type.
          This documentation is for educational convenience and does not constitute formal legal,
          accounting, or tax advice.
        </p>
      </div>
    </section>

    <!-- How to Contact Us & Accountability -->
    <section class="space-y-6" aria-labelledby="contact-and-accountability-heading">
      <h2
        id="contact-and-accountability-heading"
        class="text-2xl sm:text-3xl font-bold text-ink font-display"
      >
        Direct Contact, Support & Feedback
      </h2>
      <div class="p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-4 text-xs sm:text-sm text-mute leading-relaxed">
        <p>
          We take direct accountability for the reliability and mathematical correctness of our
          software. If you discover a currency formatting bug, need a specific regional tax template
          added, or want to suggest an improvement to our vector PDF exporter, reach out directly:
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="mailto:support@onlineinvoicecreator.com"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary hover:bg-primary-deep text-white font-semibold text-xs sm:text-sm transition-all shadow-xs"
          >
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
            </svg>
            <span>support@onlineinvoicecreator.com</span>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-surface-soft hover:bg-surface-elevated border border-hairline text-ink font-semibold text-xs sm:text-sm transition-all"
          >
            <span>Online Contact Form</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href="/changelog"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-surface-soft hover:bg-surface-elevated border border-hairline text-ink font-semibold text-xs sm:text-sm transition-all"
          >
            <span>View Product Changelog</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="text-[11px] text-mute pt-1">
          Our support desk reviews messages daily and aims to respond to all technical inquiries and
          feedback within 24 to 48 business hours.
        </p>
      </div>
    </section>

    <!-- Quick Tool Directory & Navigation -->
    <section
      class="space-y-6 pt-4 border-t border-hairline"
      aria-labelledby="tools-directory-heading"
    >
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2
            id="tools-directory-heading"
            class="text-xl sm:text-2xl font-bold text-ink font-display"
          >
            Explore Our Free Tools
          </h2>
          <p class="text-xs sm:text-sm text-mute mt-1">
            Choose the generator built for your exact billing requirement.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a
          href="/"
          class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block group"
        >
          <span class="text-xs font-semibold text-primary">Invoicing &rarr;</span>
          <h3 class="font-bold text-ink text-base mt-1 group-hover:text-primary transition-colors">
            Free Invoice Generator
          </h3>
          <p class="text-xs text-mute mt-1">
            Standard multi-currency invoice creator with 4 clean visual templates.
          </p>
        </a>

        <a
          href="/free-online-receipt-generator"
          class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block group"
        >
          <span class="text-xs font-semibold text-accent-teal">Receipts &rarr;</span>
          <h3 class="font-bold text-ink text-base mt-1 group-hover:text-primary transition-colors">
            Receipt Generator
          </h3>
          <p class="text-xs text-mute mt-1">
            Issue itemized sales receipts, cash payment vouchers, and payment acknowledgments.
          </p>
        </a>

        <a
          href="/free-rent-receipt-generator"
          class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block group"
        >
          <span class="text-xs font-semibold text-charcoal">Real Estate &rarr;</span>
          <h3 class="font-bold text-ink text-base mt-1 group-hover:text-primary transition-colors">
            Rent Receipt Generator
          </h3>
          <p class="text-xs text-mute mt-1">
            Monthly rent receipts for landlords and tenants with optional Landlord PAN.
          </p>
        </a>

        <a
          href="/blog"
          class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block group"
        >
          <span class="text-xs font-semibold text-primary">Knowledge Hub &rarr;</span>
          <h3 class="font-bold text-ink text-base mt-1 group-hover:text-primary transition-colors">
            Invoicing Guides & Tips
          </h3>
          <p class="text-xs text-mute mt-1">
            Read practical guides on payment terms, tax compliance, and freelancing.
          </p>
        </a>
      </div>
    </section>

    <!-- Frequently Asked Questions (FAQ) Section -->
    <section class="space-y-6 pt-6 border-t border-hairline" aria-labelledby="about-faq-heading">
      <div class="text-center sm:text-left">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary mb-2">
          Common Questions
        </span>
        <h2
          id="about-faq-heading"
          class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
        >
          Frequently Asked Questions About Our Mission & Tools
        </h2>
        <p class="text-sm text-mute mt-1.5">
          Answers to common questions about our free, private in-browser invoicing architecture.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
        {aboutFaqs.map((faq) => (
          <article class="p-5 sm:p-6 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2.5">
            <h3 class="font-bold text-ink text-base sm:text-lg leading-snug">{faq.question}</h3>
            <p class="text-xs sm:text-sm text-mute leading-relaxed">{faq.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Institutional Cross-Links Banner -->
    <footer class="p-6 rounded-3xl bg-surface-soft border border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-accent-teal shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"
          />
        </svg>
        <span>Questions or feedback? We read every message.</span>
      </div>
      <div class="flex items-center gap-4 font-semibold text-ink">
        <a href="/privacy" class="hover:text-primary transition-colors">
          Privacy Policy
        </a>
        <span>&bull;</span>
        <a href="/terms" class="hover:text-primary transition-colors">
          Terms of Service
        </a>
        <span>&bull;</span>
        <a href="/contact" class="hover:text-primary transition-colors">
          Contact Support
        </a>
        <span>&bull;</span>
        <a href="/changelog" class="hover:text-primary transition-colors">
          Changelog
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>
