---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Picture } from 'astro:assets';
import editorPreview from '../assets/invoice-generator-preview.png';
import { buildPageSchemaGraph } from '../lib/schema';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'About Us' }];

const aboutSchema = {
  '@type': 'AboutPage',
  name: 'About Online Invoice Creator',
  description:
    'Online Invoice Creator provides free, private, watermark-free invoicing and receipt generation running 100% client-side in the browser.',
  url: 'https://onlineinvoicecreator.com/about',
};

const aboutFaqs = [
  {
    question: 'Is Online Invoice Creator truly free without hidden fees or watermarks?',
    answer:
      'Yes, Online Invoice Creator is completely free with zero hidden subscription costs, download fees, or watermarks. We built this tool to provide accessible, unrestricted billing software for solo freelancers, trade contractors, and small businesses worldwide. Every document you create and export is 100% yours with clean, professional presentation.',
  },
  {
    question: 'How does a no server invoice generator protect my financial confidentiality?',
    answer:
      'Our no server invoice generator architecture processes all calculations, currency conversions, and PDF renderings client-side in your web browser. Your client identities, hourly rates, and invoice totals are never transmitted across the network to remote servers. This ensures full data confidentiality without needing to trust external cloud providers.',
  },
  {
    question: 'Why did you build a watermark free invoice builder instead of a paid app?',
    answer:
      'We created a watermark free invoice builder because essential business paperwork should not be locked behind predatory monthly subscriptions. Traditional accounting platforms charge expensive recurring fees and hold client data hostage. Our tool runs locally with modern browser technology, providing fast, private invoicing with zero barriers to entry.',
  },
  {
    question: 'Are documents created on Online Invoice Creator legally binding?',
    answer:
      'Yes, invoices and receipts generated on our platform are legally binding commercial billing documents. They contain all statutory required fields including unique sequential numbering, party identifiers, issue dates, itemized breakdowns, and clear payment terms. As long as entered business details are genuine, the exported PDFs satisfy standard commercial accounting standards.',
  },
  {
    question: 'Can I use this invoicing tool on mobile phones and tablets?',
    answer:
      'Yes, our platform is fully responsive and optimized for smartphones, tablets, laptops, and desktop workstations. You can draft bills on the go from a construction jobsite, review live preview updates, and export high-resolution PDFs directly from your mobile browser without installing native app store downloads.',
  },
];

const pageSchema = buildPageSchemaGraph({
  canonicalUrl: 'https://onlineinvoicecreator.com/about',
  title: 'About Us | Online Invoice Creator',
  description:
    'Learn why Online Invoice Creator was built: 100% private, serverless, watermark-free invoicing for freelancers, contractors, and small businesses.',
  breadcrumbs: breadcrumbItems,
  faqItems: aboutFaqs,
  customSchemas: [aboutSchema],
});
---

<BaseLayout
  title="About Us | Online Invoice Creator"
  description="Learn why Online Invoice Creator was built: 100% private, serverless, watermark-free invoicing for freelancers, contractors, and small businesses."
  canonical="https://onlineinvoicecreator.com/about"
  ogImage="/og/og-about.png"
  ogImageAlt="About Online Invoice Creator - Free & Private Invoicing"
  schema={pageSchema}
>
  <!-- Breadcrumb Navigation -->
  <div class="border-b border-hairline/60 bg-surface-soft/40 no-print">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
    <!-- Hero Header -->
    <header class="space-y-4 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-soft border border-hairline text-xs font-semibold text-charcoal">
        <span class="flex h-2 w-2 rounded-full bg-accent-teal"></span>
        <span>Our Mission & Architecture</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-display leading-[1.1]">
        About Online Invoice Creator: Built for Speed, Privacy, and{' '}
        <span class="text-primary">Zero Gimmicks</span>
      </h1>
      <p class="text-base sm:text-lg text-mute max-w-2xl leading-relaxed">
        We built Online Invoice Creator because creating a professional bill shouldn't require
        mandatory accounts, expensive subscriptions, intrusive watermarks, or handing over sensitive
        client financial data.
      </p>
    </header>

    <!-- Visual Showcase of Client-Side Editor (Optimized AVIF/WebP with astro:assets) -->
    <div class="relative overflow-hidden rounded-3xl border border-hairline bg-surface-card p-2 sm:p-3 shadow-card">
      <Picture
        src={editorPreview}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(max-width: 800px) 100vw, 896px"
        alt="Online Invoice Creator client-side editor and live preview showcase"
        loading="lazy"
        decoding="async"
        class="w-full h-auto rounded-2xl object-cover"
      />
    </div>

    <!-- The Problem with Traditional Invoicing Software -->
    <section class="space-y-6" aria-labelledby="why-we-exist-heading">
      <h2 id="why-we-exist-heading" class="text-2xl sm:text-3xl font-bold text-ink font-display">
        The Problem with Most Invoicing Tools
      </h2>
      <p class="text-sm sm:text-base text-mute leading-relaxed">
        Most invoicing websites fall into two frustrating extremes:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-3">
          <div class="h-10 w-10 rounded-2xl bg-accent-danger/10 text-accent-danger flex items-center justify-center font-bold text-lg">
            ✕
          </div>
          <h3 class="text-lg font-bold text-ink">The Bait-and-Switch Paywall</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            Many commercial invoice apps let you spend fifteen minutes meticulously filling in
            items, only to block your PDF download behind a mandatory $19/month subscription or
            stamp a giant "Made with InvoiceApp" watermark across the bottom of your bill.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-3">
          <div class="h-10 w-10 rounded-2xl bg-accent-danger/10 text-accent-danger flex items-center justify-center font-bold text-lg">
            ✕
          </div>
          <h3 class="text-lg font-bold text-ink">The Privacy & Ad Clutter Problem</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            Older free tools clutter the screen with heavy skyscraper display ads, slow down your
            device, and send your proprietary billing rates, client addresses, and banking numbers
            to remote cloud databases.
          </p>
        </div>
      </div>
    </section>

    <!-- Our 4 Core Commitments -->
    <section class="space-y-6" aria-labelledby="core-commitments-heading">
      <h2
        id="core-commitments-heading"
        class="text-2xl sm:text-3xl font-bold text-ink font-display"
      >
        Our Four Core Commitments
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-teal/10 text-accent-teal">
            1. Zero Server Uploads
          </div>
          <h3 class="font-bold text-ink text-base">100% Client-Side Processing</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            All document calculations, logo processing, and vector PDF rendering occur directly
            inside your browser. We never transmit or store your invoices, clients, or rates on any
            remote server.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary">
            2. Never Any Watermarks
          </div>
          <h3 class="font-bold text-ink text-base">100% Watermark-Free</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            Your bills are your business. Every PDF and PNG export is clean, pristine, and ready for
            official corporate accounting, client remittance, and tax audits.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary">
            3. Instant Utility
          </div>
          <h3 class="font-bold text-ink text-base">No Mandatory Signup</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            Open the website and start typing immediately. Download your completed invoice in under
            thirty seconds. We believe essential business utility should be frictionless.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-surface-card border border-hairline shadow-xs space-y-2">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-teal/10 text-accent-teal">
            4. Local-First Draft Memory
          </div>
          <h3 class="font-bold text-ink text-base">Private Local Storage</h3>
          <p class="text-xs sm:text-sm text-mute leading-relaxed">
            Your browser's local storage saves your business letterhead, currency, and drafts
            automatically. You can clear your stored data at any time with one click.
          </p>
        </div>
      </div>
    </section>

    <!-- How the Technology Works -->
    <section
      class="space-y-4 p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-xs"
      aria-labelledby="tech-heading"
    >
      <h2 id="tech-heading" class="text-xl sm:text-2xl font-bold text-ink font-display">
        How the Technology Works
      </h2>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        Online Invoice Creator is engineered using modern static web technologies: Astro, vanilla
        TypeScript, and client-side vector document libraries. When you click{' '}
        <strong class="text-ink">Download PDF</strong>, the rendering library loads on demand and
        constructs the vector PDF locally using your browser's JavaScript engine.
      </p>
      <p class="text-xs sm:text-sm text-mute leading-relaxed">
        Because no backend database is involved in document generation, the tool operates with
        near-zero latency, remains accessible even on slow internet connections, and provides
        absolute mathematical privacy.
      </p>
    </section>

    <!-- Quick Tool Directory & Navigation -->
    <section
      class="space-y-6 pt-4 border-t border-hairline"
      aria-labelledby="tools-directory-heading"
    >
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2
            id="tools-directory-heading"
            class="text-xl sm:text-2xl font-bold text-ink font-display"
          >
            Explore Our Free Tools
          </h2>
          <p class="text-xs sm:text-sm text-mute mt-1">
            Choose the generator built for your exact billing requirement.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a
          href="/"
          class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block group"
        >
          <span class="text-xs font-semibold text-primary">Invoicing &rarr;</span>
          <h3 class="font-bold text-ink text-base mt-1 group-hover:text-primary transition-colors">
            Free Invoice Generator
          </h3>
          <p class="text-xs text-mute mt-1">
            Standard multi-currency invoice creator with 4 clean visual templates.
          </p>
        </a>

        <a
          href="/free-online-receipt-generator"
          class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block group"
        >
          <span class="text-xs font-semibold text-accent-teal">Receipts &rarr;</span>
          <h3 class="font-bold text-ink text-base mt-1 group-hover:text-primary transition-colors">
            Receipt Generator
          </h3>
          <p class="text-xs text-mute mt-1">
            Issue itemized sales receipts, cash payment vouchers, and payment acknowledgments.
          </p>
        </a>

        <a
          href="/free-rent-receipt-generator"
          class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block group"
        >
          <span class="text-xs font-semibold text-charcoal">Real Estate &rarr;</span>
          <h3 class="font-bold text-ink text-base mt-1 group-hover:text-primary transition-colors">
            Rent Receipt Generator
          </h3>
          <p class="text-xs text-mute mt-1">
            Monthly rent receipts for landlords and tenants with optional Landlord PAN.
          </p>
        </a>

        <a
          href="/blog"
          class="p-5 rounded-2xl bg-surface-card border border-hairline hover:border-primary/50 transition-all shadow-xs block group"
        >
          <span class="text-xs font-semibold text-primary">Knowledge Hub &rarr;</span>
          <h3 class="font-bold text-ink text-base mt-1 group-hover:text-primary transition-colors">
            Invoicing Guides & Tips
          </h3>
          <p class="text-xs text-mute mt-1">
            Read practical guides on payment terms, tax compliance, and freelancing.
          </p>
        </a>
      </div>
    </section>

    <!-- Frequently Asked Questions (FAQ) Section -->
    <section class="space-y-6 pt-6 border-t border-hairline" aria-labelledby="about-faq-heading">
      <div class="text-center sm:text-left">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary mb-2">
          Common Questions
        </span>
        <h2
          id="about-faq-heading"
          class="text-2xl sm:text-3xl font-bold text-ink font-display tracking-tight"
        >
          Frequently Asked Questions About Our Mission & Tools
        </h2>
        <p class="text-sm text-mute mt-1.5">
          Answers to common questions about our free, private in-browser invoicing architecture.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
        {aboutFaqs.map((faq) => (
          <article class="p-5 sm:p-6 rounded-2xl bg-surface-card border border-hairline shadow-xs space-y-2.5">
            <h3 class="font-bold text-ink text-base sm:text-lg leading-snug">{faq.question}</h3>
            <p class="text-xs sm:text-sm text-mute leading-relaxed">{faq.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Institutional Cross-Links Banner -->
    <footer class="p-6 rounded-3xl bg-surface-soft border border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-accent-teal shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"
          />
        </svg>
        <span>Questions or feedback? We read every message.</span>
      </div>
      <div class="flex items-center gap-4 font-semibold text-ink">
        <a href="/privacy" class="hover:text-primary transition-colors">
          Privacy Policy
        </a>
        <span>&bull;</span>
        <a href="/terms" class="hover:text-primary transition-colors">
          Terms of Service
        </a>
        <span>&bull;</span>
        <a href="/contact" class="hover:text-primary transition-colors">
          Contact Support
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>
